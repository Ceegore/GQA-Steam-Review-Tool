"""
Steam Review Analyzer
=====================
A small Windows tool to fetch and export ALL Steam reviews of a game
in all available languages, with filters and Markdown export.

Tech stack: Python 3.10+ | CustomTkinter | requests

Usage:
    pip install -r requirements.txt
    python steam_review_tool.py
"""

from __future__ import annotations

import json
import os
import re
import sys
import threading
import time
import webbrowser
from dataclasses import dataclass, field
from datetime import datetime, timezone, timedelta
try:
    from zoneinfo import ZoneInfo  # Python 3.9+
    BERLIN = ZoneInfo("Europe/Berlin")
except Exception:  # pragma: no cover
    # Fallback for stripped-down Pythons (e.g. the Windows Store
    # Python that ships without `tzdata`). Concrete timezone objects
    # like datetime.timezone don't need an abstract subclass. The
    # offset is fixed to CEST (UTC+2); for the GUI's display this is
    # close enough — DST is one hour off during winter months.
    BERLIN = timezone(timedelta(hours=2), name="Europe/Berlin")
from pathlib import Path
from typing import Callable, Optional

import customtkinter as ctk
import requests
from tkinter import filedialog, messagebox
import tkinter  # for the Canvas widget in TrendsWindow


# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

STEAM_API_BASE = "https://store.steampowered.com/api"
STEAM_REVIEWS_BASE = "https://store.steampowered.com/appreviews"

# All language codes accepted by Steam's reviews API.
# See: https://partner.steamgames.com/doc/store/localization
STEAM_LANGUAGES = [
    "all",
    "arabic", "bulgarian", "schinese", "tchinese", "czech", "danish", "dutch",
    "english", "finnish", "french", "german", "greek", "hungarian",
    "indonesian", "italian", "japanese", "koreana", "norwegian", "polish",
    "portuguese", "brazilian", "romanian", "russian", "spanish", "latam",
    "swedish", "thai", "turkish", "ukrainian", "vietnamese",
]

REVIEW_FILTERS = ["all", "recent", "updated"]
REVIEW_TYPES = ["all", "positive", "negative"]


# ---------------------------------------------------------------------------
# Steam API wrapper
# ---------------------------------------------------------------------------

# Self-contained helper script that runs INSIDE the external Python
# when the app is started from a frozen .exe. It performs the actual
# Playwright scrape and returns the reviews as a JSON array on stdout.
# Lines starting with "LOG:" on stderr are streamed back to the GUI.
#
# The script is intentionally a single triple-quoted string so that
# `steam_review_tool.py` stays a single-file deliverable. It is only
# written to disk at scrape-time, into a temp file, and deleted when
# the scrape finishes.
PLAYWRIGHT_SCRAPER_SCRIPT = r'''
import sys
import json
import os
import tempfile
import time
import urllib.parse

def log(msg):
    """Write a log line that the parent will surface in the GUI."""
    sys.stderr.write("LOG:" + str(msg) + "\n")
    sys.stderr.flush()

# Anti-detection: remove the traces that browser-automation leaves
# behind. Steam's front-end checks several of these.
ANTI_DETECT = (
    "Object.defineProperty(navigator, 'webdriver', { get: () => undefined });\n"
    "window.chrome = window.chrome || { runtime: {}, loadTimes: function(){}, csi: function(){}, app: { isInstalled: false } };\n"
    "Object.defineProperty(navigator, 'languages', { get: () => ['en-US', 'en'] });\n"
    "Object.defineProperty(navigator, 'platform', { get: () => 'Win32' });\n"
)

# Buttons that may need to be clicked before Steam serves real content.
GATE_BUTTON_TEXTS = [
    "View Page",
    "View Community Hub",
    "I am 18 or older",
    "I am 18 years or older",
    "Yes",
    "Continue",
    "OK",
    "I agree",
    "Accept All Cookies",
    "Accept",
]


def try_dismiss_gates(page):
    """Click through age / content / cookie gates that may block us."""
    for text in GATE_BUTTON_TEXTS:
        try:
            btn = page.get_by_text(text, exact=False).first
            if btn.is_visible(timeout=400):
                btn.click(timeout=2000)
                log("Dismissed gate: " + text)
                page.wait_for_timeout(800)
        except Exception:
            pass


def save_screenshot(page, tag):
    try:
        path = os.path.join(tempfile.gettempdir(),
                            "_srt_pw_" + str(os.getpid()) + "_" + tag + ".png")
        page.screenshot(path=path, full_page=False)
        log("Screenshot saved: " + path)
    except Exception as e:
        log("Screenshot failed: " + repr(e))


def fetch_popularity_metrics(page, app_id):
    """Extract wishlist / follower / review counts from the live
    storefront DOM. The page must already be loaded.

    Returns a dict with keys: wishlist, followers, reviews. Any
    value may be None if it could not be extracted. The Steam DOM
    is re-rendered after every interaction so we try several
    selectors and patterns.
    """
    result = page.evaluate(
        """(appId) => {
            const out = { wishlist: null, followers: null, reviews: null };
            const parseInt0 = (s) => {
                const m = (s || '').replace(/[^0-9]/g, '');
                return m ? parseInt(m, 10) : null;
            };
            // Wishlist: prefer the explicit wishlist count widget.
            const wlSelectors = [
                '#wishlist_count',
                'span.wishlist_count',
                '[data-tooltip-text*="ishlist" i]',
                '.game_area_purchase_game .wishlist_count',
            ];
            for (const sel of wlSelectors) {
                const el = document.querySelector(sel);
                if (el) {
                    const v = parseInt0(el.innerText || el.textContent);
                    if (v != null) { out.wishlist = v; break; }
                }
            }
            // Follower count (only for unreleased / upcoming).
            const flSelectors = [
                '#followed_by_count',
                '[data-tooltip-text*="ollower" i]',
            ];
            for (const sel of flSelectors) {
                const el = document.querySelector(sel);
                if (el) {
                    const v = parseInt0(el.innerText || el.textContent);
                    if (v != null) { out.followers = v; break; }
                }
            }
            // Review count: visible in the right-hand panel.
            const revSelectors = [
                '.user_reviews_summary_row .responsive_reviewnumber',
                '.review_summary .responsive_reviewnumber',
                'label[for="review_summary_num"]',
            ];
            for (const sel of revSelectors) {
                const el = document.querySelector(sel);
                if (el) {
                    const v = parseInt0(el.innerText || el.textContent);
                    if (v != null) { out.reviews = v; break; }
                }
            }
            return out;
        }""",
        app_id,
    )
    if not isinstance(result, dict):
        return {"wishlist": None, "followers": None, "reviews": None}
    return {
        "wishlist": result.get("wishlist"),
        "followers": result.get("followers"),
        "reviews": result.get("reviews"),
    }


def fetch_ajaxappreviews(page, app_id, sort, language, max_items,
                          start_cursor="*", start_fetched=0,
                          purchase_type="all",
                          playtime_filter_min=0,
                          playtime_filter_max=0,
                          filter_offtopic_activity="true",
                          user_review_filter="0",
                          since_timestamp=None,
                          popularity=False):
    """Call the Steam ajaxappreviews endpoint from inside the browser.

    This is the key: the public `/appreviews/<id>?json=1` endpoint
    has a server-side cache that returns 0 reviews for newly-published
    apps (24-72h lag). The store page itself uses a DIFFERENT
    endpoint, `//ajaxappreviews/<id>`, with `&new_steam_api=1`, that
    does NOT have that cache lag. We call that endpoint from inside
    the browser context (so it carries the right cookies / age-check
    state) and paginate via `cursor`.

    `start_cursor` and `start_fetched` enable resume: the GUI passes
    the saved cursor (and how many reviews were already collected) so
    the next page picks up where a previous run left off.
    """
    # Map GUI sort to the store-page parameters. The `review_type`
    # field is "all" / "positive" / "negative". `day_range` caps
    # how far back the page looks; the page always uses 30 for
    # "recent" and a year for "top rated".
    sort_map = {
        "recent":   ("all",    "30"),
        "helpful":  ("all",    "365"),
        "positive": ("positive", "365"),
        "negative": ("negative", "365"),
    }
    review_type, day_range = sort_map.get(sort, ("all", "30"))

    all_reviews = []
    # Honor a resume cursor from the GUI: if the user stopped a
    # previous fetch, the GUI passes the saved cursor here and we
    # pick up exactly where we left off.
    cursor = start_cursor or "*"
    if cursor != "*":
        log("Resuming from saved cursor (fetched so far: "
            + str(start_fetched) + ")")
    pages = 0
    # Hard caps for safety. The real stop conditions are:
    #   1. len(all_reviews) >= max_items  (the user's request)
    #   2. len(all_reviews) >= total_reported  (we have everything available)
    #   3. server returns no reviews / cursor doesn't advance
    max_pages = 5
    total_reported = None
    while pages < max_pages and len(all_reviews) < max_items:
        # If we already know the server's total, stop as soon as we
        # have everything available. This prevents the tool from
        # making extra HTTP calls once it has all the reviews the
        # app actually has.
        if total_reported is not None and len(all_reviews) >= total_reported:
            log("Fetched all " + str(total_reported)
                + " available reviews; stopping pagination.")
            break

        # Only fetch what we still need. Use the smaller of:
        #   - how many reviews the user asked for
        #   - how many reviews the server says exist
        # so we never request 100 if we only need 5, and never request
        # 100 if the app only has 30 reviews total.
        remaining = max_items - len(all_reviews)
        if total_reported is not None:
            remaining = min(remaining, total_reported - len(all_reviews))
        per_page = max(1, min(100, remaining))

        # The query string mirrors what the store page sends. The two
        # most important flags are `new_steam_api=1` (the new backend)
        # and `force_simple=1` (clean JSON without HTML wrapping).
        # The cursor MUST be URL-encoded: Steam returns cursors that
        # contain literal whitespace ("AFP C cIAAA...") which the
        # server rejects with HTTP 400 if not encoded.
        encoded_cursor = urllib.parse.quote(cursor, safe="")
        qs = (
            "date_range_type=all"
            + "&day_range=" + day_range
            + "&start_date=-1&end_date=-1"
            + "&cursor=" + encoded_cursor
            + "&filter_offtopic_activity=" + filter_offtopic_activity
            + "&playtime_filter_max=" + str(int(playtime_filter_max))
            + "&playtime_filter_min=" + str(int(playtime_filter_min))
            + "&playtime_filter_unlocked=0"
            + "&language=" + language
            + "&purchase_type=" + purchase_type
            + "&num_per_page=" + str(per_page)
            + "&summary_selected=0&summary_text_filter="
            + "&user_review_filter=" + user_review_filter
            + "&reviewer_playtime=0&weighted_score=0"
            + "&all_reviews=True"
            + "&cached=false"
            + "&new_steam_api=1"
            + "&use_account_status=0"
            + "&force_simple=1"
        )
        api_url = (
            "https://store.steampowered.com/ajaxappreviews/"
            + str(app_id) + "?" + qs
        )
        # The `&review_type=` parameter selects all/positive/negative.
        # Inject it as a separate param (so it doesn't conflict with the
        # `all_reviews=True` flag above).
        api_url += "&review_type=" + review_type
        result = page.evaluate(
            """async (url) => {
                try {
                    const r = await fetch(url, {
                        credentials: 'include',
                        headers: { 'Accept': 'application/json, text/plain, */*' }
                    });
                    const text = await r.text();
                    return { status: r.status, ok: r.ok, body: text };
                } catch (e) {
                    return { error: String(e) };
                }
            }""",
            api_url,
        )
        if result.get("error"):
            log("API call error: " + result["error"])
            break
        status = result.get("status", 0)
        body = result.get("body", "")
        if status != 200 or not body:
            # Log the body so a 400 (bad cursor / rate limit) is
            # diagnosable instead of just "we got nothing".
            log("API returned status " + str(status)
                + ", body len " + str(len(body))
                + ": " + body[:200])
            break
        try:
            data = json.loads(body)
        except json.JSONDecodeError as e:
            log("JSON parse error: " + repr(e))
            break
        if not data.get("success"):
            log("API returned success=0; aborting.")
            break
        page_reviews = data.get("reviews", []) or []
        # "When to include" — drop any review that is older than the
        # since_timestamp lower bound (client-side, in UTC seconds).
        if since_timestamp is not None and page_reviews:
            before = len(page_reviews)
            page_reviews = [
                rv for rv in page_reviews
                if int(rv.get("timestamp_created", 0)) >= int(since_timestamp)
            ]
            dropped = before - len(page_reviews)
            if dropped:
                log(f"  dropped {dropped} reviews older than since_timestamp")
        all_reviews.extend(page_reviews)
        # The response uses `cAppRecommendationCount` for the total
        # count and `reviews` for the actual list. Capture it the
        # first time we see it so we can stop paginating once we
        # have everything the app has.
        if total_reported is None:
            try:
                total_reported = int(data.get("cAppRecommendationCount", 0) or 0)
            except (TypeError, ValueError):
                total_reported = 0
        log("API page " + str(pages + 1) + ": +" + str(len(page_reviews))
            + " (kept: " + str(len(all_reviews))
            + ", server total: " + str(total_reported) + ")")
        if not page_reviews:
            break
        new_cursor = data.get("cursor", "")
        # Write progress to disk so the GUI can resume if the
        # user stops the fetch. The path is deterministic per
        # app_id so the worker can find it without knowing our
        # PID.
        try:
            progress_path = os.path.join(
                os.path.expanduser("~"),
                ".steam_review_tool",
                "_pw_progress_" + str(app_id) + ".json",
            )
            os.makedirs(os.path.dirname(progress_path), exist_ok=True)
            with open(progress_path, "w", encoding="utf-8") as f:
                json.dump({
                    "cursor": new_cursor,
                    "fetched": len(all_reviews),
                    "total_reported": total_reported,
                }, f)
        except Exception:
            pass
        if not new_cursor or new_cursor == cursor:
            break
        cursor = new_cursor
        pages += 1
        time.sleep(0.4)
    # On natural completion, leave the progress file in place but
    # mark it as "done" with an empty cursor. The worker reads
    # this to distinguish "interrupted by user" (cursor present)
    # from "completed normally" (cursor empty). Leaving the file
    # avoids a race where the worker would otherwise always see
    # a missing file (because the helper would have deleted it).
    try:
        progress_path = os.path.join(
            os.path.expanduser("~"),
            ".steam_review_tool",
            "_pw_progress_" + str(app_id) + ".json",
        )
        with open(progress_path, "w", encoding="utf-8") as f:
            json.dump({
                "cursor": "",
                "fetched": len(all_reviews),
                "total_reported": total_reported,
                "done": True,
            }, f)
    except Exception:
        pass
    return all_reviews


def main():
    try:
        raw = sys.stdin.read()
        params = json.loads(raw) if raw else {}
    except Exception as e:
        log("Failed to parse params from stdin: " + repr(e))
        sys.exit(11)

    app_id = int(params.get("app_id", 0))
    max_items = int(params.get("max_items", 100))
    sort = str(params.get("sort", "recent"))
    language = str(params.get("language", "all"))
    user_agent = str(params.get(
        "user_agent",
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
        "(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    ))
    # Additional filters (all optional; "all" / unset disables them).
    purchase_type = str(params.get("purchase_type", "all"))
    playtime_filter_min = int(params.get("playtime_filter_min", 0) or 0)
    playtime_filter_max = int(params.get("playtime_filter_max", 0) or 0)
    filter_offtopic = str(params.get("filter_offtopic_activity", "true"))
    user_review_filter = str(params.get("user_review_filter", "0"))
    # "When to include" — a UTC unix-seconds lower bound. None = no filter.
    since_timestamp = params.get("since_timestamp", None)
    try:
        since_timestamp = int(since_timestamp) if since_timestamp is not None else None
    except (TypeError, ValueError):
        since_timestamp = None
    # "popularity_mode" — when set, after the reviews fetch the
    # helper also scrapes wishlist/follower/review counts from the
    # storefront and prints a POPULARITY_JSON=... line on stdout.
    # (Not used by the per-review export, only by the trends tab.)

    if not app_id:
        log("Missing app_id in params.")
        sys.exit(12)

    try:
        from playwright.sync_api import sync_playwright
    except Exception as e:
        log("Playwright is not importable in this Python: " + repr(e))
        log("Click 'Install Playwright' in the GUI and try again.")
        sys.exit(13)

    log("Launching headless Chromium in external Python...")
    page = None
    try:
        with sync_playwright() as p:
            browser = p.chromium.launch(
                headless=True,
                args=[
                    "--no-sandbox",
                    "--disable-blink-features=AutomationControlled",
                ],
            )
            context = browser.new_context(
                user_agent=user_agent,
                locale="en-US",
                viewport={"width": 1366, "height": 768},
                extra_http_headers={
                    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8",
                    "Accept-Language": "en-US,en;q=0.9",
                    "sec-ch-ua": '"Not_A Brand";v="8", "Chromium";v="120", "Google Chrome";v="120"',
                    "sec-ch-ua-mobile": "?0",
                    "sec-ch-ua-platform": '"Windows"',
                    "sec-fetch-dest": "document",
                    "sec-fetch-mode": "navigate",
                    "sec-fetch-site": "none",
                    "upgrade-insecure-requests": "1",
                },
            )
            context.add_init_script(ANTI_DETECT)
            page = context.new_page()

            # Step 1: load the store page so we pick up cookies and
            # pass any age / content gate.
            store_url = (
                "https://store.steampowered.com/app/" + str(app_id)
                + "/?l=" + language
            )
            log("Visiting store page to set up session: " + store_url)
            try:
                page.goto(store_url, wait_until="domcontentloaded", timeout=60000)
            except Exception as e:
                log("Store page navigation failed: " + repr(e))
            try_dismiss_gates(page)
            try:
                page.wait_for_load_state("networkidle", timeout=8000)
            except Exception:
                pass
            log("Session ready (title=" + page.title() + ")")

            # Step 2: call the un-cached ajaxappreviews endpoint from
            # the browser context.
            reviews = fetch_ajaxappreviews(
                page, app_id, sort, language, max_items,
                start_cursor=str(params.get("start_cursor", "") or "*"),
                start_fetched=int(params.get("start_fetched", 0) or 0),
                purchase_type=purchase_type,
                playtime_filter_min=playtime_filter_min,
                playtime_filter_max=playtime_filter_max,
                filter_offtopic_activity=filter_offtopic,
                user_review_filter=user_review_filter,
                since_timestamp=since_timestamp,
            )

            save_screenshot(page, "final")
            # Optional: also scrape wishlist / follower counts.
            pop_mode = str(params.get("popularity_mode", "0"))
            if pop_mode in ("1", "true", "True"):
                log("Scraping popularity metrics from storefront…")
                try:
                    pop_url = (
                        "https://store.steampowered.com/app/"
                        + str(app_id) + "/?l=" + language
                    )
                    page.goto(pop_url, wait_until="domcontentloaded", timeout=60000)
                    try:
                        page.wait_for_load_state("networkidle", timeout=8000)
                    except Exception:
                        pass
                    metrics = fetch_popularity_metrics(page, app_id)
                    # Print as a special line so the GUI can extract it.
                    print("POPULARITY_JSON=" + json.dumps(metrics))
                    sys.stdout.flush()
                except Exception as exc:
                    log("Popularity scrape failed: " + repr(exc))
            browser.close()
    except Exception as exc:
        log("Playwright error: " + repr(exc))
        if page is not None:
            try:
                save_screenshot(page, "error")
            except Exception:
                pass
        sys.exit(14)

    # Dedup + cap.
    seen = set()
    unique = []
    for rv in reviews:
        rid = rv.get("recommendationid")
        if rid and rid not in seen:
            seen.add(rid)
            unique.append(rv)
    unique = unique[:max_items]

    log("Returning " + str(len(unique)) + " unique reviews.")
    sys.stdout.write(json.dumps(unique))
    sys.stdout.flush()

if __name__ == "__main__":
    main()
'''


# ---------------------------------------------------------------------------
# Time-based filter helpers (shared by both tabs)
# ---------------------------------------------------------------------------

# Presets for the "When to include" filter. Each preset is (label, hours).
# "all" means no time filter. "custom" reveals the date+time inputs.
SINCE_PRESETS: list[tuple[str, int]] = [
    ("all time",        0),
    ("last 1 hour",     1),
    ("last 2 hours",    2),
    ("last 3 hours",    3),
    ("last 4 hours",    4),
    ("last 5 hours",    5),
    ("last 6 hours",    6),
    ("last 12 hours",  12),
    ("last 24 hours",  24),
    ("last 3 days",    72),
    ("last 7 days",   168),
    ("custom (date + time)", -1),
]
SINCE_PRESET_LABELS: list[str] = [p[0] for p in SINCE_PRESETS]


def parse_since_preset(label: str) -> int:
    """Return the hours value for a preset label, or -1 for 'custom'.

    Returns 0 for 'all time' (no filter) or -1 for the 'custom' option
    (caller must look at the date+time entries).
    """
    for lbl, hrs in SINCE_PRESETS:
        if lbl == label:
            return hrs
    return 0  # unknown label → no filter


def compute_since_timestamp(
    preset_label: str,
    custom_date_str: str = "",
    custom_time_str: str = "",
    now: Optional[datetime] = None,
) -> Optional[int]:
    """Translate the (preset, custom date, custom time) into a UTC unix
    timestamp for the API to use as a `min_date_ts` lower bound.

    Returns:
      - None  if no filter is active (preset == "all time" or unknown)
      - int   the UTC unix timestamp that reviews must be newer than
    """
    if now is None:
        now = datetime.now(BERLIN)

    hours = parse_since_preset(preset_label)
    if hours == 0:
        return None
    if hours > 0:
        # "Last N hours" preset — relative to now
        from datetime import timedelta
        since = now - timedelta(hours=hours)
        return int(since.timestamp())
    # hours == -1 → custom mode
    date_s = (custom_date_str or "").strip()
    time_s = (custom_time_str or "").strip()
    if not date_s and not time_s:
        return None
    # Default: today in Berlin time
    if not date_s:
        date_s = now.strftime("%Y-%m-%d")
    # Default: 00:00 if no time given
    if not time_s:
        time_s = "00:00"
    try:
        naive = datetime.strptime(f"{date_s} {time_s}", "%Y-%m-%d %H:%M")
    except ValueError:
        return None
    # Attach Berlin timezone, convert to UTC, return unix seconds
    berlin_dt = naive.replace(tzinfo=BERLIN)
    return int(berlin_dt.timestamp())


def format_berlin(ts: Optional[int]) -> str:
    """Format a unix timestamp as 'YYYY-MM-DD HH:MM:SS (Europe/Berlin)'."""
    if ts is None:
        return "—"
    dt = datetime.fromtimestamp(ts, tz=BERLIN)
    return dt.strftime("%Y-%m-%d %H:%M:%S %Z")


def current_berlin_str() -> str:
    """Return current time in Berlin as 'YYYY-MM-DD HH:MM:SS'."""
    return datetime.now(BERLIN).strftime("%Y-%m-%d %H:%M:%S")


# ---------------------------------------------------------------------------
# Dump-folder + seen-IDs storage (lightweight dedup)
# ---------------------------------------------------------------------------
# We do NOT want a full database of every review Steam has ever shown
# us. We only need to know "have I dumped this review_id before?" for
# each game, so the "Fetch new" button can skip already-exported ones.
# The storage is therefore a tiny per-app JSON file containing a list
# of review ids. Format on disk:
#
#   <dump_root>/<app_id>_<safe_name>/seen_ids.json
#     {
#       "app_id": 4311090,
#       "name": "Bus Simulator 27 Demo",
#       "seen_ids": ["abc123", "def456", ...],
#       "last_export_at": "2026-06-17T14:30:00",
#       "total_exported": 42
#     }

# Default location for the per-game dump tree. The user can change this
# from the GUI ("Set dump folder..."). ~/Documents is the most
# discoverable place on Windows; users can find their dumps without
# hunting through %APPDATA%.
DEFAULT_DUMP_ROOT = Path.home() / "Documents" / "SteamReviewDumps"


def _file_content_hash(path: "Path") -> str:
    """Return a hex SHA-1 of a file's bytes, or "" on any I/O error.

    Used by the Obsidian-vault sync to compare two files of the same
    name without copying them again. We use SHA-1 (not MD5) because
    Python's hashlib always ships it; collision risk for .md files
    is irrelevant.
    """
    import hashlib
    try:
        with open(path, "rb") as f:
            return hashlib.sha1(f.read()).hexdigest()
    except OSError:
        return ""


def sanitize_for_filename(s: str, max_len: int = 30) -> str:
    """Make a string safe to embed in a filename.

    Strips path separators, Windows-reserved characters, and collapses
    whitespace. Truncates to `max_len`. Returns 'app' if the input is
    empty or only contains forbidden characters.
    """
    if not s:
        return "app"
    # Replace any character that Windows / *nix disallow in filenames.
    bad = '<>:"/\\|?*'
    out = "".join("_" if c in bad else c for c in s)
    # Collapse runs of whitespace and trim.
    out = "_".join(out.split())
    out = out.strip(" ._") or "app"
    if len(out) > max_len:
        out = out[:max_len].rstrip("._")
    return out


def make_export_basename(
    game_name: str,
    filter_label: str,
    now: Optional[datetime] = None,
) -> str:
    """Build the short export filename.

    Format: ``GQA Reviewdump_<game_short>_<filter>_<YYYYMMDD-HHMM>.md``

    Example: ``GQA Reviewdump_BusSim27_last3h_20260617-1430.md``
    """
    if now is None:
        now = datetime.now()
    game_short = sanitize_for_filename(game_name, max_len=25)
    filt = sanitize_for_filename(filter_label or "all", max_len=20)
    ts = now.strftime("%Y%m%d-%H%M")
    return f"GQA Reviewdump_{game_short}_{filt}_{ts}.md"


def short_filter_label(tab: str, app) -> str:
    """Human-readable filter mode label for the export filename.

    Reads the appropriate GUI widgets via `app` and returns something
    like "last3h", "last24h", "all", or "custom2026-06-10T14h".
    """
    prefix = "pw_" if tab == "pw" else ""
    try:
        preset = getattr(app, f"{prefix}since_preset_var").get()
    except AttributeError:
        return "all"
    if not preset.startswith("custom"):
        # "last 3 hours" -> "last3h"
        parts = preset.split()
        if len(parts) >= 2 and parts[0] == "last":
            unit = parts[2].rstrip("s")  # hour/hours -> hour, day/days -> day
            return f"last{parts[1]}{unit[0]}"
        return "all"
    # Custom: include date+time in the label so the user can tell
    # different custom dumps apart at a glance.
    try:
        d = getattr(app, f"{prefix}since_date_entry").get()
        t = getattr(app, f"{prefix}since_time_entry").get()
    except AttributeError:
        return "custom"
    if d and t:
        return f"custom{d.replace('-', '')}T{t.replace(':', '')}"
    if d:
        return f"custom{d.replace('-', '')}"
    return "custom"


# ---------------------------------------------------------------------------
# Date / time picker popups
# ---------------------------------------------------------------------------
# CustomTkinter doesn't ship with native date/time pickers. These two
# small Toplevel-based helpers give the "When to include" section a
# real picker without bringing in a third-party dependency like
# tkcalendar. They always show the current German time prominently at
# the top so the user always knows what "now" means in the relevant
# timezone.

import calendar as _calendar  # local alias to avoid name clash


class DatePickerPopup:
    """A small modal calendar popup.

    Usage:
        DatePickerPopup(parent_entry, parent_window).open()
    On `Apply`, writes the selected date (YYYY-MM-DD) into
    `parent_entry` and runs an optional on_change callback.
    """

    def __init__(self, target_entry, master, on_change=None):
        self.target = target_entry
        self.master = master
        self.on_change = on_change
        self._year = None
        self._month = None
        self._top = None
        # Pre-select the date currently in the entry, or "today in Berlin".
        self._init_from_entry()

    def _init_from_entry(self) -> None:
        text = (self.target.get() or "").strip()
        try:
            d = datetime.strptime(text, "%Y-%m-%d")
        except ValueError:
            d = datetime.now(BERLIN)
        self._year = d.year
        self._month = d.month

    def open(self) -> None:
        if self._top is not None and self._top.winfo_exists():
            self._top.focus()
            return
        self._top = ctk.CTkToplevel(self.master)
        self._top.title("Pick a date (German time)")
        self._top.geometry("320x320")
        self._top.transient(self.master)
        self._top.grab_set()
        self._build()

    def _build(self) -> None:
        # Header: current German time
        now = datetime.now(BERLIN)
        ctk.CTkLabel(
            self._top,
            text=(
                f"🕐 Now in Berlin: {now.strftime('%Y-%m-%d %H:%M:%S')}\n"
                f"All dates below are interpreted in German time."
            ),
            anchor="w", justify="left",
            text_color=("#1f6aa5", "#5da9d6"),
        ).pack(fill="x", padx=10, pady=(10, 4))

        # Month / year nav
        nav = ctk.CTkFrame(self._top, fg_color="transparent")
        nav.pack(fill="x", padx=10, pady=(4, 4))
        ctk.CTkButton(nav, text="◀", width=36,
                      command=self._prev_month).pack(side="left", padx=2)
        self._title_lbl = ctk.CTkLabel(
            nav, text="", font=("", 13, "bold"), width=180, anchor="center",
        )
        self._title_lbl.pack(side="left", padx=4, expand=True, fill="x")
        ctk.CTkButton(nav, text="▶", width=36,
                      command=self._next_month).pack(side="right", padx=2)

        # Weekday header
        wk = ctk.CTkFrame(self._top, fg_color="transparent")
        wk.pack(fill="x", padx=10)
        for d in ("Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"):
            ctk.CTkLabel(wk, text=d, width=36, anchor="center",
                         text_color="gray").pack(side="left", padx=1)

        # Day grid
        self._grid = ctk.CTkFrame(self._top, fg_color="transparent")
        self._grid.pack(fill="both", expand=True, padx=10, pady=4)
        self._render_grid()

        # Buttons
        btns = ctk.CTkFrame(self._top, fg_color="transparent")
        btns.pack(fill="x", padx=10, pady=8)
        ctk.CTkButton(btns, text="Today", width=80,
                      command=self._pick_today).pack(side="left", padx=2)
        ctk.CTkButton(btns, text="Clear", width=80,
                      command=self._pick_clear).pack(side="left", padx=2)
        ctk.CTkButton(btns, text="Cancel", width=80,
                      command=self._top.destroy).pack(side="right", padx=2)
        ctk.CTkButton(btns, text="Apply", width=80,
                      fg_color="#1f6aa5",
                      command=self._apply).pack(side="right", padx=2)

    def _render_grid(self) -> None:
        # Clear existing buttons
        for w in self._grid.winfo_children():
            w.destroy()
        cal = _calendar.Calendar(firstweekday=0)  # Monday
        weeks = cal.monthdayscalendar(self._year, self._month)
        self._title_lbl.configure(text=f"{_calendar.month_name[self._month]} {self._year}")
        today = datetime.now(BERLIN)
        for wi, week in enumerate(weeks):
            for di, day in enumerate(week):
                if day == 0:
                    ctk.CTkLabel(self._grid, text="", width=36, height=30).grid(
                        row=wi, column=di, padx=1, pady=1
                    )
                else:
                    is_today = (
                        day == today.day
                        and self._month == today.month
                        and self._year == today.year
                    )
                    fg = "#1f6aa5" if is_today else None
                    btn = ctk.CTkButton(
                        self._grid, text=str(day), width=36, height=30,
                        fg_color=fg,
                        command=lambda d=day: self._pick_day(d),
                    )
                    btn.grid(row=wi, column=di, padx=1, pady=1)

    def _prev_month(self) -> None:
        self._month -= 1
        if self._month == 0:
            self._month = 12
            self._year -= 1
        self._render_grid()

    def _next_month(self) -> None:
        self._month += 1
        if self._month == 13:
            self._month = 1
            self._year += 1
        self._render_grid()

    def _pick_day(self, day: int) -> None:
        # Click a day = auto-apply
        self._picked = f"{self._year:04d}-{self._month:02d}-{day:02d}"
        self._apply()

    def _pick_today(self) -> None:
        now = datetime.now(BERLIN)
        self._picked = now.strftime("%Y-%m-%d")
        self._apply()

    def _pick_clear(self) -> None:
        self.target.delete(0, "end")
        if self._top is not None:
            self._top.destroy()
        if self.on_change:
            self.on_change()

    def _apply(self) -> None:
        if hasattr(self, "_picked"):
            self.target.delete(0, "end")
            self.target.insert(0, self._picked)
        if self._top is not None:
            self._top.destroy()
        if self.on_change:
            self.on_change()


class TimePickerPopup:
    """A small modal time-of-day popup.

    Lets the user pick HH:MM. Shows the current German time
    prominently. Has a "Now" button for one-click selection.
    """

    def __init__(self, target_entry, master, on_change=None):
        self.target = target_entry
        self.master = master
        self.on_change = on_change
        self._top = None
        self._init_from_entry()

    def _init_from_entry(self) -> None:
        text = (self.target.get() or "").strip()
        try:
            t = datetime.strptime(text, "%H:%M")
            self._hour = t.hour
            self._minute = t.minute
        except ValueError:
            now = datetime.now(BERLIN)
            self._hour = now.hour
            self._minute = now.minute

    def open(self) -> None:
        if self._top is not None and self._top.winfo_exists():
            self._top.focus()
            return
        self._top = ctk.CTkToplevel(self.master)
        self._top.title("Pick a time (German time)")
        self._top.geometry("300x240")
        self._top.transient(self.master)
        self._top.grab_set()
        self._build()

    def _build(self) -> None:
        now = datetime.now(BERLIN)
        ctk.CTkLabel(
            self._top,
            text=(
                f"🕐 Now in Berlin: {now.strftime('%Y-%m-%d %H:%M:%S')}\n"
                f"The time below is interpreted in German time."
            ),
            anchor="w", justify="left",
            text_color=("#1f6aa5", "#5da9d6"),
        ).pack(fill="x", padx=10, pady=(10, 8))

        # Hour / minute selectors
        row = ctk.CTkFrame(self._top, fg_color="transparent")
        row.pack(fill="x", padx=10, pady=4)
        ctk.CTkLabel(row, text="Hour:").pack(side="left", padx=(0, 4))
        self._hour_var = ctk.StringVar(value=f"{self._hour:02d}")
        ctk.CTkOptionMenu(
            row, values=[f"{h:02d}" for h in range(24)],
            variable=self._hour_var, width=80,
        ).pack(side="left", padx=4)
        ctk.CTkLabel(row, text="Minute:").pack(side="left", padx=(20, 4))
        self._minute_var = ctk.StringVar(value=f"{self._minute:02d}")
        ctk.CTkOptionMenu(
            row, values=[f"{m:02d}" for m in range(60)],
            variable=self._minute_var, width=80,
        ).pack(side="left", padx=4)

        # Quick-pick buttons
        qp = ctk.CTkFrame(self._top, fg_color="transparent")
        qp.pack(fill="x", padx=10, pady=8)
        ctk.CTkLabel(qp, text="Quick:", anchor="w",
                     text_color="gray").pack(side="left", padx=(0, 6))
        for h in (9, 12, 14, 18, 0):
            label = f"{h:02d}:00" if h else "00:00"
            ctk.CTkButton(
                qp, text=label, width=60,
                command=lambda hh=h, mm=0: self._set(hh, mm),
            ).pack(side="left", padx=2)

        # Buttons
        btns = ctk.CTkFrame(self._top, fg_color="transparent")
        btns.pack(fill="x", padx=10, pady=8)
        ctk.CTkButton(btns, text="Now", width=80,
                      command=self._pick_now).pack(side="left", padx=2)
        ctk.CTkButton(btns, text="Clear", width=80,
                      command=self._pick_clear).pack(side="left", padx=2)
        ctk.CTkButton(btns, text="Cancel", width=80,
                      command=self._top.destroy).pack(side="right", padx=2)
        ctk.CTkButton(btns, text="Apply", width=80,
                      fg_color="#1f6aa5",
                      command=self._apply).pack(side="right", padx=2)

    def _set(self, h: int, m: int) -> None:
        self._hour_var.set(f"{h:02d}")
        self._minute_var.set(f"{m:02d}")
        self._apply()

    def _pick_now(self) -> None:
        now = datetime.now(BERLIN)
        self._set(now.hour, now.minute)

    def _pick_clear(self) -> None:
        self.target.delete(0, "end")
        if self._top is not None:
            self._top.destroy()
        if self.on_change:
            self.on_change()

    def _apply(self) -> None:
        try:
            h = int(self._hour_var.get())
            m = int(self._minute_var.get())
        except (ValueError, AttributeError):
            return
        self.target.delete(0, "end")
        self.target.insert(0, f"{h:02d}:{m:02d}")
        if self._top is not None:
            self._top.destroy()
        if self.on_change:
            self.on_change()


# ---------------------------------------------------------------------------
# Review analytics: tagger, classifier, aggregators
# ---------------------------------------------------------------------------
# Heuristic-based analytics for the PM/QA workflow. Everything here is
# deterministic and explainable so the user (and an AI) can verify
# which reviews drove which aggregations.

# Default keyword tags for issue detection. The user can override
# these in settings. Lower-case, comma-separated.
DEFAULT_KEYWORD_TAGS: list[str] = [
    "crash", "freeze", "lag", "stutter", "stuck", "broken", "bug",
    "error", "glitch", "fps", "save", "lost", "missing", "refund",
    "performance", "uninstall", "not working", "doesn't work",
    "doesn't load", "won't launch", "wont launch", "black screen",
    "server", "online", "multiplayer", "controller", "sound", "audio",
    "music", "voice", "graphics", "ui", "menu", "tutorial", "laggy",
    "rubberbanding", "desync", "anticheat", "anti-cheat", "cheater",
    "hacker", "exploit", "pay to win", "p2w", "microtransaction",
]

# Heuristic phrases that strongly suggest a "bug report" type.
_BUG_PHRASES = [
    "crash", "crashed", "freezes", "frozen", "stuck", "stuttering",
    "fps drop", "low fps", "black screen", "won't launch", "wont launch",
    "doesn't launch", "broken", "bug", "glitch", "error code", "ctd",
    "crash to desktop", "memory leak", "save file", "lost my save",
    "lost progress", "corrupt save", "not working", "doesn't work",
    "doesn't load", "stuck on", "softlock", "hard lock", "desync",
    "rubberbanding", "teleporting", "invisible enemy", "can't move",
    "no sound", "no audio", "sound cutting out", "controller not",
    "game-breaking", "game breaking", "unplayable", "uninstalling",
    "uninstalled", "wasted money", "garbage game", "refund request",
    "performance issue", "frame drops", "frozen screen",
]

# Heuristic phrases that strongly suggest a "feature request".
_FEATURE_PHRASES = [
    "would be nice", "would be great", "would love to see", "please add",
    "needs an option", "needs option", "should have", "should add",
    "missing feature", "needs a feature", "lacks", "needs better",
    "needs a way to", "wish there was", "wish there were", "i wish",
    "could use", "would be cool if", "suggestion", "feature request",
    "add a", "add an", "bring back", "should be", "needs the ability",
    "give us", "give players", "would prefer", "no way to",
    "needs to be", "needs more", "wants to",
]

# Heuristic phrases that strongly suggest a "praise".
_PRAISE_PHRASES = [
    "love this game", "love it", "amazing game", "best game",
    "10/10", "masterpiece", "incredible", "fantastic", "excellent game",
    "perfect game", "great game", "awesome game", "fun game",
    "addictive", "highly recommend", "worth every penny", "worth it",
    "stunning", "beautiful game", "great soundtrack", "great music",
    "great story", "great graphics", "great gameplay", "brilliant",
    "wonderful", "gem", "phenomenal", "best in class",
]

# Heuristic phrases for "complaint" (not necessarily a bug, more a
# general negative sentiment or design complaint).
_COMPLAINT_PHRASES = [
    "not worth", "not worth it", "waste of money", "waste of time",
    "disappointing", "disappointed", "boring", "repetitive",
    "too short", "too long", "overpriced", "too expensive", "rip off",
    "money grab", "cash grab", "lazy", "uninspired", "repetitive",
    "lack of content", "no content", "no endgame", "no replay value",
    "unbalanced", "poor design", "bad design", "terrible design",
    "unfair", "predatory", "anti-consumer", "scam", "greedy",
    "shouldn't have", "should not have", "forced", "unfun",
]


def classify_review_type(review: dict) -> str:
    """Return one of 'bug', 'feature', 'praise', 'complaint', 'other'.

    Uses simple keyword matching against the review's `review` text.
    Priority order: bug > feature > complaint > praise > other.
    Returns 'other' if no pattern matches.
    """
    text = (review.get("review") or "").lower()
    if not text:
        return "other"
    # Bugs and feature requests are more specific so we check them first
    if any(p in text for p in _BUG_PHRASES):
        return "bug"
    if any(p in text for p in _FEATURE_PHRASES):
        return "feature"
    # Praise and complaint use the voted_up field as the primary signal
    if review.get("voted_up"):
        if any(p in text for p in _PRAISE_PHRASES):
            return "praise"
    else:
        if any(p in text for p in _COMPLAINT_PHRASES):
            return "complaint"
    # Fallback: voted_up is a strong signal even if no phrase matched
    if review.get("voted_up"):
        return "praise"
    return "complaint"


def extract_tags(review: dict, keyword_list: Optional[list[str]] = None) -> list[str]:
    """Return a list of keyword tags that appear in the review text.

    The user-configurable `keyword_list` defaults to
    `DEFAULT_KEYWORD_TAGS`. Tags are case-insensitive and are returned
    in lower-case.

    Matching rules:
      - Multi-word phrases use plain substring match
        ("black screen" matches anywhere).
      - Single-word tokens use word-boundary matching, and we also
        match the common English stem forms (crash → crashes, crashed,
        crashing) so the user doesn't have to add every variant.
    """
    if keyword_list is None:
        keyword_list = DEFAULT_KEYWORD_TAGS
    text = (review.get("review") or "").lower()
    if not text:
        return []
    import re as _re
    hits: list[str] = []
    for kw in keyword_list:
        kw_l = kw.lower().strip()
        if not kw_l:
            continue
        if " " in kw_l:
            # Multi-word: substring
            if kw_l in text:
                hits.append(kw_l)
        else:
            # Single-word: word-boundary + stem forms (s/es/ed/ing)
            # We do a single combined regex alternation.
            base = _re.escape(kw_l)
            # Allow common English inflection suffixes for short words
            pat = rf"\b({base}(?:e?s|e?d|ing)?)\b"
            if _re.search(pat, text):
                hits.append(kw_l)
    # de-duplicate, preserve order
    seen = set()
    out = []
    for h in hits:
        if h not in seen:
            seen.add(h)
            out.append(h)
    return out


def aggregate_top_themes(
    reviews: list[dict],
    top_n: int = 5,
    mode: str = "negative",
    keyword_list: Optional[list[str]] = None,
) -> list[dict]:
    """Return the top N most-mentioned themes in the chosen sentiment.

    For each tracked keyword (or bug-phrase), count how many
    reviews mention it and pull a sample quote from the first match.

    Args:
        reviews: list of review dicts
        top_n: number of themes to return
        mode: 'negative' or 'positive' — which reviews to consider
        keyword_list: explicit list of themes to track (default = bug phrases)
    Returns:
        list of {theme, count, sample_quote, sample_author, sample_rid}
    """
    if keyword_list is None:
        keyword_list = _BUG_PHRASES if mode == "negative" else _PRAISE_PHRASES
    counts: dict[str, dict] = {}
    for r in reviews:
        # Filter by sentiment
        if mode == "negative" and r.get("voted_up"):
            continue
        if mode == "positive" and not r.get("voted_up"):
            continue
        text = (r.get("review") or "").lower()
        if not text:
            continue
        for phrase in keyword_list:
            if phrase in text:
                if phrase not in counts:
                    counts[phrase] = {
                        "theme": phrase,
                        "count": 0,
                        "sample_quote": "",
                        "sample_author": "",
                        "sample_rid": "",
                    }
                counts[phrase]["count"] += 1
                if not counts[phrase]["sample_quote"]:
                    author = r.get("author", {}) or {}
                    raw = (r.get("review") or "").strip().replace("\n", " ")
                    # Truncate sample to ~120 chars with the keyword in
                    # the middle if possible.
                    idx = raw.lower().find(phrase)
                    if idx >= 0:
                        start = max(0, idx - 40)
                        end = min(len(raw), idx + 80)
                        snippet = raw[start:end]
                        if start > 0:
                            snippet = "…" + snippet
                        if end < len(raw):
                            snippet = snippet + "…"
                    else:
                        snippet = raw[:120] + ("…" if len(raw) > 120 else "")
                    counts[phrase]["sample_quote"] = snippet
                    counts[phrase]["sample_author"] = author.get("steamid", "")
                    counts[phrase]["sample_rid"] = str(
                        r.get("recommendationid", "")
                    )
    # Sort by count desc
    out = sorted(counts.values(), key=lambda x: x["count"], reverse=True)
    return out[:top_n]


def compute_playtime_histogram(
    reviews: list[dict],
    buckets: int = 5,
) -> dict:
    """Return {bucket_label: {pos, neg, total}} for review playtime.

    Buckets are auto-chosen based on the data (5 evenly-spaced
    buckets between 0h and the max playtime observed).
    """
    pos_hours = []
    neg_hours = []
    for r in reviews:
        author = r.get("author", {}) or {}
        pt = int(author.get("playtime_forever", 0) or 0) / 60.0
        if r.get("voted_up"):
            pos_hours.append(pt)
        else:
            neg_hours.append(pt)
    if not pos_hours and not neg_hours:
        return {}
    all_pts = pos_hours + neg_hours
    max_pt = max(all_pts) if all_pts else 1
    max_pt = max(max_pt, 1.0)
    edges = [max_pt * i / buckets for i in range(buckets + 1)]
    out: dict = {}
    for i in range(buckets):
        label = f"{edges[i]:.1f}–{edges[i+1]:.1f}h"
        out[label] = {
            "pos": sum(1 for p in pos_hours if edges[i] <= p < edges[i+1] or
                       (i == buckets - 1 and p == edges[i+1])),
            "neg": sum(1 for p in neg_hours if edges[i] <= p < edges[i+1] or
                       (i == buckets - 1 and p == edges[i+1])),
        }
    return out


def split_first_24h(reviews: list[dict]) -> dict:
    """Split reviews into 'first 24h' and 'after first 24h' groups.

    The 'first 24h' is defined as reviews posted within 24 hours of
    the EARLIEST review in the set (typically the launch window).
    Useful for the PM to see launch-day vs settling-in reactions.
    """
    if not reviews:
        return {"first_24h": [], "after": []}
    timestamps = [int(r.get("timestamp_created", 0) or 0) for r in reviews]
    if not timestamps:
        return {"first_24h": [], "after": []}
    earliest = min(t for t in timestamps if t > 0) if any(t > 0 for t in timestamps) else 0
    if earliest == 0:
        return {"first_24h": [], "after": list(reviews)}
    cutoff = earliest + 24 * 3600
    first_24h = [r for r in reviews if int(r.get("timestamp_created", 0) or 0) >= earliest
                and int(r.get("timestamp_created", 0) or 0) <= cutoff]
    after = [r for r in reviews if int(r.get("timestamp_created", 0) or 0) > cutoff]
    return {"first_24h": first_24h, "after": after, "earliest_ts": earliest}


def compute_deltas(
    old_reviews: list[dict],
    new_reviews: list[dict],
) -> dict:
    """Compare two review sets by recommendationid. Return the new
    reviews (and a count) that are in `new_reviews` but not in
    `old_reviews`.
    """
    old_ids = {
        str(r.get("recommendationid", ""))
        for r in old_reviews if r.get("recommendationid")
    }
    new_only = [
        r for r in new_reviews
        if str(r.get("recommendationid", "")) not in old_ids
    ]
    pos = sum(1 for r in new_only if r.get("voted_up"))
    return {
        "count": len(new_only),
        "positive": pos,
        "negative": len(new_only) - pos,
        "reviews": new_only,
    }


def build_pre_ai_digest(
    reviews: list[dict],
    app_details: Optional[dict] = None,
    keyword_list: Optional[list[str]] = None,
    top_n: int = 5,
) -> str:
    """Return a short Markdown digest that the PM can hand to an AI.

    Includes:
      - Top-line stats (total, pos, neg, %)
      - Top N complaint themes (with example quotes)
      - Top N praise themes (with example quotes)
      - Top 3 reviewers by playtime (with profile URLs)
      - Quick summary line
    """
    total = len(reviews)
    if total == 0:
        return "## Pre-AI Digest\n\n_No reviews yet._\n"
    pos = sum(1 for r in reviews if r.get("voted_up"))
    neg = total - pos
    pct = round(100 * pos / total, 1) if total else 0.0
    name = (app_details or {}).get("name") if app_details else None

    lines: list[str] = []
    lines.append("## Pre-AI Digest")
    if name:
        lines.append(f"**{name}**")
    lines.append("")
    lines.append(f"- Total: **{total}** reviews ({pos} positive / {neg} negative, {pct}% positive)")
    # Top complaints
    top_neg = aggregate_top_themes(reviews, top_n=top_n, mode="negative",
                                    keyword_list=keyword_list)
    if top_neg:
        lines.append("- **Top complaints** (with example quotes):")
        for t in top_neg:
            lines.append(f"  - `{t['theme']}` ({t['count']}×) — "
                         f"\"{t['sample_quote'][:90]}\"")
    # Top praises
    top_pos = aggregate_top_themes(reviews, top_n=top_n, mode="positive",
                                    keyword_list=keyword_list)
    if top_pos:
        lines.append("- **Top praise** (with example quotes):")
        for t in top_pos:
            lines.append(f"  - `{t['theme']}` ({t['count']}×) — "
                         f"\"{t['sample_quote'][:90]}\"")
    # Quick type breakdown
    type_counts: dict[str, int] = {}
    for r in reviews:
        rt = classify_review_type(r)
        type_counts[rt] = type_counts.get(rt, 0) + 1
    if type_counts:
        bits = ", ".join(f"{k}: {v}" for k, v in
                         sorted(type_counts.items(), key=lambda kv: -kv[1]))
        lines.append(f"- **Auto-classified types**: {bits}")
    # Top reviewers
    reviewers = []
    for r in reviews:
        author = r.get("author", {}) or {}
        pt = int(author.get("playtime_forever", 0) or 0) / 60.0
        steamid = str(author.get("steamid", ""))
        if steamid:
            reviewers.append((pt, steamid, str(r.get("recommendationid", "")),
                                (r.get("review") or "")[:60]))
    reviewers.sort(key=lambda x: -x[0])
    if reviewers:
        lines.append("- **Top 3 reviewers by playtime**:")
        for pt, steamid, rid, text in reviewers[:3]:
            url = f"https://steamcommunity.com/profiles/{steamid}"
            lines.append(f"  - [{pt:.1f}h]({url}) — \"{text}\"")
    lines.append("")
    return "\n".join(lines)


def quick_stats_footer(reviews: list[dict]) -> str:
    """Return a one-line summary for the bottom of the .md export."""
    total = len(reviews)
    if total == 0:
        return ""
    pos = sum(1 for r in reviews if r.get("voted_up"))
    neg = total - pos
    pct = round(100 * pos / total, 1) if total else 0.0
    # top complaint
    top_neg = aggregate_top_themes(reviews, top_n=1, mode="negative",
                                    keyword_list=_BUG_PHRASES)
    top_label = ""
    if top_neg:
        top_label = f" · top complaint: `{top_neg[0]['theme']}` ({top_neg[0]['count']}×)"
    return (
        f"📊 **{total} reviews · {pos} positive ({pct}%) · "
        f"{neg} negative**{top_label}"
    )


# ---------------------------------------------------------------------------
# TrendsStore
# ---------------------------------------------------------------------------
class TrendsStore:
    """Persists the trend-tracking data (apps + daily metrics) to a
    single JSON file under the main dump folder.

    File format (trends.json):
        {
          "version": 1,
          "tracked_apps": [
            {"app_id": 4311090, "name": "Bus Sim 27",
             "added_at": "2026-06-17T14:30:00"}
          ],
          "data": {
            "4311090": [
              {"date": "2026-06-17",
               "wishlist": 1234, "followers": 567, "reviews": 30,
               "ts": "2026-06-17T14:30:00"}
            ]
          }
        }
    """

    VERSION = 1

    def __init__(self, dump_root: Path):
        self.path = Path(dump_root) / "trends.json"
        self._data = self._load()

    @staticmethod
    def path_for(dump_root: Path) -> Path:
        return Path(dump_root) / "trends.json"

    def _load(self) -> dict:
        if not self.path.exists():
            return {"version": self.VERSION, "tracked_apps": [], "data": {}}
        try:
            d = json.loads(self.path.read_text(encoding="utf-8"))
            d.setdefault("version", self.VERSION)
            d.setdefault("tracked_apps", [])
            d.setdefault("data", {})
            return d
        except Exception:
            return {"version": self.VERSION, "tracked_apps": [], "data": {}}

    def save(self) -> None:
        try:
            self.path.parent.mkdir(parents=True, exist_ok=True)
            self.path.write_text(
                json.dumps(self._data, indent=2, ensure_ascii=False),
                encoding="utf-8",
            )
        except OSError:
            pass

    @property
    def tracked_apps(self) -> list[dict]:
        return list(self._data.get("tracked_apps", []))

    def is_tracked(self, app_id: int) -> bool:
        return any(a.get("app_id") == app_id for a in self.tracked_apps)

    def add(self, app_id: int, name: str) -> None:
        if self.is_tracked(app_id):
            return
        self._data["tracked_apps"].append({
            "app_id": app_id,
            "name": name or f"app_{app_id}",
            "added_at": datetime.now().isoformat(timespec="seconds"),
        })
        self._data["data"].setdefault(str(app_id), [])
        self.save()

    def remove(self, app_id: int) -> None:
        self._data["tracked_apps"] = [
            a for a in self._data["tracked_apps"]
            if a.get("app_id") != app_id
        ]
        self._data["data"].pop(str(app_id), None)
        self.save()

    def record(
        self,
        app_id: int,
        wishlist: Optional[int] = None,
        followers: Optional[int] = None,
        reviews: Optional[int] = None,
        positive_ratio: Optional[float] = None,
    ) -> None:
        """Append a new data point for the current day (UTC date).
        Multiple values per day are kept — the chart layer averages
        them when rendering.
        """
        key = str(app_id)
        if key not in self._data["data"]:
            self._data["data"][key] = []
        self._data["data"][key].append({
            "date": datetime.now(timezone.utc).strftime("%Y-%m-%d"),
            "wishlist": int(wishlist) if wishlist is not None else None,
            "followers": int(followers) if followers is not None else None,
            "reviews": int(reviews) if reviews is not None else None,
            "positive_ratio": (
                float(positive_ratio) if positive_ratio is not None else None
            ),
            "ts": datetime.now().isoformat(timespec="seconds"),
        })
        self.save()

    def series(
        self,
        app_id: int,
        metric: str = "wishlist",
        since_days: Optional[int] = None,
    ) -> list[tuple[str, float]]:
        """Return [(YYYY-MM-DD, daily_avg), ...] for the metric.

        Multiple values per day are averaged. If `since_days` is set,
        only the last `since_days` calendar days are returned.
        """
        from datetime import timedelta
        points = self._data["data"].get(str(app_id), [])
        if not points:
            return []
        by_day: dict[str, list[float]] = {}
        for p in points:
            v = p.get(metric)
            if v is None:
                continue
            by_day.setdefault(p["date"], []).append(float(v))
        # Sort by date
        days = sorted(by_day.items())
        if since_days is not None and days:
            cutoff = (datetime.now(timezone.utc) - timedelta(days=since_days)).strftime("%Y-%m-%d")
            days = [(d, vs) for d, vs in days if d >= cutoff]
        return [(d, sum(vs) / len(vs)) for d, vs in days]


class CollapsibleGroup:
    """A simple collapsible group (CTkFrame with a clickable header
    that toggles the visibility of a body frame).

    Use:
        g = CollapsibleGroup(parent, "Filters", expanded=True)
        g.add_child(some_widget)
        g.add_child(another_widget)
    """

    def __init__(self, master, title: str, expanded: bool = True,
                 icon: str = ""):
        self.master = master
        self.title = title
        self.icon = icon
        self._expanded = expanded

        # Outer frame
        self.outer = ctk.CTkFrame(
            master, fg_color=("gray95", "gray15"),
            corner_radius=8,
        )

        # Header (clickable)
        self.header = ctk.CTkFrame(
            self.outer, fg_color=("gray90", "gray20"),
            corner_radius=6, height=32,
        )
        self.header.pack(fill="x", padx=2, pady=(2, 0))
        self.header.pack_propagate(False)
        # Header text + arrow on the right
        label_text = f"{icon}  {title}" if icon else title
        self.title_label = ctk.CTkLabel(
            self.header, text=label_text,
            font=("", 12, "bold"), anchor="w",
        )
        self.title_label.pack(side="left", padx=10, pady=4)
        self.arrow_label = ctk.CTkLabel(
            self.header, text="▾" if expanded else "▸",
            font=("", 12), anchor="e", text_color="gray",
        )
        self.arrow_label.pack(side="right", padx=10, pady=4)
        # Make header + label clickable
        for w in (self.header, self.title_label, self.arrow_label):
            w.bind("<Button-1>", lambda _e: self.toggle())
            w.configure(cursor="hand2")

        # Body
        self.body = ctk.CTkFrame(
            self.outer, fg_color="transparent",
        )
        if expanded:
            self.body.pack(fill="x", padx=4, pady=(0, 4))

    def add_child(self, widget) -> None:
        """Pack a child widget into the body frame."""
        widget.pack(in_=self.body, fill="x", padx=4, pady=2)

    def toggle(self) -> None:
        """Show / hide the body and update the arrow."""
        self._expanded = not self._expanded
        if self._expanded:
            self.body.pack(fill="x", padx=4, pady=(0, 4))
            self.arrow_label.configure(text="▾")
        else:
            self.body.pack_forget()
            self.arrow_label.configure(text="▸")

    def is_expanded(self) -> bool:
        return self._expanded


class InfoPanel:
    """A static info panel at the top of a tab. Always visible, does
    not scroll. Shows the currently-loaded game + key status info.

    Layout (left-to-right, 2 rows):
        Row 1: Game name (bold)  ·  App ID  ·  🕐 Berlin time
        Row 2: Dump folder (truncated)  ·  Already exported N reviews
                                                 ·  🆕 N new since last visit
    """

    def __init__(self, master):
        self.master = master
        # Outer frame: subtle background, doesn't scroll with content.
        self.frame = ctk.CTkFrame(
            master, fg_color=("gray90", "gray20"),
            corner_radius=8,
        )
        # Inner padding frame
        inner = ctk.CTkFrame(self.frame, fg_color="transparent")
        inner.pack(fill="x", padx=12, pady=8)

        # Row 1: Game name + ID + clock
        row1 = ctk.CTkFrame(inner, fg_color="transparent")
        row1.pack(fill="x")
        self.game_label = ctk.CTkLabel(
            row1, text="No game loaded", anchor="w",
            font=("", 14, "bold"),
        )
        self.game_label.pack(side="left", padx=(0, 8))
        self.app_id_label = ctk.CTkLabel(
            row1, text="", anchor="w", text_color="gray",
        )
        self.app_id_label.pack(side="left", padx=(0, 8))
        self.clock_label = ctk.CTkLabel(
            row1, text="", anchor="e", text_color="gray",
        )
        self.clock_label.pack(side="right")

        # Row 2: dump folder, already exported, new-since-visit
        row2 = ctk.CTkFrame(inner, fg_color="transparent")
        row2.pack(fill="x", pady=(4, 0))
        self.dump_label = ctk.CTkLabel(
            row2, text="📂 (no dump folder)", anchor="w",
            text_color="gray",
        )
        self.dump_label.pack(side="left", padx=(0, 12), fill="x", expand=True)
        self.exported_label = ctk.CTkLabel(
            row2, text="Already exported: 0 reviews", anchor="e",
            text_color="gray",
        )
        self.exported_label.pack(side="right", padx=(8, 8))
        self.new_visit_label = ctk.CTkLabel(
            row2, text="", anchor="e", text_color="#5dade6",
            font=("", 11, "bold"),
        )
        self.new_visit_label.pack(side="right", padx=(8, 8))

    def update(
        self,
        app_id: Optional[int] = None,
        game_name: Optional[str] = None,
        dump_folder: Optional[str] = None,
        exported_count: int = 0,
        new_visit_count: int = 0,
    ) -> None:
        """Update the panel's displayed values."""
        if game_name is not None:
            display = game_name or "No game loaded"
            self.game_label.configure(text=display)
        if app_id is not None:
            self.app_id_label.configure(
                text=f"App ID: {app_id}" if app_id else ""
            )
        if dump_folder is not None:
            # Truncate the path to fit
            text = dump_folder
            if len(text) > 60:
                text = "…" + text[-58:]
            self.dump_label.configure(text=f"📂 {text}")
        self.exported_label.configure(
            text=f"Already exported: {exported_count} reviews"
        )
        if new_visit_count > 0:
            self.new_visit_label.configure(
                text=f"🆕 {new_visit_count} new since last visit"
            )
        else:
            self.new_visit_label.configure(text="✓ No new since last visit")

    def set_clock(self, text: str) -> None:
        self.clock_label.configure(text=f"🕐 {text}")


class HelpDialog:
    """The 'How to use this tool' guide. Opens a scrollable text
    window with a step-by-step walkthrough of the main workflows.
    """

    HELP_TEXT = """\
# How to use Steam Review Analyzer

A PM/QA tool for early-game review analysis. The output is designed to
be fed to an AI (ChatGPT, Claude, etc.) for fast, structured analysis.

## Recommended workflow (5 min per game)

1. **Load the game** (Steam API tab): paste the App ID, hit Enter.
   - The app auto-adds to the **Trends tab** so you can track
     wishlist / follower / review count over time.

2. **Fetch new reviews** (green button in the action bar): pulls only
   reviews you haven't dumped before, saves to a fresh .md, updates
   the per-game `seen_ids.json` so the next run skips them.

3. **Open Top complaints** (in the secondary action row): see the
   most-common complaint / praise themes with example quotes.

4. **Copy + AI prompt** (in the secondary action row): copies the
   latest .md + your custom prompt template to the clipboard, ready
   to paste into ChatGPT/Claude.

5. **Refresh trends** (Trends tab → Refresh now): scrapes the current
   wishlist/follower/review counts and records a new daily data
   point. After a few days, the graph shows the daily trend.

## Tips

- **Use the Steam API tab** for established games (cache miss delay ~0h).
- **Use the Playwright tab** for new releases (last 24-72h, bypasses
  cache).
- **Each tab has its own dump folder** under the main dump root.
  Set the main folder with the "📁 Set…" button.
- **The "Window" filter** in the Filters section lets you keep only
  the first 24h of reviews (launch reaction) or the last 7d.
- **Settings → AI prompt template**: edit the template used for
  Copy + AI prompt. Placeholders: `{name}`, `{app_id}`, `{n}`.
- **Settings → Keyword tags**: comma-separated list of words/phrases
  to highlight in the .md export. Single words use word-boundary
  matching; multi-word phrases are substrings.
- **Top 5 reviewers** at the bottom of the .md — clickable links to
  each reviewer's profile (useful for beta outreach).
- **Search the latest dump** with the 🔍 Search button. Sentiment
  filter, helpful-count filter, and full-text query.
- **Open the latest .md in your OS editor** with the 📂 Open latest
  button — for Notepad/VSCode quick read.
- **Obsidian vault** (📓 Vault:): if set, every export is also
  copied to that folder. Good for personal-knowledge-base setups.

## Keyboard shortcuts

- `Ctrl+F` — Start a Steam API fetch
- `Ctrl+S` — Stop the current fetch
- `Ctrl+E` — Export to .md
- `Ctrl+W` — Toggle watch mode
- `Ctrl+P` — Start a Playwright scrape
- `Ctrl+R` — Resume a stopped fetch

## Where are my files?

- Main dump folder: shown in the **status bar** at the bottom of
  the window (📂 ...) and in each tab's Game section. Click
  "📂 Open" to open it in Explorer.
- Per-game folder: `<main>/<app_id>_<game_name>/`. Click
  "🎮 Open game" to open it.
- The `trends.json` file (time-series DB) lives in the main dump
  folder, not the per-game folder.
"""

    def __init__(self, master):
        self.master = master
        self._top = None

    def open(self) -> None:
        if self._top is not None and self._top.winfo_exists():
            self._top.focus()
            return
        self._top = ctk.CTkToplevel(self.master)
        self._top.title("How to use this tool")
        self._top.geometry("780x620")
        self._top.transient(self.master)
        self._top.grab_set()
        self._build()

    def _build(self) -> None:
        # Toolbar
        bar = ctk.CTkFrame(self._top, fg_color="transparent")
        bar.pack(fill="x", padx=10, pady=(10, 4))
        ctk.CTkLabel(bar, text="📖 Help — Steam Review Analyzer",
                     font=("", 14, "bold")).pack(side="left", padx=4)
        ctk.CTkButton(bar, text="Close", width=90,
                      command=self._top.destroy).pack(side="right", padx=4)

        # Help text
        box = ctk.CTkTextbox(self._top, font=("Consolas", 10), wrap="word")
        box.pack(fill="both", expand=True, padx=10, pady=4)
        box.insert("1.0", self.HELP_TEXT)
        box.configure(state="disabled")


class TopComplaintsDialog:
    """A modal popup that shows the top complaint / praise themes with
    example quotes. Built from the current in-memory reviews.
    """

    def __init__(self, master, reviews, keyword_list):
        self.master = master
        self.reviews = reviews
        self.keyword_list = keyword_list
        self._top = None

    def open(self) -> None:
        if self._top is not None and self._top.winfo_exists():
            self._top.focus()
            return
        self._top = ctk.CTkToplevel(self.master)
        self._top.title("Top themes — complaints & praise")
        self._top.geometry("760x620")
        self._top.transient(self.master)
        self._top.grab_set()
        self._build()

    def _build(self) -> None:
        ctk.CTkLabel(
            self._top,
            text=(
                "🔍 Top themes in the current review dump\n\n"
                "Each theme is a keyword/phrase that appears in multiple "
                "reviews. The example quote is the first match — check the "
                "review ID for the full context."
            ),
            anchor="w", justify="left",
        ).pack(fill="x", padx=10, pady=(10, 4))

        # Playtime histogram
        hist = compute_playtime_histogram(self.reviews, buckets=5)
        if hist:
            ctk.CTkLabel(
                self._top, text="⏱ Playtime distribution",
                font=("", 12, "bold"), anchor="w",
            ).pack(fill="x", padx=10, pady=(8, 2))
            hist_lines = ["| Playtime | Positive | Negative |",
                          "|---|---|---|"]
            for bucket, vals in hist.items():
                hist_lines.append(
                    f"| {bucket} | {vals['pos']} | {vals['neg']} |"
                )
            self._hist_box = ctk.CTkTextbox(
                self._top, height=130, font=("Consolas", 10),
            )
            self._hist_box.pack(fill="x", padx=10, pady=4)
            self._hist_box.insert("1.0", "\n".join(hist_lines))
            self._hist_box.configure(state="disabled")

        # Top complaints
        ctk.CTkLabel(
            self._top, text="🔴 Top complaints",
            font=("", 12, "bold"), anchor="w",
        ).pack(fill="x", padx=10, pady=(8, 2))
        neg_themes = aggregate_top_themes(
            self.reviews, top_n=5, mode="negative",
            keyword_list=self.keyword_list,
        )
        if neg_themes:
            lines = ["| Theme | Count | Example |", "|---|---|---|"]
            for t in neg_themes:
                quote = t["sample_quote"].replace("|", "\\|")
                lines.append(f"| `{t['theme']}` | {t['count']} | \"{quote[:80]}\" |")
            self._neg_box = ctk.CTkTextbox(
                self._top, height=130, font=("Consolas", 10),
            )
            self._neg_box.pack(fill="x", padx=10, pady=4)
            self._neg_box.insert("1.0", "\n".join(lines))
            self._neg_box.configure(state="disabled")
        else:
            ctk.CTkLabel(
                self._top, text="(no complaint themes detected)",
                text_color="gray", anchor="w",
            ).pack(fill="x", padx=10, pady=4)

        # Top praises
        ctk.CTkLabel(
            self._top, text="🟢 Top praise",
            font=("", 12, "bold"), anchor="w",
        ).pack(fill="x", padx=10, pady=(8, 2))
        pos_themes = aggregate_top_themes(
            self.reviews, top_n=5, mode="positive",
        )
        if pos_themes:
            lines = ["| Theme | Count | Example |", "|---|---|---|"]
            for t in pos_themes:
                quote = t["sample_quote"].replace("|", "\\|")
                lines.append(f"| `{t['theme']}` | {t['count']} | \"{quote[:80]}\" |")
            self._pos_box = ctk.CTkTextbox(
                self._top, height=130, font=("Consolas", 10),
            )
            self._pos_box.pack(fill="both", expand=True, padx=10, pady=4)
            self._pos_box.insert("1.0", "\n".join(lines))
            self._pos_box.configure(state="disabled")
        else:
            ctk.CTkLabel(
                self._top, text="(no praise themes detected)",
                text_color="gray", anchor="w",
            ).pack(fill="x", padx=10, pady=4)

        ctk.CTkButton(
            self._top, text="Close", width=110,
            command=self._top.destroy,
        ).pack(side="bottom", pady=8)


class SearchWindow:
    """A modal popup that lets the user full-text search the contents
    of a .md dump. Shows the matching reviews in a scrollable list.

    Use:
        SearchWindow(parent, "dump.md", text, "/path/to/dump.md").open()

    The search is case-insensitive, with optional "filter to positive"
    or "filter to negative" checkboxes for quick filtering.
    """

    def __init__(self, master, title: str, text: str, file_path: str):
        self.master = master
        self.title = title
        self.text = text
        self.file_path = file_path
        self._top = None

    def open(self) -> None:
        if self._top is not None and self._top.winfo_exists():
            self._top.focus()
            return
        self._top = ctk.CTkToplevel(self.master)
        self._top.title(f"Search: {self.title}")
        self._top.geometry("900x600")
        self._top.transient(self.master)
        self._top.grab_set()
        self._build()

    def _build(self) -> None:
        top = ctk.CTkFrame(self._top, fg_color="transparent")
        top.pack(fill="x", padx=10, pady=(10, 4))
        ctk.CTkLabel(
            top, text=f"🔍 Search in: {self.title}", anchor="w",
            font=("", 12, "bold"),
        ).pack(side="left", padx=4)
        ctk.CTkButton(
            top, text="Open in editor", width=130,
            command=self._open_in_editor,
        ).pack(side="right", padx=4)
        ctk.CTkButton(
            top, text="Close", width=80, command=self._top.destroy,
        ).pack(side="right", padx=4)

        # Search bar
        sb = ctk.CTkFrame(self._top, fg_color="transparent")
        sb.pack(fill="x", padx=10, pady=4)
        ctk.CTkLabel(sb, text="Find:", anchor="e", width=60).pack(
            side="left", padx=(0, 4)
        )
        self._query_var = ctk.StringVar()
        query_entry = ctk.CTkEntry(sb, textvariable=self._query_var, width=400)
        query_entry.pack(side="left", padx=4, fill="x", expand=True)
        query_entry.bind("<Return>", lambda _e: self._run_search())
        query_entry.bind("<KeyRelease>", lambda _e: self._schedule_search())
        self._sentiment_var = ctk.StringVar(value="all")
        ctk.CTkOptionMenu(
            sb, values=["all", "positive", "negative"],
            variable=self._sentiment_var, width=110,
            command=lambda _v: self._run_search(),
        ).pack(side="left", padx=4)
        self._min_helpful_var = ctk.StringVar(value="0")
        min_helpful_entry = ctk.CTkEntry(
            sb, textvariable=self._min_helpful_var, width=80,
            placeholder_text="min helpful",
        )
        min_helpful_entry.pack(side="left", padx=4)
        min_helpful_entry.bind("<KeyRelease>", lambda _e: self._schedule_search())
        ctk.CTkButton(
            sb, text="Search", width=80, command=self._run_search,
        ).pack(side="left", padx=4)

        # Status line
        self._status_lbl = ctk.CTkLabel(
            self._top, text="Type to search…", anchor="w",
            text_color="gray",
        )
        self._status_lbl.pack(fill="x", padx=14, pady=(0, 2))

        # Results
        self._results_box = ctk.CTkTextbox(
            self._top, height=400, font=("Consolas", 10), wrap="word",
        )
        self._results_box.pack(fill="both", expand=True, padx=10, pady=(0, 10))
        self._results_box.configure(state="disabled")

        self._after_id = None
        self._run_search()

    def _schedule_search(self) -> None:
        if self._after_id is not None:
            try:
                self._top.after_cancel(self._after_id)
            except Exception:
                pass
        self._after_id = self._top.after(200, self._run_search)

    def _open_in_editor(self) -> None:
        try:
            if sys.platform == "win32":
                os.startfile(self.file_path)  # noqa: S606
            elif sys.platform == "darwin":
                import subprocess
                subprocess.Popen(["open", self.file_path])
            else:
                import subprocess
                subprocess.Popen(["xdg-open", self.file_path])
        except Exception as exc:
            messagebox.showerror("Open failed", str(exc))

    def _run_search(self) -> None:
        if self._top is None:
            return
        query = (self._query_var.get() or "").strip().lower()
        sentiment = self._sentiment_var.get()
        try:
            min_helpful = int(self._min_helpful_var.get() or 0)
        except ValueError:
            min_helpful = 0

        if not query and sentiment == "all" and min_helpful == 0:
            self._status_lbl.configure(text="Type to search…")
            self._set_results("(no query yet)")
            return

        # Split the .md into review blocks. Each review is preceded by
        # "### Review #N" and ends at the next "---" or "### Review #N+1".
        # We only return the review text portion to keep the output
        # manageable.
        blocks: list[tuple[str, str, str]] = []  # (rid, label, text)
        current_rid: Optional[str] = None
        current_label: Optional[str] = None
        current_lines: list[str] = []
        for line in self.text.splitlines():
            if line.startswith("### Review #"):
                # Flush previous
                if current_label is not None:
                    blocks.append((
                        current_rid or "?", current_label,
                        "\n".join(current_lines),
                    ))
                # Parse "### Review #N"
                try:
                    num = line.split("#", 2)[2].strip()
                except Exception:
                    num = "?"
                current_label = f"Review #{num}"
                current_rid = None
                current_lines = []
            elif line.strip() == "---" and current_label is not None:
                blocks.append((
                    current_rid or "?", current_label,
                    "\n".join(current_lines),
                ))
                current_label = None
                current_rid = None
                current_lines = []
            else:
                if current_label is not None:
                    # Capture the recommendationid from the per-review
                    # table (we want a clickable URL).
                    if "recommendationid" in line.lower() and "|" in line:
                        # Skip; we'll extract from the table below
                        pass
                    current_lines.append(line)
        if current_label is not None:
            blocks.append((current_rid or "?", current_label, "\n".join(current_lines)))

        # Now search + filter.
        results: list[str] = []
        for rid, label, body in blocks:
            body_lc = body.lower()
            # Sentiment filter
            voted = "positive" if "👍 positive" in body_lc else \
                ("negative" if "👎 negative" in body_lc else "unknown")
            if sentiment != "all" and voted != sentiment:
                continue
            # Helpful filter
            try:
                helpful = 0
                for ln in body.splitlines():
                    if ln.lower().startswith("| helpful count"):
                        helpful = int(ln.split("|")[2].strip() or 0)
                        break
            except Exception:
                helpful = 0
            if helpful < min_helpful:
                continue
            # Query filter
            if query and query not in body_lc:
                continue
            # Output a concise snippet
            snippet = body.strip()
            if len(snippet) > 600:
                # Find the snippet around the first match
                if query:
                    i = body_lc.find(query)
                    if i >= 0:
                        start = max(0, i - 100)
                        snippet = "…" + body[start:start + 600] + "…"
                else:
                    snippet = body[:600] + "…"
            results.append(f"## {label}\n\n{snippet}\n\n---\n")
            if len(results) >= 50:
                results.append("… (truncated, refine the search)\n")
                break

        self._set_results(
            "".join(results) if results else
            "No matches. Try a different query or relax the filters."
        )
        self._status_lbl.configure(
            text=f"{len(results)} match(es) found."
        )

    def _set_results(self, text: str) -> None:
        self._results_box.configure(state="normal")
        self._results_box.delete("1.0", "end")
        self._results_box.insert("1.0", text)
        self._results_box.configure(state="disabled")


class SettingsDialog:
    """A modal popup for editing the user-configurable settings:
    - Keyword list (used for tags + highlight in the .md export)
    - AI prompt template (used by 'Copy with AI prompt' / 'Save as prompt')
    - Default new-since-last-visit threshold
    """

    def __init__(self, master):
        self.master = master
        self._top = None

    def open(self) -> None:
        if self._top is not None and self._top.winfo_exists():
            self._top.focus()
            return
        self._top = ctk.CTkToplevel(self.master)
        self._top.title("Settings")
        self._top.geometry("780x600")
        self._top.transient(self.master)
        self._top.grab_set()
        self._build()

    def _build(self) -> None:
        # Header
        ctk.CTkLabel(
            self._top,
            text=(
                "⚙ Settings\n\n"
                "These settings control how the tool tags, highlights, and "
                "presents reviews. Changes are saved automatically when you click Save."
            ),
            anchor="w", justify="left",
        ).pack(fill="x", padx=10, pady=(10, 4))

        # Keyword list editor
        ctk.CTkLabel(
            self._top,
            text=(
                "🏷 Keyword tags (comma-separated, used for review tags + highlighting in .md)\n"
                "Multi-word phrases are matched as substrings; single words use word boundaries."
            ),
            anchor="w", justify="left",
        ).pack(fill="x", padx=10, pady=(8, 2))
        self._keywords_text = ctk.CTkTextbox(
            self._top, height=120, font=("Consolas", 10), wrap="word",
        )
        self._keywords_text.pack(fill="x", padx=10, pady=(0, 4))
        # Pre-fill with current list
        self._keywords_text.insert(
            "1.0", ", ".join(self.master._get_keyword_list())
        )

        # AI prompt template
        ctk.CTkLabel(
            self._top,
            text=(
                "🤖 AI prompt template (used by 'Copy with AI prompt' / 'Save as prompt')\n"
                "Placeholders: {name} = game name, {app_id} = App ID, {n} = review count"
            ),
            anchor="w", justify="left",
        ).pack(fill="x", padx=10, pady=(8, 2))
        self._prompt_text = ctk.CTkTextbox(
            self._top, height=200, font=("Consolas", 10), wrap="word",
        )
        self._prompt_text.pack(fill="both", expand=True, padx=10, pady=(0, 4))
        self._prompt_text.insert("1.0", self.master._get_ai_prompt_template())

        # Buttons
        bar = ctk.CTkFrame(self._top, fg_color="transparent")
        bar.pack(fill="x", padx=10, pady=8)
        ctk.CTkButton(
            bar, text="Save & close", width=130,
            fg_color="#1f6aa5",
            command=self._save_and_close,
        ).pack(side="right", padx=4)
        ctk.CTkButton(
            bar, text="Cancel", width=110,
            command=self._top.destroy,
        ).pack(side="right", padx=4)
        ctk.CTkButton(
            bar, text="↺ Reset to defaults", width=160,
            command=self._reset_defaults,
        ).pack(side="left", padx=4)

    def _reset_defaults(self) -> None:
        self._keywords_text.delete("1.0", "end")
        self._keywords_text.insert("1.0", ", ".join(DEFAULT_KEYWORD_TAGS))
        self._prompt_text.delete("1.0", "end")
        # Re-show the default template
        default = (
            "You are a QA analyst for the game '{name}' (App ID {app_id}).\n"
            "Below is a dump of recent Steam reviews. Identify:\n"
            "  1. The top 3 bugs (with example quotes and review IDs)\n"
            "  2. The top 3 improvement suggestions (with quotes)\n"
            "  3. The top 3 things players are praising\n"
            "  4. Any patterns that suggest a recent regression\n"
            "Format the answer as Markdown. Be specific, cite review IDs.\n"
            "\n--- Reviews below ---\n"
        )
        self._prompt_text.insert("1.0", default)

    def _save_and_close(self) -> None:
        # Apply the texts to the App's hidden text widgets so the
        # next export / "Copy + AI prompt" call uses the new values.
        kws = self._keywords_text.get("1.0", "end").strip()
        prompt = self._prompt_text.get("1.0", "end").strip()
        try:
            self.master.keywords_text.delete("1.0", "end")
        except Exception:
            pass
        try:
            self.master.keywords_text.insert("1.0", kws)
        except Exception:
            pass
        try:
            self.master.ai_prompt_text.delete("1.0", "end")
        except Exception:
            pass
        try:
            self.master.ai_prompt_text.insert("1.0", prompt)
        except Exception:
            pass
        try:
            self.master._settings_save()
        except Exception:
            pass
        if self._top is not None:
            self._top.destroy()


class BatchDumpDialog:
    """A modal popup that lets the user paste a list of App IDs and
    queue them up for sequential "Fetch new" dumps. The worker
    runs in a background thread; the dialog stays open and shows
    per-app progress.
    """

    def __init__(self, master):
        self.master = master
        self._top = None
        self._queue: list[tuple[int, str]] = []  # (app_id, name)
        self._current_worker: Optional[threading.Thread] = None
        self._stop = threading.Event()

    def open(self) -> None:
        if self._top is not None and self._top.winfo_exists():
            self._top.focus()
            return
        self._top = ctk.CTkToplevel(self.master)
        self._top.title("Batch dump — paste App IDs")
        self._top.geometry("700x500")
        self._top.transient(self.master)
        self._top.grab_set()
        self._build()

    def _build(self) -> None:
        top = ctk.CTkFrame(self._top, fg_color="transparent")
        top.pack(fill="x", padx=10, pady=(10, 4))
        ctk.CTkLabel(
            top, text="📦 Multi-game batch dump", anchor="w",
            font=("", 13, "bold"),
        ).pack(side="left", padx=4)
        ctk.CTkButton(
            top, text="Close", width=80, command=self._close,
        ).pack(side="right", padx=4)

        # Input
        ctk.CTkLabel(
            self._top,
            text=(
                "Paste one App ID or store URL per line. Lines can also\n"
                "be 'name  app_id' pairs. Names are looked up live and shown below."
            ),
            anchor="w", justify="left",
        ).pack(fill="x", padx=14, pady=(4, 2))
        self._input_box = ctk.CTkTextbox(
            self._top, height=130, font=("Consolas", 10),
        )
        self._input_box.pack(fill="x", padx=10, pady=4)
        ctk.CTkButton(
            self._top, text="Add to queue", width=130,
            command=self._on_add_to_queue,
        ).pack(anchor="w", padx=14, pady=4)

        # Queue list
        ctk.CTkLabel(
            self._top, text="Queue:", anchor="w",
        ).pack(fill="x", padx=14, pady=(6, 0))
        self._queue_box = ctk.CTkTextbox(
            self._top, height=180, font=("Consolas", 10),
        )
        self._queue_box.pack(fill="both", expand=True, padx=10, pady=4)

        # Action bar
        bar = ctk.CTkFrame(self._top, fg_color="transparent")
        bar.pack(fill="x", padx=10, pady=4)
        self._start_btn = ctk.CTkButton(
            bar, text="▶ Start", width=110, command=self._on_start,
        )
        self._start_btn.pack(side="left", padx=4)
        self._stop_btn = ctk.CTkButton(
            bar, text="■ Stop", width=110,
            fg_color="#a83232", hover_color="#822525",
            command=self._on_stop,
        )
        self._stop_btn.pack(side="left", padx=4)
        self._clear_btn = ctk.CTkButton(
            bar, text="🧹 Clear queue", width=130,
            command=self._on_clear_queue,
        )
        self._clear_btn.pack(side="left", padx=4)
        self._status_lbl = ctk.CTkLabel(
            bar, text="(queue is empty)", anchor="w", text_color="gray",
        )
        self._status_lbl.pack(side="right", padx=4)

    def _on_add_to_queue(self) -> None:
        text = self._input_box.get("1.0", "end").strip()
        if not text:
            return
        for line in text.splitlines():
            line = line.strip()
            if not line:
                continue
            app_id = SteamAPI.resolve_app_id(line)
            if app_id is None:
                self._append_queue_line(f"(could not parse: {line!r})")
                continue
            self._queue.append((app_id, ""))
        self._refresh_queue_view()

    def _on_clear_queue(self) -> None:
        self._queue.clear()
        self._refresh_queue_view()

    def _append_queue_line(self, text: str) -> None:
        self._queue_box.configure(state="normal")
        self._queue_box.insert("end", text + "\n")
        self._queue_box.see("end")
        self._queue_box.configure(state="disabled")

    def _refresh_queue_view(self) -> None:
        self._queue_box.configure(state="normal")
        self._queue_box.delete("1.0", "end")
        for app_id, name in self._queue:
            label = f"{name} (ID {app_id})" if name else f"App {app_id}"
            self._queue_box.insert("end", f"  • {label}\n")
        self._queue_box.configure(state="disabled")
        self._status_lbl.configure(
            text=f"({len(self._queue)} app(s) in queue)"
        )

    def _on_start(self) -> None:
        if not self._queue:
            messagebox.showinfo("Queue empty", "Add some App IDs first.")
            return
        self._stop.clear()
        self._start_btn.configure(state="disabled")
        self._clear_btn.configure(state="disabled")
        self._current_worker = threading.Thread(
            target=self._batch_worker, daemon=True,
        )
        self._current_worker.start()

    def _on_stop(self) -> None:
        self._stop.set()
        self._status_lbl.configure(text="(stopping after current game)")

    def _close(self) -> None:
        self._stop.set()
        if self._top is not None:
            self._top.destroy()

    def _batch_worker(self) -> None:
        while self._queue and not self._stop.is_set():
            app_id, _name = self._queue[0]
            try:
                self._status_lbl.configure(
                    text=f"Fetching app {app_id}…"
                )
                # Use the master's _on_fetch_new path so dedup, export,
                # and seen_ids tracking are all consistent.
                self.master.app_id = app_id
                # Load app details (we use the public API)
                try:
                    self.master.app_details = self.master.api.get_app_details(
                        app_id, "english"
                    )
                except Exception:
                    self.master.app_details = None
                if self.master.app_details is None:
                    self._append_queue_line(
                        f"(skipped {app_id}: app not found)"
                    )
                    self._queue.pop(0)
                    self._refresh_queue_view()
                    continue
                # Run the API fetch worker synchronously in this thread.
                # The fetch worker doesn't touch the GUI's mainloop
                # directly, so it's safe to call from here. The
                # progress / log callbacks use after() which is a no-op
                # outside the main thread, but the underlying state
                # (self.reviews) is updated.
                self.master._fetch_new_tab = "api"
                self.master._fetch_new_auto_export = True
                # Reset state
                self.master.reviews = []
                self.master._stop_event.clear()
                # Actually run the fetch directly (not in a thread).
                try:
                    self.master._fetch_worker("*", dedup_against_seen=True)
                except Exception as exc:
                    self._append_queue_line(
                        f"(error fetching {app_id}: {exc})"
                    )
                self._queue.pop(0)
                self._refresh_queue_view()
            except Exception as exc:
                self._append_queue_line(
                    f"(error on {app_id}: {exc})"
                )
                self._queue.pop(0)
                self._refresh_queue_view()
        self._start_btn.configure(state="normal")
        self._clear_btn.configure(state="normal")
        if self._stop.is_set():
            self._status_lbl.configure(text="(stopped)")
        else:
            self._status_lbl.configure(text="(done — all apps processed)")


class TrendsWindow:
    """A modal popup that shows a line/bar chart of trend metrics
    (wishlist, followers, reviews) over time for one or more tracked
    apps.

    Features:
      - Time range selector: 1d, 1w, 1m, 3m, 6m, 1y, all
      - Chart type: line or bar
      - Metric: wishlist, followers, reviews
      - Multiple apps overlaid on the same chart (legend on the right)
      - Multiple values per day are averaged (per user requirement)
    """

    RANGE_DAYS = {
        "1d": 1, "1w": 7, "1m": 30, "3m": 90,
        "6m": 180, "1y": 365, "all": None,
    }

    def __init__(self, master, store: "TrendsStore", apps: list[dict]):
        self.master = master
        self.store = store
        self.apps = apps  # list of {"app_id": int, "name": str}
        self._top = None
        self._metric_var = ctk.StringVar(value="wishlist")
        self._range_var = ctk.StringVar(value="1w")
        self._chart_type_var = ctk.StringVar(value="line")
        self._canvas = None

    def open(self) -> None:
        if self._top is not None and self._top.winfo_exists():
            self._top.focus()
            return
        self._top = ctk.CTkToplevel(self.master)
        self._top.title("Trends graph")
        self._top.geometry("900x600")
        self._top.transient(self.master)
        self._top.grab_set()
        self._build()

    def _build(self) -> None:
        # Top bar
        top = ctk.CTkFrame(self._top, fg_color="transparent")
        top.pack(fill="x", padx=10, pady=(10, 4))

        ctk.CTkLabel(top, text="📈 Trends", font=("", 13, "bold")).pack(
            side="left", padx=4
        )

        ctk.CTkLabel(top, text="Metric:", width=60, anchor="e").pack(
            side="left", padx=(20, 4)
        )
        ctk.CTkOptionMenu(
            top, values=["wishlist", "followers", "reviews", "positive %"],
            variable=self._metric_var, width=120,
            command=lambda _v: self._redraw(),
        ).pack(side="left", padx=4)

        ctk.CTkLabel(top, text="Range:", width=50, anchor="e").pack(
            side="left", padx=(20, 4)
        )
        ctk.CTkOptionMenu(
            top, values=list(self.RANGE_DAYS.keys()),
            variable=self._range_var, width=80,
            command=lambda _v: self._redraw(),
        ).pack(side="left", padx=4)

        ctk.CTkLabel(top, text="Type:", width=40, anchor="e").pack(
            side="left", padx=(20, 4)
        )
        ctk.CTkOptionMenu(
            top, values=["line", "bar"],
            variable=self._chart_type_var, width=80,
            command=lambda _v: self._redraw(),
        ).pack(side="left", padx=4)

        ctk.CTkButton(
            top, text="Close", width=80, command=self._top.destroy,
        ).pack(side="right", padx=4)

        # Status
        self._status_lbl = ctk.CTkLabel(
            self._top, text="", anchor="w", text_color="gray",
        )
        self._status_lbl.pack(fill="x", padx=14, pady=(0, 2))

        # Chart area
        chart_frame = ctk.CTkFrame(self._top)
        chart_frame.pack(fill="both", expand=True, padx=10, pady=(0, 10))
        # We embed a tk.Canvas inside the CTk frame
        self._canvas = tkinter.Canvas(
            chart_frame, bg="#1a1a1a", highlightthickness=0,
        )
        self._canvas.pack(fill="both", expand=True, padx=2, pady=2)
        # Redraw on resize
        self._canvas.bind("<Configure>", lambda _e: self._redraw())

        self._redraw()

    def _redraw(self) -> None:
        if self._canvas is None:
            return
        c = self._canvas
        c.delete("all")
        w = c.winfo_width()
        h = c.winfo_height()
        if w < 50 or h < 50:
            return

        metric = self._metric_var.get()
        range_label = self._range_var.get()
        since_days = self.RANGE_DAYS.get(range_label)
        chart_type = self._chart_type_var.get()

        # Collect series for all apps. "positive %" is a derived
        # metric — the trends store records it as `positive_ratio` on
        # every refresh, so we can plot it directly.
        series: list[tuple[str, list[tuple[str, float]]]] = []
        for app in self.apps:
            if metric == "positive %":
                # Pull the positive_ratio field from the store.
                if since_days is None:
                    raw = self.store._data["data"].get(str(app["app_id"]), [])
                    data = [
                        (p["date"], p.get("positive_ratio"))
                        for p in raw
                        if p.get("positive_ratio") is not None
                    ]
                else:
                    from datetime import timedelta as _td
                    cutoff = (
                        datetime.now(timezone.utc) - _td(days=since_days)
                    ).strftime("%Y-%m-%d")
                    raw = self.store._data["data"].get(str(app["app_id"]), [])
                    data = [
                        (p["date"], p.get("positive_ratio"))
                        for p in raw
                        if p.get("positive_ratio") is not None
                        and p["date"] >= cutoff
                    ]
                # Average same-day values
                by_day: dict[str, list[float]] = {}
                for d, v in data:
                    by_day.setdefault(d, []).append(float(v))
                data = [(d, sum(vs) / len(vs)) for d, vs in by_day.items()]
            else:
                data = self.store.series(app["app_id"], metric, since_days)
            series.append((app.get("name") or f"app_{app['app_id']}", data))

        # Filter apps that have any data for this metric
        series = [(name, data) for name, data in series if data]
        if not series:
            c.create_text(
                w // 2, h // 2,
                text=(
                    "No data yet for the selected metric/range.\n"
                    "Click 'Refresh now' on the Trends tab to record data points."
                ),
                fill="#888", font=("Consolas", 11), justify="center",
            )
            return

        # Compute global y range across all series
        all_vals = [v for _, data in series for _, v in data]
        y_min = min(all_vals)
        y_max = max(all_vals)
        if y_min == y_max:
            y_max = y_min + 1
        # Pad y range a bit
        y_pad = (y_max - y_min) * 0.1
        y_min -= y_pad
        y_max += y_pad

        # Compute global x range (dates)
        all_dates = sorted({d for _, data in series for d, _ in data})
        if not all_dates:
            return
        x_first = all_dates[0]
        x_last = all_dates[-1]

        # Plot area
        margin_left = 70
        margin_right = 180
        margin_top = 30
        margin_bottom = 50
        plot_x0 = margin_left
        plot_y0 = margin_top
        plot_x1 = w - margin_right
        plot_y1 = h - margin_bottom

        # Background
        c.create_rectangle(
            plot_x0, plot_y0, plot_x1, plot_y1,
            fill="#1a1a1a", outline="#444", width=1,
        )

        # Y gridlines + labels (5 lines)
        n_grid = 5
        for i in range(n_grid + 1):
            y_val = y_min + (y_max - y_min) * (1 - i / n_grid)
            y_px = plot_y0 + i * (plot_y1 - plot_y0) / n_grid
            c.create_line(
                plot_x0, y_px, plot_x1, y_px,
                fill="#333", width=1, dash=(2, 4),
            )
            label = f"{y_val:,.0f}" if y_val >= 1000 else f"{y_val:.1f}"
            c.create_text(
                plot_x0 - 6, y_px, anchor="e", fill="#bbb",
                text=label, font=("Consolas", 9),
            )

        # X axis labels (start, mid, end)
        c.create_text(
            plot_x0, plot_y1 + 6, anchor="nw", fill="#bbb",
            text=x_first, font=("Consolas", 9),
        )
        c.create_text(
            (plot_x0 + plot_x1) // 2, plot_y1 + 6, anchor="n",
            fill="#bbb", text=f"({len(all_dates)} pts)",
            font=("Consolas", 9),
        )
        c.create_text(
            plot_x1, plot_y1 + 6, anchor="ne", fill="#bbb",
            text=x_last, font=("Consolas", 9),
        )

        # Title
        c.create_text(
            w // 2, 12, fill="#fff",
            text=f"{metric.capitalize()} — last {range_label}",
            font=("Consolas", 11, "bold"),
        )

        # Helper: convert (date, value) -> pixel
        n_dates = len(all_dates)
        date_to_x = {
            d: plot_x0 + i * (plot_x1 - plot_x0) / max(1, n_dates - 1)
            for i, d in enumerate(all_dates)
        }
        def y_for(v: float) -> float:
            return plot_y0 + (y_max - v) * (plot_y1 - plot_y0) / (y_max - y_min)

        # Colors for the legend / lines
        palette = ["#5dade6", "#e67e22", "#2ecc71", "#e74c3c", "#9b59b6", "#f1c40f", "#1abc9c"]
        legend_y = margin_top
        for i, (name, data) in enumerate(series):
            color = palette[i % len(palette)]
            # Plot the line/bar
            pts = [(date_to_x[d], y_for(v)) for d, v in data if d in date_to_x]
            if chart_type == "line":
                for (x1, y1), (x2, y2) in zip(pts[:-1], pts[1:]):
                    c.create_line(
                        x1, y1, x2, y2, fill=color, width=2,
                    )
                # Markers
                for x, y in pts:
                    c.create_oval(x - 3, y - 3, x + 3, y + 3, fill=color, outline="")
            else:  # bar
                if not pts:
                    continue
                bar_w = max(2, (plot_x1 - plot_x0) / max(1, len(all_dates)) * 0.7)
                for (x, _y), (d, v) in zip(pts, data):
                    y_top = y_for(v)
                    y_bot = y_for(y_min)
                    c.create_rectangle(
                        x - bar_w / 2, y_top,
                        x + bar_w / 2, max(y_bot, y_top + 1),
                        fill=color, outline="",
                    )
            # Legend entry
            c.create_rectangle(
                plot_x1 + 10, legend_y, plot_x1 + 26, legend_y + 10,
                fill=color, outline="",
            )
            latest_v = data[-1][1] if data else 0
            label = f"{name[:24]:<24} {latest_v:>10,.0f}"
            c.create_text(
                plot_x1 + 30, legend_y + 5, anchor="w", fill="#ddd",
                text=label, font=("Consolas", 9),
            )
            legend_y += 18

        # Footer with summary
        total_pts = sum(len(data) for _, data in series)
        c.create_text(
            w // 2, h - 4, fill="#666",
            text=(
                f"{total_pts} data point(s) across {len(series)} game(s). "
                f"Multiple values per day are averaged."
            ),
            font=("Consolas", 8),
        )


class SteamAPI:
    """Thin wrapper around the public Steam Store API."""

    # Realistic Chrome-on-Windows UA. Steam's review cache for new apps
    # is sensitive to suspicious UAs and may return 0 reviews for bots.
    DEFAULT_UA = (
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
        "AppleWebKit/537.36 (KHTML, like Gecko) "
        "Chrome/120.0.0.0 Safari/537.36"
    )

    def __init__(self) -> None:
        self.session = requests.Session()
        self.session.headers.update({
            "User-Agent": self.DEFAULT_UA,
            "Accept": "application/json, text/plain, */*",
            "Accept-Language": "en-US,en;q=0.9",
            "Accept-Encoding": "gzip, deflate, br",
            "Connection": "keep-alive",
            "DNT": "1",
            "Sec-Ch-Ua": '"Not_A Brand";v="8", "Chromium";v="120", "Google Chrome";v="120"',
            "Sec-Ch-Ua-Mobile": "?0",
            "Sec-Ch-Ua-Platform": '"Windows"',
            "Sec-Fetch-Dest": "empty",
            "Sec-Fetch-Mode": "cors",
            "Sec-Fetch-Site": "same-origin",
            "Referer": "https://store.steampowered.com/",
            "X-Requested-With": "XMLHttpRequest",
        })
        # In-memory set of review IDs we have already processed in watch mode.
        # This is per-session; for cross-session persistence, callers can
        # serialize this with pickle/json.
        self._seen_review_ids: set[str] = set()

    def reset_seen_reviews(self) -> None:
        """Clear the watch-mode 'seen' set (useful for re-detection)."""
        self._seen_review_ids.clear()

    def export_seen_review_ids(self) -> list[str]:
        return list(self._seen_review_ids)

    def import_seen_review_ids(self, ids: list[str]) -> None:
        self._seen_review_ids = set(ids)

    # ------------------------------------------------------------------ utils

    @staticmethod
    def resolve_app_id(query: str) -> Optional[int]:
        """
        Accepts:
          - bare App ID:  "4311090"
          - store URL:    "https://store.steampowered.com/app/4311090/..."
          - sub URL:      "steam://run/4311090"
        Returns int App ID or None.
        """
        q = (query or "").strip()
        if not q:
            return None
        if q.isdigit():
            return int(q)
        m = re.search(r"/app/(\d+)", q)
        if m:
            return int(m.group(1))
        m = re.search(r"/(?:run|subs)/(\d+)", q)
        if m:
            return int(m.group(1))
        return None

    # --------------------------------------------------------------- app info

    def get_app_details(
        self, app_id: int, language: str = "english"
    ) -> Optional[dict]:
        """Fetch full app metadata (name, dev, publisher, descriptions, ...)."""
        url = f"{STEAM_API_BASE}/appdetails"
        try:
            r = self.session.get(
                url,
                params={"appids": app_id, "l": language},
                timeout=30,
            )
            r.raise_for_status()
            data = r.json()
        except (requests.RequestException, ValueError) as exc:
            print(f"[SteamAPI] get_app_details failed: {exc}")
            return None

        node = data.get(str(app_id))
        if not node or not node.get("success"):
            return None
        return node.get("data")

    # --------------------------------------------------------------- reviews

    def get_popularity_metrics(self, app_id: int, language: str = "english") -> dict:
        """Scrape wishlist / follower / review counts from the Steam
        storefront HTML. The counts are embedded in the page in various
        places; we try several patterns. Any value may be None.

        This is a cheap (single HTTP request) alternative to using
        Playwright; the tradeoff is that some counts may be missing
        if Steam changes the DOM structure.
        """
        url = f"https://store.steampowered.com/app/{app_id}/"
        out = {"wishlist": None, "followers": None, "reviews": None}
        try:
            r = self.session.get(
                url, params={"l": language}, timeout=30,
            )
            r.raise_for_status()
            html = r.text
        except Exception:
            return out
        import re
        # Wishlist: look for patterns like "X users have this ..."
        # or in data attributes / JSON blobs.
        for pat in (
            r'"wishlist_count"\s*:\s*(\d+)',
            r'(\d[\d,]+)\s*people\s*have\s*this\s*in\s*their\s*wishlist',
            r'"inWishlist"\s*:\s*(\d+)',
            r'wishlist_count["\s:]+(\d+)',
        ):
            m = re.search(pat, html, re.IGNORECASE)
            if m:
                try:
                    out["wishlist"] = int(m.group(1).replace(",", ""))
                    break
                except Exception:
                    pass
        # Followers: only shown for unreleased / upcoming games.
        for pat in (
            r'"followed_by_count"\s*:\s*(\d+)',
            r'(\d[\d,]+)\s*followers',
            r'"numFollowers"\s*:\s*(\d+)',
        ):
            m = re.search(pat, html, re.IGNORECASE)
            if m:
                try:
                    out["followers"] = int(m.group(1).replace(",", ""))
                    break
                except Exception:
                    pass
        # Reviews: total review count.
        for pat in (
            r'"review_summary_num"\s*:\s*(\d+)',
            r'"total_reviews"\s*:\s*(\d+)',
            r'>([\d,]+)<[^>]*reviews?[^\d<]',
        ):
            m = re.search(pat, html, re.IGNORECASE)
            if m:
                try:
                    out["reviews"] = int(m.group(1).replace(",", ""))
                    break
                except Exception:
                    pass
        return out

    def get_storefront_stats_from_html(self, app_id: int) -> dict:
        """
        Fallback: parse the Steam storefront HTML to extract the
        user-visible review summary (count + score label).

        This works even when the JSON review API returns 0 reviews
        (the case for newly-published apps whose review cache is not
        yet populated).

        Returns dict with keys: total_reviews, score_label, score (1-10),
        positive_pct, html_ok. html_ok=False if nothing parseable was
        found.
        """
        url = f"https://store.steampowered.com/app/{app_id}/"
        out = {
            "total_reviews": 0,
            "score_label": "Unknown",
            "score": 0,
            "positive_pct": 0.0,
            "html_ok": False,
        }
        try:
            r = self.session.get(url, params={"l": "english"}, timeout=30)
            r.raise_for_status()
            html = r.text
        except (requests.RequestException, ValueError) as exc:
            print(f"[SteamAPI] storefront stats fetch failed: {exc}")
            return out

        # Steam embeds review data in JSON inside the HTML page under
        # a key like "review_summary":{...} or in the "Customer reviews"
        # section. Try JSON first.
        m = re.search(
            r'"review_summary"\s*:\s*\{[^{}]*?'
            r'"review_score"\s*:\s*(\d+)[^{}]*?'
            r'"review_score_desc"\s*:\s*"([^"]+)"[^{}]*?'
            r'"total_positive"\s*:\s*(\d+)[^{}]*?'
            r'"total_negative"\s*:\s*(\d+)[^{}]*?'
            r'"total_reviews"\s*:\s*(\d+)',
            html,
        )
        if m:
            score, label, pos, neg, total = m.groups()
            out["score"] = int(score)
            out["score_label"] = label
            out["total_reviews"] = int(total)
            pos_i, total_i = int(pos), int(total)
            out["positive_pct"] = (
                round(100 * pos_i / total_i, 1) if total_i else 0.0
            )
            out["html_ok"] = True
            return out

        # Fallback: regex on the visible "Mixed (N reviews)" text
        m = re.search(
            r'(Overwhelmingly Positive|Very Positive|Positive|Mostly Positive|'
            r'Mixed|Mostly Negative|Negative|Very Negative|Overwhelmingly Negative)'
            r'\s*\((\d+)\s*reviews?\)',
            html,
        )
        if m:
            out["score_label"] = m.group(1)
            out["total_reviews"] = int(m.group(2))
            out["html_ok"] = True
            return out

        return out

    def fetch_all_reviews(
        self,
        app_id: int,
        language: str = "all",
        review_filter: str = "all",
        review_type: str = "all",
        day_range: Optional[int] = None,
        min_date_ts: Optional[int] = None,
        num_per_page: int = 100,
        progress_cb: Optional[Callable[[int, int, int], None]] = None,
        log_cb: Optional[Callable[[str], None]] = None,
        stop_flag: Optional[Callable[[], bool]] = None,
        start_cursor: str = "*",
        cursor_cb: Optional[Callable[[str], None]] = None,
        purchase_type: str = "all",
        playtime_filter_min: Optional[int] = None,
        playtime_filter_max: Optional[int] = None,
        filter_offtopic_activity: bool = True,
    ) -> list[dict]:
        """
        Iterate the full reviews feed via cursor pagination.
        Stops when Steam returns an empty cursor or `stop_flag()` is True.

        progress_cb(page, fetched_so_far, total_reported) is called per page.
        min_date_ts (Unix seconds) is applied CLIENT-SIDE after each page,
        because the Steam API has no native 'since timestamp' parameter.

        New (server-side) filters:
          purchase_type            — "all" | "steam" | "non_steam"
          playtime_filter_min/max  — integer minutes (only keep reviews
                                    from players with at least/at most
                                    that much playtime)
          filter_offtopic_activity — when True (default), Steam hides
                                    reviews flagged as "off-topic"
                                    (memes, testing, etc.)

        For resume, pass the saved `start_cursor` and use `cursor_cb`
        to receive each page's NEXT cursor as the loop progresses.
        """
        all_reviews: list[dict] = []
        cursor = start_cursor or "*"
        page = 0
        total_reported = 0

        while True:
            if stop_flag and stop_flag():
                if log_cb:
                    log_cb("Fetch cancelled by user.")
                break

            params = {
                "json": 1,
                "language": language,
                "filter": review_filter,
                "review_type": review_type,
                "num_per_page": num_per_page,
                "cursor": cursor,
                "purchase_type": purchase_type,
                "filter_offtopic_activity": (
                    "true" if filter_offtopic_activity else "false"
                ),
            }
            if day_range is not None:
                params["day_range"] = day_range
            if playtime_filter_min is not None:
                params["playtime_filter_min"] = playtime_filter_min
            if playtime_filter_max is not None:
                params["playtime_filter_max"] = playtime_filter_max

            try:
                r = self.session.get(
                    f"{STEAM_REVIEWS_BASE}/{app_id}",
                    params=params,
                    timeout=60,
                )
                r.raise_for_status()
                data = r.json()
            except (requests.RequestException, ValueError) as exc:
                if log_cb:
                    log_cb(f"Network error on page {page}: {exc}")
                break

            if not data.get("success"):
                if log_cb:
                    log_cb("Steam returned success=0; aborting.")
                break

            page_reviews = data.get("reviews", []) or []
            total_reported = (
                data.get("query_summary", {}).get("total_reviews", total_reported)
            )

            if min_date_ts is not None:
                page_reviews = [
                    rv for rv in page_reviews
                    if int(rv.get("timestamp_created", 0)) >= min_date_ts
                ]

            all_reviews.extend(page_reviews)
            page += 1

            if progress_cb:
                progress_cb(page, len(all_reviews), total_reported)
            if log_cb:
                log_cb(
                    f"Page {page}: +{len(page_reviews)} reviews "
                    f"(total kept: {len(all_reviews)}, server total: {total_reported})"
                )

            new_cursor = data.get("cursor", "")
            # Steam signals end-of-feed with empty cursor OR unchanged cursor.
            if not new_cursor or new_cursor == cursor:
                break
            cursor = new_cursor
            # Notify the caller of the latest cursor so it can save
            # the resume state on Stop without re-parsing anything.
            if cursor_cb is not None:
                try:
                    cursor_cb(cursor)
                except Exception:
                    pass

            # Be polite: 0.4 s between calls
            time.sleep(0.4)

        return all_reviews

    def poll_recent_reviews(
        self,
        app_id: int,
        max_pages: int = 1,
        page_size: int = 100,
        language: str = "all",
    ) -> list[dict]:
        """
        Fetch the most recent reviews using filter='recent'.

        Returns ONLY reviews whose `recommendationid` we have not seen
        before in this session (watch-mode diff). The internal set of
        seen IDs is updated in place.

        IMPORTANT: This still goes through Steam's JSON review cache,
        which lags 24-72h for newly-published apps. For truly real-time
        data, use `fetch_via_apify()` instead (requires Apify token).
        """
        new_reviews: list[dict] = []
        cursor = "*"
        for _ in range(max_pages):
            params = {
                "json": 1,
                "language": language,
                "filter": "recent",  # KEY: 'recent' is more up-to-date than 'all'
                "num_per_page": page_size,
                "cursor": cursor,
            }
            try:
                r = self.session.get(
                    f"https://store.steampowered.com/appreviews/{app_id}",
                    params=params,
                    timeout=60,
                )
                r.raise_for_status()
                data = r.json()
            except (requests.RequestException, ValueError) as exc:
                print(f"[SteamAPI] poll_recent_reviews error: {exc}")
                break

            if not data.get("success"):
                break

            for rv in data.get("reviews", []) or []:
                rid = rv.get("recommendationid")
                if rid and rid not in self._seen_review_ids:
                    self._seen_review_ids.add(rid)
                    new_reviews.append(rv)

            new_cursor = data.get("cursor", "")
            if not new_cursor or new_cursor == cursor:
                break
            cursor = new_cursor
            time.sleep(0.3)
        return new_reviews

    # --------------------------------------------------------------- apify

    # Apify "Steam Reviews Scraper" actor ID. This actor scrapes the
    # store page directly via a headless browser, so it BYPASSES the
    # JSON review cache and returns truly current data.
    APIFY_STEAM_REVIEWS_ACTOR = "bebity~steam-reviews-scraper"

    def fetch_via_apify(
        self,
        app_id: int,
        apify_token: str,
        max_items: int = 100,
        sort: str = "recent",
        language: str = "all",
    ) -> list[dict]:
        """
        Fetch reviews via Apify's Steam Reviews Scraper actor.
        Bypasses Steam's review cache by scraping the store page directly.

        Requires a (free) Apify account and an API token.
        Pricing: ~$1 per 1,000 reviews; free tier includes ~$5/month credit.

        Returns reviews in Steam-API-compatible dict format.
        """
        if not apify_token:
            raise ValueError("Apify token is required")

        url = (
            f"https://api.apify.com/v2/acts/{self.APIFY_STEAM_REVIEWS_ACTOR}"
            f"/run-sync-get-dataset-items"
        )
        params = {"token": apify_token, "timeout": 120}
        payload = {
            "appIds": [str(app_id)],
            "maxItems": max_items,
            "sort": sort,
            "language": language,
        }
        r = self.session.post(
            url, params=params, json=payload, timeout=180
        )
        r.raise_for_status()
        items = r.json()
        if not isinstance(items, list):
            raise ValueError(f"Unexpected Apify response: {items!r}")

        # Apify returns its own format; normalize to Steam-API shape.
        out: list[dict] = []
        for item in items:
            # Guard against malformed items (None, list, str, …) which
            # would otherwise crash the .get() chain.
            if not isinstance(item, dict):
                continue
            out.append({
                "recommendationid": item.get("recommendationid")
                or item.get("reviewId")
                or item.get("id"),
                "language": item.get("language", "english"),
                "review": item.get("reviewText")
                or item.get("review")
                or item.get("text", ""),
                "timestamp_created": item.get("createdAt")
                or item.get("timestamp_created")
                or 0,
                "timestamp_updated": item.get("updatedAt")
                or item.get("timestamp_updated")
                or 0,
                "voted_up": (
                    item.get("votedUp")
                    if item.get("votedUp") is not None
                    else (
                        item.get("voted_up")
                        if item.get("voted_up") is not None
                        else item.get("positive", False)
                    )
                ),
                "votes_up": item.get("helpfulCount")
                or item.get("votes_up", 0),
                "votes_funny": item.get("funnyCount")
                or item.get("votes_funny", 0),
                "comment_count": item.get("commentCount")
                or item.get("comment_count", 0),
                "steam_purchase": item.get("steamPurchase"),
                "received_for_free": item.get("receivedForFree"),
                "written_during_early_access": item.get("earlyAccessReview"),
                "weighted_vote_score": item.get("weightedVoteScore"),
                "author": {
                    "steamid": item.get("userId")
                    or item.get("steamid")
                    or "",
                    "playtime_forever": item.get("playtimeForever")
                    or item.get("playtime_forever", 0),
                    "last_played": item.get("lastPlayed")
                    or item.get("last_played", 0),
                },
            })
        return out

    # --------------------------------------------------------------- playwright

    # ---- external-Python helpers (used when running from a frozen .exe) ---

    @staticmethod
    def _find_external_python() -> Optional[str]:
        """Find a Python interpreter on the system that we can use to
        run pip / playwright CLI. Used by the install helpers AND by
        the availability probes so that both the install and the
        post-install status check agree on which interpreter they are
        talking to.

        Strategy (same as the old App._find_working_python):
          1. If we are NOT running in a frozen .exe, sys.executable
             is the right answer — it is the interpreter that ran the
             app, and `import` checks in the app's process will agree
             with what that interpreter can see.
          2. Otherwise, search PATH for python/python3/py.
          3. Otherwise, probe common Windows install locations.
        """
        import shutil
        if not getattr(sys, "frozen", False):
            return sys.executable
        for cmd in ("python", "python3", "py", "python.exe", "python3.exe"):
            p = shutil.which(cmd)
            if p:
                return p
        candidates: list[str] = []
        for ver in ("313", "312", "311", "310", "39", "38"):
            candidates += [
                os.path.expandvars(
                    rf"%LOCALAPPDATA%\Programs\Python\Python{ver}\python.exe"
                ),
                rf"C:\Python{ver}\python.exe",
            ]
        for c in candidates:
            if os.path.exists(c):
                return c
        return None

    @staticmethod
    def _probe_external_python(snippet: str, timeout: int = 30) -> tuple[bool, str]:
        """Run a small Python snippet using the EXTERNAL interpreter
        (the one the install helpers use). Returns (ok, output).

        This is the only reliable way to check package / binary
        availability from a frozen .exe, because `import` in the
        app's own process cannot see packages installed in the
        external interpreter.
        """
        import subprocess
        import tempfile
        py = SteamAPI._find_external_python()
        if not py:
            return False, ""
        helper = Path(tempfile.gettempdir()) / f"_srt_probe_{os.getpid()}.py"
        try:
            helper.write_text(snippet, encoding="utf-8")
            r = subprocess.run(
                [py, str(helper)],
                capture_output=True, text=True, timeout=timeout,
            )
            return r.returncode == 0, (r.stdout or "") + (r.stderr or "")
        except Exception:
            return False, ""
        finally:
            try:
                helper.unlink()
            except Exception:
                pass

    @staticmethod
    def is_playwright_available() -> bool:
        """Check if the playwright package can be imported.

        In a frozen .exe, playwright is not bundled, so `import
        playwright` in our own process always fails. We therefore
        ask the EXTERNAL interpreter — the same one the install
        helper used — to try the import. This keeps the post-install
        status check consistent with the install target.
        """
        if not getattr(sys, "frozen", False):
            # Use importlib.util.find_spec to test importability without
            # triggering pyflakes' unused-import warning.
            import importlib.util
            return importlib.util.find_spec("playwright") is not None
        ok, _out = SteamAPI._probe_external_python("import playwright\n")
        return ok

    @staticmethod
    def is_chromium_installed() -> bool:
        """Check if Playwright's bundled Chromium is downloaded.

        In a frozen .exe we cannot import playwright locally, so we
        delegate to the external interpreter. The snippet mirrors
        the non-frozen path: ask playwright for chromium's
        executable_path and verify the file exists.
        """
        if not getattr(sys, "frozen", False):
            if not SteamAPI.is_playwright_available():
                return False
            try:
                from playwright.sync_api import sync_playwright
                with sync_playwright() as p:
                    try:
                        exe = p.chromium.executable_path
                        from pathlib import Path
                        return Path(exe).exists()
                    except Exception:
                        return False
            except Exception:
                return False
        # Frozen: probe the external interpreter.
        snippet = (
            "from playwright.sync_api import sync_playwright\n"
            "from pathlib import Path\n"
            "import sys\n"
            "try:\n"
            "    with sync_playwright() as p:\n"
            "        exe = p.chromium.executable_path\n"
            "        if exe and Path(exe).exists():\n"
            "            sys.exit(0)\n"
            "except Exception:\n"
            "    pass\n"
            "sys.exit(1)\n"
        )
        ok, _out = SteamAPI._probe_external_python(snippet, timeout=30)
        return ok

    def fetch_via_playwright(
        self,
        app_id: int,
        max_items: int = 100,
        sort: str = "recent",
        language: str = "all",
        progress_cb: Optional[Callable[[str], None]] = None,
        start_cursor: str = "*",
        start_fetched: int = 0,
        purchase_type: str = "all",
        playtime_filter_min: int = 0,
        playtime_filter_max: int = 0,
        filter_offtopic_activity: bool = True,
        user_review_filter: str = "0",
        since_timestamp: Optional[int] = None,
    ) -> list[dict]:
        """
        Scrape Steam reviews using a real headless Chromium browser.

        HOW IT WORKS:
          1. Launch headless Chromium
          2. Navigate to the store page with the reviews hash
          3. Steam's JavaScript will load reviews via AJAX
          4. We intercept the /appreviews/<id> AJAX responses
          5. We can also keep clicking "Load more reviews" to fetch more

        This bypasses the JSON-API cache because the browser session
        uses a different cache partition than the public API endpoint,
        AND it scrapes DOM-rendered review counts that are not in the
        API cache at all.

        Requires the `playwright` package and `playwright install chromium`
        (one-time, ~150 MB download).

        Dispatch:
          * When running as a normal script, we import playwright
            directly (fast, no subprocess overhead).
          * When running from a frozen .exe, playwright is not bundled,
            so we spawn the EXTERNAL Python interpreter — the same one
            the install helper used — to run the scraper. This is what
            makes the .exe self-contained without forcing the user to
            install playwright into the build venv.

        For resume, pass the saved `start_cursor` (the cursor for the
        NEXT page after the last completed one) and `start_fetched`
        (how many reviews were already collected). Returns only the
        newly fetched reviews; the caller should append to the
        existing list.

        `since_timestamp` (UTC unix seconds, optional) — a lower
        bound applied client-side in the helper. Used for the
        "When to include" filter.
        """
        if getattr(sys, "frozen", False):
            return self._fetch_via_playwright_subprocess(
                app_id, max_items, sort, language, progress_cb,
                start_cursor=start_cursor,
                start_fetched=start_fetched,
                purchase_type=purchase_type,
                playtime_filter_min=playtime_filter_min,
                playtime_filter_max=playtime_filter_max,
                filter_offtopic_activity=filter_offtopic_activity,
                user_review_filter=user_review_filter,
                since_timestamp=since_timestamp,
            )
        return self._fetch_via_playwright_inproc(
            app_id, max_items, sort, language, progress_cb,
            start_cursor=start_cursor,
        )

    def _fetch_via_playwright_inproc(
        self,
        app_id: int,
        max_items: int,
        sort: str,
        language: str,
        progress_cb: Optional[Callable[[str], None]],
        start_cursor: str = "*",
    ) -> list[dict]:
        """Run the scraper in this process (script mode).

        Note: this code path is only used when NOT running from a
        frozen .exe (i.e. when running the .py script directly). It
        intercepts the page's own AJAX calls, so it cannot honour a
        resume cursor — the page's JavaScript owns the cursor.
        If `start_cursor != "*"`, we log a warning and fall back to a
        full fetch (the saved reviews should already be in the GUI's
        `pw_reviews` list; the returned reviews are appended to it).
        """
        if start_cursor and start_cursor != "*":
            if progress_cb:
                progress_cb(
                    "Note: in-process Playwright does not support resume. "
                    "Falling back to a full fetch."
                )
        if not self.is_playwright_available():
            raise RuntimeError(
                "Playwright is not installed. Open the Playwright tab and click "
                "'Install Playwright' first, or run: pip install playwright"
            )

        from playwright.sync_api import sync_playwright

        def log(msg: str) -> None:
            if progress_cb:
                progress_cb(msg)
            print(f"[Playwright] {msg}")

        log("Launching headless Chromium…")
        results: list[dict] = []
        try:
            with sync_playwright() as p:
                browser = p.chromium.launch(
                    headless=True,
                    args=[
                        "--no-sandbox",
                        "--disable-blink-features=AutomationControlled",
                    ],
                )
                context = browser.new_context(
                    user_agent=self.DEFAULT_UA,
                    locale="en-US",
                    viewport={"width": 1280, "height": 900},
                )
                page = context.new_page()

                # Intercept the AJAX review responses.
                # Steam loads reviews via /appreviews/<id>?json=1&cursor=...
                def handle_response(response):
                    try:
                        url = response.url
                        if (
                            "appreviews" in url
                            and "json=1" in url
                            and response.status == 200
                        ):
                            data = response.json()
                            if isinstance(data, dict) and "reviews" in data:
                                results.extend(data.get("reviews", []))
                    except Exception:
                        pass

                page.on("response", handle_response)

                # Build URL with desired sort
                sort_map = {
                    "recent": "filter=recent",
                    "helpful": "filter=all",
                    "positive": "filter=all&review_type=positive",
                    "negative": "filter=all&review_type=negative",
                }
                sort_qs = sort_map.get(sort, "filter=recent")
                url = (
                    f"https://store.steampowered.com/app/{app_id}/"
                    f"?l={language}#{sort_qs}"
                )
                log(f"Navigating to {url}")
                page.goto(url, wait_until="domcontentloaded", timeout=60000)

                # Wait for review cards to appear
                log("Waiting for review cards to render…")
                try:
                    page.wait_for_selector(
                        ".apphub_Card, .review_card, [data-review-id]",
                        timeout=30000,
                    )
                except Exception:
                    log(
                        "No review cards appeared in 30s. The app may genuinely "
                        "have no reviews, or Steam may be blocking the browser."
                    )

                # Try to load more reviews by clicking "Load more"
                click_attempts = 0
                max_clicks = min(5, max_items // 10)
                while click_attempts < max_clicks and len(results) < max_items:
                    try:
                        # Steam uses different button classes over time; try a few.
                        btn = page.query_selector(
                            "#load_more_reviews, "
                            ".load_more_reviews, "
                            "button[onclick*='ShowMoreReviews']"
                        )
                        if not btn:
                            # Try a generic "more results" text
                            btn = page.get_by_text("Load more", exact=False).first
                        if not btn:
                            break
                        log(f"Clicking 'Load more' (attempt {click_attempts + 1})…")
                        btn.click(timeout=3000)
                        page.wait_for_timeout(2000)
                    except Exception:
                        break
                    click_attempts += 1

                log(f"Captured {len(results)} raw reviews from AJAX.")

                # If the interception didn't catch anything (e.g., Steam changed
                # its internal API), fall back to DOM extraction.
                if not results:
                    log("Trying DOM extraction as fallback…")
                    dom_reviews = page.evaluate(
                        """
                        () => {
                            const out = [];
                            const cards = document.querySelectorAll(
                                '.apphub_Card, .review_card'
                            );
                            cards.forEach((card) => {
                                try {
                                    const id = card.getAttribute('data-recommendationid')
                                        || card.getAttribute('data-review-id')
                                        || '';
                                    const lang = card.getAttribute('data-language')
                                        || 'english';
                                    const ts = parseInt(
                                        card.getAttribute('data-timestamp-created')
                                        || card.getAttribute('data-time')
                                        || '0', 10
                                    );
                                    const votedUp = card.classList.contains('positive')
                                        || card.classList.contains('thumbs_up')
                                        || card.classList.contains('review_positive');
                                    const text = (
                                        card.querySelector(
                                            '.apphub_CardTextContent, '
                                            '.review_content'
                                        )?.innerText || ''
                                    ).trim();
                                    const helpful = parseInt(
                                        card.querySelector(
                                            '.vote_info .thumb_count, '
                                            '.review_helpful_count'
                                        )?.innerText || '0', 10
                                    );
                                    const authorEl = card.querySelector(
                                        '.apphub_CardContentAuthorName a, '
                                        '.review_author a'
                                    );
                                    const steamid = authorEl
                                        ? (authorEl.getAttribute('data-miniprofile')
                                            || authorEl.getAttribute('href')
                                                ?.match(/\\/profiles\\/(\\d+)/)?.[1]
                                            || '')
                                        : '';
                                    out.push({
                                        recommendationid: id,
                                        language: lang,
                                        timestamp_created: ts,
                                        voted_up: votedUp,
                                        review: text,
                                        votes_up: helpful,
                                        author: { steamid: steamid },
                                    });
                                } catch (e) { /* skip */ }
                            });
                            return out;
                        }
                        """
                    )
                    results = dom_reviews or []
                    log(f"DOM extraction found {len(results)} reviews.")

                # De-duplicate by recommendationid and respect max_items
                seen: set[str] = set()
                unique: list[dict] = []
                for rv in results:
                    rid = rv.get("recommendationid")
                    if rid and rid not in seen:
                        seen.add(rid)
                        unique.append(rv)
                results = unique[:max_items]

                browser.close()
        except Exception as exc:
            log(f"Playwright error: {exc}")
            raise

        log(f"Returning {len(results)} unique reviews.")
        return results

    def _fetch_via_playwright_subprocess(
        self,
        app_id: int,
        max_items: int,
        sort: str,
        language: str,
        progress_cb: Optional[Callable[[str], None]],
        start_cursor: str = "*",
        start_fetched: int = 0,
        purchase_type: str = "all",
        playtime_filter_min: int = 0,
        playtime_filter_max: int = 0,
        filter_offtopic_activity: bool = True,
        user_review_filter: str = "0",
        since_timestamp: Optional[int] = None,
    ) -> list[dict]:
        """Run the scraper in a subprocess via the external Python.

        Used when running from a frozen .exe, where playwright is not
        bundled. We hand the actual scraping work to the EXTERNAL
        Python (the one the install helper used) and stream its log
        output back to the GUI in real time.

        Protocol with the helper script:
          * stdin:  JSON object {app_id, max_items, sort, language,
                                 start_cursor, start_fetched,
                                 since_timestamp, ...}
          * stderr: human-readable log lines, each prefixed with "LOG:"
          * stdout: final JSON array of review dicts
          * exit code: 0 on success, non-zero on failure

        For resume, pass the saved `start_cursor` (the cursor of the
        NEXT page after the last completed one) and `start_fetched`
        (how many reviews were already collected). The helper picks
        up at the next page and returns only the new reviews.
        """
        import subprocess
        import tempfile
        import threading

        py = SteamAPI._find_external_python()
        if not py:
            raise RuntimeError(
                "Could not find an external Python interpreter to run the "
                "Playwright scraper. Please install Python 3.10+ and try again."
            )

        def log(msg: str) -> None:
            if progress_cb:
                progress_cb(msg)
            print(f"[Playwright] {msg}")

        if not self.is_playwright_available():
            raise RuntimeError(
                "Playwright is not installed in the external Python. "
                "Click 'Install Playwright' first."
            )

        helper = Path(tempfile.gettempdir()) / f"_srt_pw_scrape_{os.getpid()}.py"
        try:
            helper.write_text(PLAYWRIGHT_SCRAPER_SCRIPT, encoding="utf-8")
        except OSError as exc:
            raise RuntimeError(f"Could not write helper script: {exc}")

        params_json = json.dumps({
            "app_id": app_id,
            "max_items": max_items,
            "sort": sort,
            "language": language,
            "user_agent": self.DEFAULT_UA,
            "start_cursor": start_cursor,
            "start_fetched": start_fetched,
            "purchase_type": purchase_type,
            "playtime_filter_min": int(playtime_filter_min),
            "playtime_filter_max": int(playtime_filter_max),
            "filter_offtopic_activity": (
                "true" if filter_offtopic_activity else "false"
            ),
            "user_review_filter": user_review_filter,
            # "When to include" filter: a UTC unix-seconds lower bound.
            # None means "no time filter" (the helper skips it).
            "since_timestamp": (
                int(since_timestamp) if since_timestamp is not None else None
            ),
        })

        try:
            log(f"Spawning scraper in external Python: {py}")
            process = subprocess.Popen(
                [py, str(helper)],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
            )

            # Feed params via stdin and close it so the child can read.
            try:
                process.stdin.write(params_json)
                process.stdin.close()
            except BrokenPipeError:
                pass  # child may have already exited

            # Drain stdout in a thread (avoids the OS pipe-buffer
            # deadlock that would happen if we only called .read()).
            stdout_holder: list[str] = []
            def drain_stdout() -> None:
                try:
                    stdout_holder.append(process.stdout.read())
                except Exception:
                    pass
            stdout_thread = threading.Thread(target=drain_stdout, daemon=True)
            stdout_thread.start()

            # Drain stderr in a thread and forward "LOG:" lines to the GUI.
            stderr_lines: list[str] = []
            def drain_stderr() -> None:
                try:
                    for line in iter(process.stderr.readline, ""):
                        stderr_lines.append(line)
                        if line.startswith("LOG:"):
                            log(line[4:].rstrip())
                except Exception:
                    pass
            stderr_thread = threading.Thread(target=drain_stderr, daemon=True)
            stderr_thread.start()

            # The GUI can kill this subprocess on Stop. We expose it
            # so the worker can save the last good cursor from the
            # helper's progress file.
            self._pw_subprocess = process

            try:
                rc = process.wait(timeout=900)  # 15 min hard cap
            except subprocess.TimeoutExpired:
                process.kill()
                raise RuntimeError(
                    "Playwright scraper timed out after 15 minutes."
                )

            stdout_thread.join(timeout=5)
            stderr_thread.join(timeout=5)

            if rc != 0:
                stderr_text = "".join(stderr_lines)
                raise RuntimeError(
                    f"Playwright scraper failed (exit {rc}).\n"
                    f"--- helper output ---\n{stderr_text[-1500:]}"
                )

            stdout = stdout_holder[0] if stdout_holder else ""
            if not stdout.strip():
                # Subprocess succeeded but returned nothing.
                return []
            try:
                return json.loads(stdout)
            except json.JSONDecodeError as exc:
                raise RuntimeError(
                    f"Playwright scraper returned invalid JSON: {exc}\n"
                    f"--- output ---\n{stdout[:500]}"
                )
        finally:
            try:
                helper.unlink()
            except OSError:
                pass


# ---------------------------------------------------------------------------
# Markdown exporter
# ---------------------------------------------------------------------------

@dataclass
class ExportContext:
    app_id: int
    app_details: Optional[dict]
    reviews: list[dict]
    language_param: str
    review_filter: str
    review_type: str
    day_range: Optional[int]
    min_date_ts: Optional[int]
    fetched_at: datetime = field(default_factory=lambda: datetime.now(timezone.utc))
    # Optional: user-configured keyword list used to tag and highlight
    # reviews. Set by `App._do_export_to_path` when invoking the
    # exporter so the renderer can use it.
    keyword_list: Optional[list] = None


class MarkdownExporter:
    """Renders a clean, self-contained .md file with game info + all reviews."""

    @staticmethod
    def _to_iso(ts: Optional[int]) -> str:
        if not ts:
            return "—"
        try:
            return datetime.fromtimestamp(int(ts), tz=timezone.utc).strftime(
                "%Y-%m-%d %H:%M:%S UTC"
            )
        except (OverflowError, OSError, ValueError):
            return "—"

    @staticmethod
    def _yesno(b: Optional[bool]) -> str:
        if b is True:
            return "✓"
        if b is False:
            return "✗"
        return "—"

    @staticmethod
    def _md_escape(s: str) -> str:
        if s is None:
            return ""
        # Avoid breaking table layout and code-block markers
        return s.replace("|", "\\|").replace("\r", "")

    @classmethod
    def render(cls, ctx: ExportContext, include_header: bool = True) -> str:
        """Render the review collection as a Markdown document.

        `include_header=False` skips the title, game-info table,
        filters table, and language distribution, emitting only the
        "## All Reviews" section. This is used for split-export
        continuation files (part 2, part 3, …) so the file size
        is dominated by the review data, not by repeated metadata.
        """
        lines: list[str] = []
        app = ctx.app_details or {}
        # Read the user-configured keyword list (set on App._do_export_to_path).
        keyword_list = getattr(ctx, "keyword_list", None)

        if include_header:
            # ---- Title block ---------------------------------------------------
            name = app.get("name") or f"App {ctx.app_id}"
            lines.append(f"# Steam Reviews — {name}")
            lines.append("")
            lines.append(f"*Export generated {ctx.fetched_at.isoformat()}*")
            lines.append("")

            # ---- Pre-AI digest (top-of-file summary for AI ingestion) -------
            # This block is designed to be the FIRST thing an AI sees
            # when handed the .md. It's a compact roll-up: stats, top
            # complaints, top praise, auto-classified types, top
            # reviewers. If a PM only has 30 seconds to skim, this is
            # what they read.
            try:
                digest_md = build_pre_ai_digest(
                    ctx.reviews, app_details=app, keyword_list=keyword_list, top_n=5,
                )
                lines.append(digest_md)
            except Exception:
                pass

        if include_header:
            # ---- Game info table ----------------------------------------------
            lines.append("## Game Information")
            lines.append("")
            lines.append("| Field | Value |")
            lines.append("|---|---|")
            lines.append(f"| App ID | `{ctx.app_id}` |")
            lines.append(f"| Name | {cls._md_escape(name)} |")
            lines.append(f"| Type | {cls._md_escape(app.get('type', '—'))} |")
            lines.append(
                f"| Developer | {cls._md_escape(', '.join(app.get('developers', []) or ['—']))} |"
            )
            lines.append(
                f"| Publisher | {cls._md_escape(', '.join(app.get('publishers', []) or ['—']))} |"
            )
            rel = app.get("release_date", {}) or {}
            lines.append(
                f"| Release | {cls._md_escape(rel.get('date', '—'))} "
                f"({'coming soon' if rel.get('coming_soon') else 'released'}) |"
            )
            platforms = app.get("platforms", {}) or {}
            plat_str = ", ".join(k for k, v in platforms.items() if v) or "—"
            lines.append(f"| Platforms | {cls._md_escape(plat_str)} |")
            lines.append(f"| Store page | https://store.steampowered.com/app/{ctx.app_id}/ |")
            lines.append("")

            # ---- Filter metadata ---------------------------------------------
            lines.append("## Applied Filters")
            lines.append("")
            lines.append("| Parameter | Value |")
            lines.append("|---|---|")
            lines.append(f"| language | `{ctx.language_param}` |")
            lines.append(f"| filter (sort) | `{ctx.review_filter}` |")
            lines.append(f"| review_type | `{ctx.review_type}` |")
            lines.append(f"| day_range | {ctx.day_range if ctx.day_range is not None else 'all time'} |")
            lines.append(
                f"| min_date | {cls._to_iso(ctx.min_date_ts) if ctx.min_date_ts else '—'} |"
            )
            lines.append("")

            # ---- Summary ------------------------------------------------------
            total = len(ctx.reviews)
            pos = sum(1 for r in ctx.reviews if r.get("voted_up"))
            neg = total - pos
            pct = round(100 * pos / total, 1) if total else 0.0
            langs: dict[str, int] = {}
            for r in ctx.reviews:
                langs[r.get("language", "—")] = langs.get(r.get("language", "—"), 0) + 1

            lines.append("## Summary")
            lines.append("")
            lines.append(f"- Total reviews (after filters): **{total}**")
            lines.append(f"- Positive: **{pos}** ({pct}%)")
            lines.append(f"- Negative: **{neg}** ({round(100 - pct, 1)}%)")
            lines.append("")
            if langs:
                lines.append("**Language distribution:**")
                lines.append("")
                lines.append("| Language | Reviews |")
                lines.append("|---|---|")
                for k in sorted(langs, key=langs.get, reverse=True):
                    lines.append(f"| {k} | {langs[k]} |")
                lines.append("")

        # ---- All reviews ---------------------------------------------------
        # The "## All Reviews" heading is always emitted because each
        # split file needs to be self-describing as the All-Reviews
        # section of the export. Only the metadata *above* this heading
        # is suppressed in continuation files.
        lines.append("## All Reviews")
        lines.append("")

        for i, r in enumerate(ctx.reviews, 1):
            author = r.get("author", {}).get("steamid") or "—"
            profile = (
                f"https://steamcommunity.com/profiles/{author}"
                if author != "—" else "—"
            )
            # recommendationid may legitimately be missing for some
            # very old reviews; treat None / "" the same as "—".
            review_id = r.get("recommendationid") or "—"
            review_url = (
                f"https://steamcommunity.com/profiles/{author}/review/{review_id}"
                if author != "—" and review_id != "—" else "—"
            )

            lines.append(f"### Review #{i}")
            lines.append("")
            lines.append("| Field | Value |")
            lines.append("|---|---|")
            # Purchase-type badge: "✅ verified" or "🔑 key" or "—"
            if r.get("steam_purchase"):
                purchase_badge = "✅ verified"
            elif r.get("received_for_free"):
                purchase_badge = "🎁 free"
            elif r.get("steam_purchase") is False:
                purchase_badge = "🔑 key"
            else:
                purchase_badge = "—"
            lines.append(
                f"| Recommendation | "
                f"{'👍 Positive' if r.get('voted_up') else '👎 Negative'} |"
            )
            lines.append(
                f"| Author | `{author}` ([profile]({profile})) |"
            )
            lines.append(
                f"| Review URL | [link]({review_url}) |"
            )
            lines.append(f"| Language | `{r.get('language', '—')}` |")
            lines.append(f"| Posted | {cls._to_iso(r.get('timestamp_created'))} |")
            lines.append(
                f"| Updated | {cls._to_iso(r.get('timestamp_updated'))} |"
            )
            lines.append(
                f"| Played forever? | {cls._yesno(r.get('written_during_early_access'))} |"
            )
            lines.append(f"| Purchase type | {purchase_badge} |")
            lines.append(
                f"| Received for free | {cls._yesno(r.get('received_for_free'))} |"
            )
            playtime = r.get("author", {}).get("playtime_forever", 0) or 0
            lines.append(f"| Playtime (minutes) | {playtime} (~{playtime/60:.1f} h) |")
            lines.append(
                f"| Last played | {cls._to_iso(r.get('author', {}).get('last_played'))} |"
            )
            lines.append(f"| Helpful count | {r.get('votes_up', 0)} |")
            lines.append(f"| Funny count | {r.get('votes_funny', 0)} |")
            lines.append(f"| Comment count | {r.get('comment_count', 0)} |")
            lines.append(
                f"| Review score (dev weight) | {r.get('weighted_vote_score', '—')} |"
            )
            # Auto-classified review type (bug/feature/praise/complaint)
            try:
                rtype = classify_review_type(r)
                if rtype != "other":
                    lines.append(f"| **Auto-type** | **{rtype}** |")
            except Exception:
                pass
            # Issue tags from the user's keyword list (for AI to query)
            try:
                tags = extract_tags(r, keyword_list)
                if tags:
                    tag_line = " ".join(f"`{t}`" for t in tags)
                    lines.append(f"| **Tags** | {tag_line} |")
            except Exception:
                pass
            lines.append("")
            review_text = (r.get("review") or "").strip()
            if review_text:
                lines.append("**Review text:**")
                lines.append("")
                # Highlight keywords: wrap matched keywords in
                # `**...**` (Markdown bold) so the user / AI can spot
                # them at a glance. Multi-word phrases are case-folded
                # for matching but the original casing is preserved.
                # We also match common English stem forms (crash →
                # crashes, crashed, crashing) so the user doesn't
                # have to add every variant.
                highlighted = review_text
                if keyword_list:
                    try:
                        import re as _re
                        # Build a single combined regex of all
                        # keywords (longest-first so 'black screen'
                        # wins over 'screen' inside it). Each token
                        # contributes an alternation with optional
                        # English suffixes.
                        sorted_kw = sorted(
                            (k for k in keyword_list if k.strip()),
                            key=lambda k: -len(k),
                        )
                        if sorted_kw:
                            parts = []
                            for k in sorted_kw:
                                if " " in k:
                                    parts.append(_re.escape(k))
                                else:
                                    parts.append(
                                        _re.escape(k) + r"(?:e?s|e?d|ing)?"
                                    )
                            pat = "|".join(parts)
                            highlighted = _re.sub(
                                rf"(?i)\b({pat})\b",
                                r"**\1**",
                                review_text,
                            )
                    except Exception:
                        highlighted = review_text
                lines.append("> " + highlighted.replace("\n", "\n> "))
            else:
                lines.append("*(no review text)*")
            lines.append("")
            lines.append("---")
            lines.append("")

        # ---- Footer (only in the first file of a split export) ---------
        if include_header:
            lines.append("")
            lines.append("## Notes")
            lines.append("")
            lines.append(
                "- Reviews are fetched from the public Steam Store API "
                "(`/appreviews/<id>?json=1`) using cursor-based pagination."
            )
            lines.append(
                "- The `language=all` parameter asks Steam to return reviews "
                "in all languages, but Steam may still respect your Steam-account "
                "language preferences. For exhaustive results, also export with "
                "each specific language."
            )
            lines.append(
                "- `min_date` is applied client-side (Steam API has no native "
                "`since` parameter)."
            )
            lines.append(
                "- Some reviews are deleted/withdrawn by users after fetching "
                "and will not appear in the live feed."
            )
            lines.append("")

            # ---- Top 5 reviewers (for follow-up / beta outreach) ----
            try:
                reviewers = []
                for r in ctx.reviews:
                    a = r.get("author", {}) or {}
                    pt = int(a.get("playtime_forever", 0) or 0) / 60.0
                    steamid = str(a.get("steamid", ""))
                    if steamid:
                        reviewers.append(
                            (pt, steamid, str(r.get("recommendationid", "")),
                             a.get("playtime_at_review", 0))
                        )
                reviewers.sort(key=lambda x: -x[0])
                if reviewers:
                    lines.append("## Top 5 reviewers by playtime (for follow-up)")
                    lines.append("")
                    lines.append("| Hours | SteamID | Recommendation | Profile |")
                    lines.append("|---|---|---|---|")
                    for pt, steamid, rid, _ in reviewers[:5]:
                        url = f"https://steamcommunity.com/profiles/{steamid}"
                        rev = f"https://steamcommunity.com/profiles/{steamid}/review/{rid}"
                        lines.append(
                            f"| {pt:.1f} | `{steamid}` | "
                            f"[link]({rev}) | [open]({url}) |"
                        )
                    lines.append("")
            except Exception:
                pass

            # ---- Quick stats footer (one-line summary) ----
            try:
                stats = quick_stats_footer(ctx.reviews)
                if stats:
                    lines.append("---")
                    lines.append("")
                    lines.append(stats)
                    lines.append("")
            except Exception:
                pass

        return "\n".join(lines)

    @staticmethod
    def group_by_language(reviews: list[dict]) -> dict:
        """Return {lang_code: [review, ...]} for the given reviews."""
        out: dict = {}
        for r in reviews:
            lang = (r.get("language") or "unknown").strip() or "unknown"
            out.setdefault(lang, []).append(r)
        return out

    @staticmethod
    def write_per_language(
        reviews: list[dict],
        base_path_no_ext: str,
        export_ctx,
    ) -> int:
        """If reviews span more than one language, write one extra
        `.md` per language to ``base_path_no_ext.<lang>.md`` (in
        addition to the single combined export at base_path_no_ext.md).
        Returns the number of extra files written.
        """
        groups = MarkdownExporter.group_by_language(reviews)
        if len(groups) <= 1:
            return 0
        n = 0
        for lang, lang_reviews in groups.items():
            # Sanitize the language code for the filename
            safe_lang = "".join(
                c if c.isalnum() or c in "-_." else "_" for c in lang
            ) or "unknown"
            per_path = f"{base_path_no_ext}.{safe_lang}.md"
            ctx = ExportContext(**{**export_ctx.__dict__, "reviews": lang_reviews})
            try:
                md = MarkdownExporter.render(ctx, include_header=True)
                with open(per_path, "w", encoding="utf-8") as f:
                    f.write(md)
                n += 1
            except OSError:
                pass
        return n

    @staticmethod
    def reviews_to_csv(reviews: list[dict], dest_path: str) -> int:
        """Write the reviews to a CSV file. Returns the number of rows.

        Columns: recommendationid, language, voted_up, votes_up, votes_funny,
        comment_count, author_steamid, author_playtime_min, author_last_played,
        timestamp_created, timestamp_updated, weighted_vote_score, steam_purchase,
        received_for_free, written_during_early_access, review_text.
        The review text is quoted and newlines are replaced with spaces.
        """
        import csv
        with open(dest_path, "w", newline="", encoding="utf-8") as f:
            w = csv.writer(f)
            w.writerow([
                "recommendationid", "language", "voted_up", "votes_up",
                "votes_funny", "comment_count", "author_steamid",
                "author_playtime_min", "author_last_played",
                "timestamp_created", "timestamp_updated", "weighted_vote_score",
                "steam_purchase", "received_for_free", "written_during_early_access",
                "review_text",
            ])
            for r in reviews:
                author = r.get("author", {}) or {}
                w.writerow([
                    str(r.get("recommendationid", "")),
                    str(r.get("language", "")),
                    int(bool(r.get("voted_up"))),
                    int(r.get("votes_up", 0) or 0),
                    int(r.get("votes_funny", 0) or 0),
                    int(r.get("comment_count", 0) or 0),
                    str(author.get("steamid", "")),
                    int(author.get("playtime_forever", 0) or 0),
                    int(author.get("last_played", 0) or 0),
                    int(r.get("timestamp_created", 0) or 0),
                    int(r.get("timestamp_updated", 0) or 0),
                    str(r.get("weighted_vote_score", "")),
                    int(bool(r.get("steam_purchase"))),
                    int(bool(r.get("received_for_free"))),
                    int(bool(r.get("written_during_early_access"))),
                    (r.get("review") or "").replace("\n", " ").replace("\r", " "),
                ])
        return len(reviews)

    @staticmethod
    def reviews_to_json(reviews: list[dict], dest_path: str) -> int:
        """Write the reviews to a pretty JSON file."""
        with open(dest_path, "w", encoding="utf-8") as f:
            json.dump(reviews, f, indent=2, ensure_ascii=False)
        return len(reviews)

    @staticmethod
    def build_summary(reviews: list[dict], app_details: Optional[dict] = None) -> str:
        """Return a Markdown summary of the reviews.

        Includes: total count, positive/negative split, top 10
        most-helpful reviewers (by playtime), language distribution,
        purchase-type split, and word-frequency top-20 from review text.
        """
        total = len(reviews)
        if total == 0:
            return "# Reviewer stats summary\n\n_No reviews._\n"

        pos = sum(1 for r in reviews if r.get("voted_up"))
        neg = total - pos
        pct = round(100 * pos / total, 1) if total else 0.0

        # Language distribution
        langs: dict[str, int] = {}
        for r in reviews:
            langs[r.get("language", "—")] = langs.get(r.get("language", "—"), 0) + 1

        # Purchase type
        purchases = {"steam": 0, "non_steam": 0, "unknown": 0}
        for r in reviews:
            if r.get("steam_purchase") is True:
                purchases["steam"] += 1
            elif r.get("steam_purchase") is False:
                purchases["non_steam"] += 1
            else:
                purchases["unknown"] += 1

        # Top reviewers by playtime_forever
        reviewers: list[tuple[str, int, int, str]] = []
        for r in reviews:
            author = r.get("author", {}) or {}
            rid = str(r.get("recommendationid", "—"))
            steamid = str(author.get("steamid", "—"))
            pt = int(author.get("playtime_forever", 0) or 0)
            text = (r.get("review") or "").strip().replace("\n", " ")
            reviewers.append((steamid, pt, rid, text))
        reviewers.sort(key=lambda x: x[1], reverse=True)
        top10 = reviewers[:10]

        # Word frequency (rough but useful)
        import re as _re
        words: dict[str, int] = {}
        stop = set("the and a an is of to in for on with this that it as at by be or are was not have from but".split())
        for r in reviews:
            text = (r.get("review") or "").lower()
            for w in _re.findall(r"[a-zäöüß]{3,}", text):
                if w in stop:
                    continue
                words[w] = words.get(w, 0) + 1
        top_words = sorted(words.items(), key=lambda kv: kv[1], reverse=True)[:20]

        lines: list[str] = []
        name = (app_details or {}).get("name") if app_details else None
        lines.append("# Reviewer stats summary")
        if name:
            lines.append(f"\n**{name}**")
        lines.append("")
        lines.append("## Totals")
        lines.append("")
        lines.append(f"- **Total reviews**: {total}")
        lines.append(f"- **Positive**: {pos} ({pct}%)")
        lines.append(f"- **Negative**: {neg} ({round(100 - pct, 1)}%)")
        lines.append("")

        lines.append("## Language distribution")
        lines.append("")
        lines.append("| Language | Reviews |")
        lines.append("|---|---|")
        for k in sorted(langs, key=langs.get, reverse=True):
            lines.append(f"| {k} | {langs[k]} |")
        lines.append("")

        lines.append("## Purchase type")
        lines.append("")
        lines.append("| Type | Reviews |")
        lines.append("|---|---|")
        for k, v in purchases.items():
            lines.append(f"| {k} | {v} |")
        lines.append("")

        lines.append("## Top 10 most-active reviewers (by playtime)")
        lines.append("")
        lines.append("| SteamID | Hours | Recommendation | Preview |")
        lines.append("|---|---|---|---|")
        for steamid, pt, rid, text in top10:
            preview = text[:80] + ("…" if len(text) > 80 else "")
            lines.append(f"| `{steamid}` | {pt/60:.1f} | [link](https://steamcommunity.com/profiles/{steamid}/review/{rid}) | {preview} |")
        lines.append("")

        if top_words:
            lines.append("## Top 20 words in review text")
            lines.append("")
            lines.append("| Word | Count |")
            lines.append("|---|---|")
            for w, c in top_words:
                lines.append(f"| {w} | {c} |")
            lines.append("")

        return "\n".join(lines)


# ---------------------------------------------------------------------------
# UI helpers
# ---------------------------------------------------------------------------


class ToolTip:
    """Lightweight hover-tooltip for CustomTkinter widgets.

    Usage:
        ToolTip(my_button, "Click to fetch reviews")

    Why not just use tkinter's `tooltip` package? Adding a dependency
    for one tooltip would be silly. This implementation has no
    external deps, supports wrapping (multi-line text), and uses
    after() so it doesn't block the UI thread.
    """

    def __init__(self, widget, text: str, delay_ms: int = 400) -> None:
        self.widget = widget
        self.text = text
        self.delay_ms = delay_ms
        self._after_id: Optional[str] = None
        self._tip_window: Optional["ctk.CTkToplevel"] = None
        widget.bind("<Enter>", self._schedule, add="+")
        widget.bind("<Leave>", self._cancel, add="+")
        widget.bind("<ButtonPress>", self._cancel, add="+")

    def _schedule(self, _event=None) -> None:
        self._cancel()
        self._after_id = self.widget.after(self.delay_ms, self._show)

    def _cancel(self, _event=None) -> None:
        if self._after_id is not None:
            try:
                self.widget.after_cancel(self._after_id)
            except Exception:
                pass
            self._after_id = None
        if self._tip_window is not None:
            try:
                self._tip_window.destroy()
            except Exception:
                pass
            self._tip_window = None

    def _show(self) -> None:
        if self._tip_window is not None:
            return
        try:
            x = self.widget.winfo_rootx() + 20
            y = self.widget.winfo_rooty() + self.widget.winfo_height() + 6
        except Exception:
            return
        self._tip_window = ctk.CTkToplevel(self.widget)
        self._tip_window.wm_overrideredirect(True)
        self._tip_window.wm_geometry(f"+{x}+{y}")
        self._tip_window.configure(fg_color=("#1f1f1f", "#1f1f1f"))
        label = ctk.CTkLabel(
            self._tip_window,
            text=self.text,
            text_color=("#eaeaea", "#eaeaea"),
            fg_color=("#1f1f1f", "#1f1f1f"),
            justify="left",
            padx=8,
            pady=6,
            corner_radius=4,
            font=("", 11),
            wraplength=320,
        )
        label.pack()
        # Auto-destroy after 8s so a stuck tooltip never lingers.
        self._tip_window.after(8000, self._cancel)


# ---------------------------------------------------------------------------
# UI
# ---------------------------------------------------------------------------

class App(ctk.CTk):
    def __init__(self) -> None:
        super().__init__()

        ctk.set_appearance_mode("dark")
        ctk.set_default_color_theme("blue")

        self.title("Steam Review Analyzer")
        # Larger default so all controls (filters, action buttons,
        # split-export, open-store, log) fit comfortably without
        # scrollbars. minsize=1000x780 keeps everything reachable on
        # a 1080p display.
        self.geometry("1180x880")
        self.minsize(1000, 780)

        self.api = SteamAPI()
        self.app_id: Optional[int] = None
        self.app_details: Optional[dict] = None
        self.reviews: list[dict] = []
        self._stop_event = threading.Event()
        self._worker: Optional[threading.Thread] = None

        # Watch-mode state
        self._watch_thread: Optional[threading.Thread] = None
        self._watch_stop_event = threading.Event()
        self._watch_new_reviews: list[dict] = []
        self._watch_session_count: int = 0
        self.watching: bool = False

        # Playwright-tab state
        self.pw_reviews: list[dict] = []
        self._pw_thread: Optional[threading.Thread] = None
        self._pw_stop_event = threading.Event()
        self.pw_installing_pkg: bool = False
        self.pw_installing_chrome: bool = False

        # Dedup state: which tab's "Fetch new" was last triggered.
        self._fetch_new_tab: Optional[str] = None
        # The dump-folder path; populated from settings or DEFAULT_DUMP_ROOT.
        self.dump_root_var: "ctk.StringVar" = None  # set by build UI
        # Last-seen review IDs (for "new since last visit" badge).
        self._last_visit_seen_ids: set = set()
        # Tagging + prompt text widgets. They're created lazily when
        # the Settings dialog is opened, so we just keep None here.
        self.keywords_text = None
        self.ai_prompt_text = None

        self._build_ui()

        # Apply persisted settings (after widgets exist) and wire close handler
        try:
            self._settings_apply(self._settings_load())
        except Exception as e:
            print(f"[Settings] initial apply failed: {e}")
        try:
            self.protocol("WM_DELETE_WINDOW", self._on_close)
        except Exception:
            pass

        # Check Playwright availability in the background so the UI is responsive
        threading.Thread(target=self._refresh_dep_status, daemon=True).start()

        # Set initial state of the Resume buttons (both disabled until
        # a game is loaded or a previous scrape's state is restored).
        self.after(100, self._refresh_resume_buttons)

        # Start the live "current German time" clock (1 Hz tick). It
        # updates the label in each tab's "When to include" section.
        self.after(1000, self._tick_clock)

    # ------------------------------------------------------------------ UI

    def _build_ui(self) -> None:
        # ============ Tabview =============================================
        self.tabview = ctk.CTkTabview(self)
        self.tabview.pack(fill="both", expand=True, padx=8, pady=8)
        self.tab_api = self.tabview.add("Steam API (cached)")
        self.tab_playwright = self.tabview.add("Playwright (real-time)")
        self.tab_trends = self.tabview.add("📈 Trends")

        # ---------------------------------------------------------------
        # Tab 1: existing Steam API functionality
        # ---------------------------------------------------------------
        self._build_tab_api(self.tab_api)

        # ---------------------------------------------------------------
        # Tab 2: Playwright browser scraper
        # ---------------------------------------------------------------
        self._build_tab_playwright(self.tab_playwright)

        # ---------------------------------------------------------------
        # Tab 3: Trends tracker
        # ---------------------------------------------------------------
        self._build_tab_trends(self.tab_trends)

    def _reorganize_tab(self, tab, info_panel: "InfoPanel") -> None:
        """Post-build step: take all children of `tab`, put the InfoPanel
        at the top, and wrap everything else in a CTkScrollableFrame
        so the tab content scrolls if it overflows.
        """
        # Step 1: pack InfoPanel at the top of the tab
        info_panel.frame.pack(side="top", fill="x", padx=8, pady=(8, 4))
        # Step 2: create a scrollable frame for the rest
        scroll = ctk.CTkScrollableFrame(
            tab, fg_color="transparent",
        )
        scroll.pack(fill="both", expand=True, padx=8, pady=(0, 8))
        # Step 3: re-pack every existing child of tab into scroll, in
        # the same order they were originally packed.
        children = list(tab.winfo_children())
        for child in children:
            # Skip the InfoPanel and the scroll frame itself
            if child is info_panel.frame or child is scroll:
                continue
            # Capture the current pack info
            try:
                info = child.pack_info()
            except Exception:
                # Widget wasn't packed — skip.
                continue
            opts = dict(info) if info else {}
            # Detach by forgetting
            try:
                child.pack_forget()
            except Exception:
                pass
            # Re-pack into scroll, preserving the original options but
            # removing `in_` (which we'll re-apply via `in_=scroll`).
            opts.pop("in_", None)
            # Drop `side="top"` if it was used, since we want a
            # normal top-to-bottom flow inside the scroll.
            opts.setdefault("fill", "x")
            try:
                child.pack(in_=scroll, **opts)
            except Exception:
                # Fall back to a simple pack
                try:
                    child.pack(in_=scroll, fill="x", padx=2, pady=2)
                except Exception:
                    pass
        return scroll

    def _tick_info_clock(self) -> None:
        """Refresh the Berlin clock in both info panels every second."""
        from datetime import datetime
        try:
            # Berlin (CET/CEST)
            try:
                from zoneinfo import ZoneInfo
                tz = ZoneInfo("Europe/Berlin")
                now = datetime.now(tz).strftime("%Y-%m-%d %H:%M:%S %Z")
            except Exception:
                now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            for panel in (
                getattr(self, "_api_info_panel", None),
                getattr(self, "_pw_info_panel", None),
            ):
                if panel is not None:
                    panel.set_clock(now)
        except Exception:
            pass
        try:
            self.after(1000, self._tick_info_clock)
        except Exception:
            pass

    def _update_info_panels(self) -> None:
        """Refresh both info panels with the current game state."""
        # New-since-last-visit badge logic
        try:
            seen = self._load_seen_ids()
            new_count = 0
            for sid in seen:
                if sid not in self._last_visit_seen_ids:
                    new_count += 1
            self._last_visit_seen_ids = set(seen)
        except Exception:
            new_count = 0
        # Exported count = size of seen set
        try:
            exported = len(self._load_seen_ids())
        except Exception:
            exported = 0
        # Game info
        name = (self.app_details or {}).get("name") if self.app_details else None
        app_id = self.app_id
        dump_folder = None
        try:
            dump_folder = str(self._get_dump_root())
        except Exception:
            pass
        for panel in (
            getattr(self, "_api_info_panel", None),
            getattr(self, "_pw_info_panel", None),
        ):
            if panel is None:
                continue
            try:
                panel.update(
                    app_id=app_id,
                    game_name=name,
                    dump_folder=dump_folder,
                    exported_count=exported,
                    new_visit_count=new_count,
                )
            except Exception:
                pass

    def _build_tab_api(self, parent) -> None:
        """Build the Steam API (cached) tab.

        Layout philosophy:
          - One clearly labelled section per concern (Game, Filters,
            Backend, Action, Progress, Log).
          - The Filters section uses a 4-column grid so every control
            has a label-and-widget pair with predictable spacing, even
            on a 1000-px window.
          - The Action bar is a single horizontal row of buttons sized
            so the entire bar fits on screen at the default 1180×880
            window size.
          - Every interactive control gets a tooltip explaining what
            it does and what value is expected.
        """
        pad = {"padx": 10, "pady": 6}

        # ============ Game input ==========================================
        sec_game = self._make_section(parent, "Game")
        row = ctk.CTkFrame(sec_game, fg_color="transparent")
        row.pack(fill="x", padx=8, pady=(4, 8))
        ctk.CTkLabel(
            row, text="App ID / store URL:", width=140, anchor="w"
        ).pack(side="left", padx=(4, 6))
        self.input_entry = ctk.CTkEntry(
            row, placeholder_text=(
                "e.g. 4311090  or  "
                "https://store.steampowered.com/app/4311090/Bus_Simulator_27_Demo/"
            ),
        )
        self.input_entry.pack(side="left", padx=4, fill="x", expand=True)
        self.input_entry.bind("<Return>", lambda _e: self._on_load())
        ToolTip(
            self.input_entry,
            "Steam App ID or any store / steamcommunity URL.\n"
            "Enter the App ID only for fastest loading.",
        )
        self.load_btn = ctk.CTkButton(
            row, text="Load Game  ⏎", command=self._on_load, width=140
        )
        self.load_btn.pack(side="left", padx=4)
        ToolTip(self.load_btn, "Fetch the game's metadata from Steam.\nKeyboard: Enter.")

        # ============ Game details ========================================
        # The InfoPanel at the top of the tab already shows the game
        # name + dump folder + exported count. The Game section here
        # is just the App ID input + Load button.
        det = ctk.CTkFrame(sec_game, fg_color="transparent")
        det.pack(fill="x", padx=8, pady=(0, 6))
        # Hidden: redundant with the InfoPanel above. We still keep
        # the widget objects so existing _on_load() / _refresh_dump_label()
        # calls don't break — their configure() calls become no-ops
        # visually but the data is also pushed to the InfoPanel via
        # _update_info_panels().
        self.details_title = ctk.CTkLabel(
            det, text="", font=("", 16, "bold"), anchor="w"
        )
        self.details_meta = ctk.CTkLabel(det, text="", anchor="w", justify="left")
        self.new_visit_badge = ctk.CTkLabel(
            det, text="", anchor="w", text_color="#5dade6",
            font=("", 11, "bold"),
        )

        # ============ Dump folder + dedup status ===========================
        # Shown on the API tab so the user always knows where the
        # .md files are going and how many reviews have already been
        # exported for this game. Wrapped in a CollapsibleGroup
        # (collapsed by default — the InfoPanel already shows the
        # values; this group is for direct folder control).
        self.dump_folder_label = ctk.CTkLabel(
            sec_game, text="📂 Dump folder: …", anchor="w",
            text_color="gray",
        )
        self.seen_count_label = ctk.CTkLabel(
            sec_game, text="Already exported: 0 reviews", anchor="e",
            text_color="gray",
        )
        # Obsidian-vault secondary copy
        self.obsidian_vault_var = ctk.StringVar(value="")
        self.obsidian_label = ctk.CTkLabel(
            sec_game, text="(not set)", anchor="w", text_color="gray",
        )
        # Build the dump-folder CollapsibleGroup
        self._df_group = CollapsibleGroup(
            sec_game, "Dump folder & Vault", expanded=False, icon="📂",
        )
        self._df_group.outer.pack(fill="x", padx=4, pady=(2, 4))
        # Row 1: dump folder + buttons
        df_inner1 = ctk.CTkFrame(self._df_group.body, fg_color="transparent")
        df_inner1.pack(fill="x", padx=4, pady=2)
        self.dump_folder_label.pack(in_=df_inner1, side="left", padx=4, fill="x", expand=True)
        self.seen_count_label.pack(in_=df_inner1, side="right", padx=4)
        ctk.CTkButton(
            df_inner1, text="📁 Set…", width=80, height=24,
            command=self._on_pick_dump_root,
        ).pack(side="right", padx=2)
        ctk.CTkButton(
            df_inner1, text="📂 Open", width=80, height=24,
            command=self._on_open_dump_folder,
        ).pack(side="right", padx=2)
        ctk.CTkButton(
            df_inner1, text="🎮 Open game", width=110, height=24,
            command=self._on_open_game_folder,
        ).pack(side="right", padx=2)
        ToolTip(self.dump_folder_label,
                "All exports are saved under this folder,\n"
                "in a per-game subfolder named '<app_id>_<game>'.")
        ToolTip(self.seen_count_label,
                "Number of reviews already exported for this game\n"
                "(from the per-game seen_ids.json).")
        # Row 2: vault path + buttons
        df_inner2 = ctk.CTkFrame(self._df_group.body, fg_color="transparent")
        df_inner2.pack(fill="x", padx=4, pady=2)
        ctk.CTkLabel(df_inner2, text="📓 Vault:", width=80, anchor="e").pack(
            side="left", padx=(0, 4)
        )
        self.obsidian_label.pack(in_=df_inner2, side="left", padx=4, fill="x", expand=True)
        ctk.CTkButton(
            df_inner2, text="📓 Set…", width=80, height=24,
            command=self._on_pick_obsidian_vault,
        ).pack(side="right", padx=2)
        ctk.CTkButton(
            df_inner2, text="🧹 Clear", width=70, height=24,
            command=self._on_clear_obsidian_vault,
        ).pack(side="right", padx=2)
        ToolTip(self.obsidian_label,
                "If set, every .md export is ALSO copied to this\n"
                "folder (e.g. your Obsidian vault's Reviews subfolder).\n"
                "Leave unset to disable.")
        # Initialise the dump-folder StringVar and refresh labels.
        self.dump_root_var = ctk.StringVar(value="")
        self._refresh_dump_label()

        # ============ Tab explanation card ===============================
        # "When to use this tab" hint so the user picks the right
        # backend for their use case. Wrapped in a CollapsibleGroup
        # (collapsed by default — it's a hint, not a daily-use widget).
        self._explain_group = CollapsibleGroup(
            sec_game, "When to use this tab", expanded=False, icon="📌",
        )
        self._explain_group.outer.pack(fill="x", padx=4, pady=(4, 4))
        explain = ctk.CTkLabel(
            self._explain_group.body,
            text=(
                "📌 When to use this tab:\n"
                "• The Steam JSON API is the FASTEST and CHEAPEST way to dump\n"
                "  reviews for established games (cache miss delay ~0 h).\n"
                "• Use it for established games where Steam's review cache\n"
                "  is already up to date.\n"
                "• For NEW games (released in the last 24-72 h) switch to the\n"
                "  Playwright tab — it bypasses the cache."
            ),
            anchor="w", justify="left",
            text_color=("#1f6aa5", "#5da9d6"),
            fg_color=("#eef5fb", "#1e2a35"),
            corner_radius=6,
        )
        explain.pack(fill="x", padx=4, pady=4)
        ToolTip(explain,
                "Quick guide: API tab for established games,\n"
                "Playwright tab for new releases. The two tabs\n"
                "share the same export / dedup / seen-IDs system.")

        # ============ Filters =============================================
        # The reset button is created with `parent` as its master but
        # _make_section will re-pack it into the section header.
        self._api_reset_btn = ctk.CTkButton(
            parent, text="Reset filters", width=110, height=26,
            command=self._reset_api_filters,
        )
        ToolTip(self._api_reset_btn, "Reset all filters in this section to defaults.")
        sec_filt = self._make_section(parent, "Filters", right_widget=self._api_reset_btn)
        # Wrap the filter widgets in a CollapsibleGroup so the user
        # can collapse the whole filter section. The filter widgets
        # use pack (one horizontal row per logical row) so they fit
        # cleanly inside the group's pack-managed body.
        self._filt_group = CollapsibleGroup(
            sec_filt, "Filter options", expanded=True, icon="🔍",
        )
        self._filt_group.outer.pack(fill="x", padx=2, pady=(2, 2))
        filter_parent = self._filt_group.body

        # Local pack-based helpers (replaces the old grid-based
        # flabel / fwidget). Each "row" is a small frame that the
        # caller creates, then adds label+widget pairs into with
        # side="left".
        def make_row() -> "ctk.CTkFrame":
            row = ctk.CTkFrame(filter_parent, fg_color="transparent")
            row.pack(fill="x", padx=4, pady=2)
            return row

        def add_label(parent, text, width=130, tip=None):
            l = ctk.CTkLabel(parent, text=text, anchor="e", width=width)
            l.pack(side="left", padx=(10, 4), pady=5)
            if tip:
                ToolTip(l, tip)
            return l

        def add_widget(parent, widget, tip=None):
            widget.pack(side="left", padx=4, pady=5)
            if tip:
                ToolTip(widget, tip)
            return widget

        # Row 0: Language (wide — fills its own row)
        r0 = make_row()
        add_label(r0, "Language:",
                  tip="Restrict reviews to one language.\n"
                      "'all' returns every available language.")
        self.lang_var = ctk.StringVar(value="all")
        lang_menu = ctk.CTkOptionMenu(
            r0, values=STEAM_LANGUAGES, variable=self.lang_var, width=240,
        )
        add_widget(r0, lang_menu, tip="Pick a single language code or 'all'.")

        # Row 1: Sort by | Sentiment
        r1 = make_row()
        add_label(r1, "Sort by:",
                  tip="How to sort the reviews on Steam's side.\n"
                      "'recent' = newest first, 'updated' = recently bumped,\n"
                      "'all' = Steam's default ranking.")
        self.filter_var = ctk.StringVar(value="recent")
        add_widget(r1, ctk.CTkOptionMenu(
            r1, values=REVIEW_FILTERS, variable=self.filter_var, width=140,
        ), tip="recent / updated / all")
        add_label(r1, "Sentiment:")
        self.type_var = ctk.StringVar(value="all")
        add_widget(r1, ctk.CTkOptionMenu(
            r1, values=REVIEW_TYPES, variable=self.type_var, width=140,
        ), tip="all / positive / negative")

        # Row 2: Purchase type | Min playtime
        r2 = make_row()
        add_label(r2, "Purchase type:",
                  tip="Where the reviewer bought the game.\n"
                      "  all      — any reviewer\n"
                      "  steam    — only Steam-store purchases\n"
                      "  non_steam — only key / external activations")
        self.purchase_var = ctk.StringVar(value="all")
        add_widget(r2, ctk.CTkOptionMenu(
            r2, values=["all", "steam", "non_steam"],
            variable=self.purchase_var, width=140,
        ), tip="Filter by purchase source")
        add_label(r2, "Min playtime (hrs):",
                  tip="Only keep reviews from players who have at least\n"
                      "this many hours in-game. Blank = no limit.")
        self.playtime_min_entry = ctk.CTkEntry(
            r2, width=140, placeholder_text="blank = none",
        )
        add_widget(r2, self.playtime_min_entry,
                   tip="Lower bound on reviewer playtime (in hours)")

        # Row 3: Min helpful | Include off-topic
        r3 = make_row()
        add_label(r3, "Min helpful votes:",
                  tip="Only keep reviews with at least this many\n"
                      "'helpful' votes from other users.")
        self.helpful_entry = ctk.CTkEntry(
            r3, width=140, placeholder_text="0",
        )
        add_widget(r3, self.helpful_entry,
                   tip="Quality threshold for exported reviews")
        add_label(r3, "Include off-topic:",
                  tip="Steam normally hides reviews flagged as off-topic\n"
                      "(memes, /test/, ASCII art, etc.). Toggle to include them.")
        self.offtopic_var = ctk.StringVar(value="false")
        add_widget(r3, ctk.CTkOptionMenu(
            r3, values=["false", "true"],
            variable=self.offtopic_var, width=140,
        ), tip="false = filter out off-topic reviews  |  true = keep them")

        # Row 4: Reviews per page | Watch interval
        r4 = make_row()
        add_label(r4, "Reviews per page:",
                  tip="How many reviews to request per HTTP call.\n"
                      "Higher = fewer requests, but each response is bigger.")
        self.perpage_var = ctk.StringVar(value="100")
        add_widget(r4, ctk.CTkOptionMenu(
            r4, values=["20", "50", "100"], variable=self.perpage_var, width=140,
        ), tip="Steam caps this at 100")
        add_label(r4, "Watch interval (min):",
                  tip="For watch mode: how often to poll Steam for new reviews.")
        self.interval_var = ctk.StringVar(value="5")
        add_widget(r4, ctk.CTkOptionMenu(
            r4, values=["1", "2", "5", "10", "15", "30", "60"],
            variable=self.interval_var, width=140,
        ), tip="Polling cadence in minutes")

        # Row 5: Window (first 24h vs rest)
        r5 = make_row()
        add_label(r5, "Window:",
                  tip="How much of the dump to keep:\n"
                      "  • all – every review\n"
                      "  • first 24h – only reviews posted within 24 h of the earliest one\n"
                      "  • last 7d – only reviews posted in the last 7 days")
        self.first_24h_var = ctk.StringVar(value="all")
        add_widget(r5, ctk.CTkOptionMenu(
            r5, values=["all", "first 24h", "last 7d"],
            variable=self.first_24h_var, width=140,
        ), tip="all | first 24h | last 7d")
        # Keep a reference for any external code that might reference
        # the row frame (e.g. a tooltip on the whole row).
        self._first_24h_row_frame = r5

        # The obsolete entry widgets for the removed "day_range" /
        # "min_date" rows. We keep them as no-op attributes so the
        # settings load/save code (and the reset helper) don't crash
        # on a settings.json written by an older build. We don't pack
        # them — they're not part of the UI anymore.
        self.day_entry = ctk.CTkEntry(filter_parent, width=140)
        self.date_entry = ctk.CTkEntry(filter_parent, width=140)

        # ============ When to include (German time reference) ===========
        # NOTE: the legacy "Max age (days)" and "Min date" filters
        # have been removed in favor of this more expressive section.
        sec_when = self._make_section(parent, "When to include (German time)")
        self._build_since_section(
            sec_when,
            preset_attr="since_preset_var",
            date_attr="since_date_entry",
            time_attr="since_time_entry",
            since_label_attr="since_label",
            status_attr="berlin_clock_label",
            log_fn=self._log,
            preset_change_fn_name="_on_since_preset_change",
        )
        # Initialise the live clock labels
        self._refresh_clock_label()

        # ============ Backend ==============================================
        sec_be = self._make_section(parent, "Backend (optional override)")
        brow = ctk.CTkFrame(sec_be, fg_color="transparent")
        brow.pack(fill="x", padx=8, pady=(4, 6))
        engine_label = ctk.CTkLabel(brow, text="Engine:", width=130, anchor="e")
        engine_label.pack(side="left", padx=(10, 4))
        ToolTip(engine_label,
                 "Steam API = free, but has a 24-72 h cache lag for new apps.\n"
                 "Apify = paid (~1 USD / 1000 reviews), bypasses the cache.")
        self.backend_var = ctk.StringVar(value="Steam API")
        engine_menu = ctk.CTkOptionMenu(
            brow, values=["Steam API", "Apify (bypasses cache)"],
            variable=self.backend_var, width=220,
        )
        engine_menu.pack(side="left", padx=4)
        ToolTip(engine_menu, "Steam API or Apify. Apify needs a token.")
        token_label = ctk.CTkLabel(brow, text="Apify token:", width=90, anchor="e")
        token_label.pack(side="left", padx=(20, 4))
        self.apify_entry = ctk.CTkEntry(
            brow, width=300,
            placeholder_text="apify_api_xxx… (only used with Apify)",
        )
        self.apify_entry.pack(side="left", padx=4, fill="x", expand=True)
        ToolTip(self.apify_entry,
                "Get a free token at https://console.apify.com/account/integrations")

        # ============ Action bar ===========================================
        # Three groups: left = primary actions, middle = watching,
        # right = export / store link.
        sec_act = ctk.CTkFrame(parent, fg_color="transparent")
        sec_act.pack(fill="x", **pad)

        # Primary group
        self.fetch_btn = ctk.CTkButton(
            sec_act, text="Fetch Reviews", command=self._on_fetch, width=150,
            fg_color="#1f6aa5", hover_color="#174f7d",
        )
        self.fetch_btn.pack(side="left", padx=(4, 4), pady=8)
        ToolTip(self.fetch_btn, "Start a full paginated fetch with the filters above.\n"
                              "Keyboard: Ctrl+F")

        self.api_resume_btn = ctk.CTkButton(
            sec_act, text="▶ Resume", command=self._on_api_resume, width=130,
            fg_color="#2d7a2d", hover_color="#1f5a1f",
        )
        self.api_resume_btn.pack(side="left", padx=4, pady=8)
        self.api_resume_btn.configure(state="disabled")
        ToolTip(self.api_resume_btn, "Continue a previously stopped fetch from\n"
                                    "where you left off. Enabled when a saved\n"
                                    "cursor exists for this app.")

        # "🆕 Fetch new" — fetch + dedup + auto-export in one go.
        self.api_fetch_new_btn = ctk.CTkButton(
            sec_act, text="🆕 Fetch new", command=lambda: self._on_fetch_new("api"),
            width=130, fg_color="#0f7a3a", hover_color="#0a5a2a",
        )
        self.api_fetch_new_btn.pack(side="left", padx=4, pady=8)
        self.api_fetch_new_btn.configure(state="disabled")
        ToolTip(self.api_fetch_new_btn,
                "Fetch with the current filters, drop any review\n"
                "already exported for this game, and write a new\n"
                ".md to the per-game dump folder. The seen-IDs\n"
                "list is updated automatically.")

        self.stop_btn = ctk.CTkButton(
            sec_act, text="■ Stop", command=self._on_stop, width=90,
            fg_color="#a83232", hover_color="#822525",
        )
        self.stop_btn.pack(side="left", padx=4, pady=8)
        self.stop_btn.configure(state="disabled")
        ToolTip(self.stop_btn, "Stop the current fetch / scrape.\n"
                              "Keyboard: Ctrl+S")

        # Watch group
        self.watch_btn = ctk.CTkButton(
            sec_act, text="▶ Start Watching", command=self._on_watch_toggle,
            width=170, fg_color="#8a5a00", hover_color="#6e4900",
        )
        self.watch_btn.pack(side="left", padx=(20, 4), pady=8)
        self.watch_btn.configure(state="disabled")
        ToolTip(self.watch_btn, "Poll Steam periodically for new reviews.\n"
                              "Use the Watch interval filter to control cadence.")

        # "Auto-incremental" checkbox: when ON, the watch only ever
        # reports TRULY new reviews and writes a fresh .md per batch.
        self.auto_incremental_watch_var = ctk.StringVar(value="0")
        ctk.CTkCheckBox(
            sec_act, text="🔁 Auto-incr", variable=self.auto_incremental_watch_var,
            onvalue="1", offvalue="0", width=110,
        ).pack(side="left", padx=2)

        # Export group (right side)
        self.export_btn = ctk.CTkButton(
            sec_act, text="Export to .md", command=self._on_export, width=140,
            fg_color="#2d7a2d", hover_color="#1f5a1f",
        )
        self.export_btn.pack(side="right", padx=4, pady=8)
        self.export_btn.configure(state="disabled")
        ToolTip(self.export_btn, "Save the fetched reviews as a Markdown file.\n"
                               "If Split > 0, writes multiple part-N files.")

        ctk.CTkButton(
            sec_act, text="Open store page", command=self._on_open_store, width=140,
        ).pack(side="right", padx=4, pady=8)
        ToolTip(sec_act.winfo_children()[-1],
                "Open the current game's Steam store page in your browser.")

        # Split-export control on the right side
        split_frame = ctk.CTkFrame(sec_act, fg_color="transparent")
        split_frame.pack(side="right", padx=(4, 12), pady=8)
        ctk.CTkLabel(split_frame, text="Split per N:").pack(side="left", padx=(0, 4))
        self.api_split_var = ctk.StringVar(value="0")
        self.api_split_entry = ctk.CTkEntry(
            split_frame, textvariable=self.api_split_var, width=70,
            placeholder_text="0=off",
        )
        self.api_split_entry.pack(side="left")
        ToolTip(self.api_split_entry,
                "Max reviews per output file.\n"
                "0 = single file, e.g. 1000 = ~part1, part2, …")

        # ============ "Also export" options =============================
        # Two checkboxes: also write CSV and/or JSON alongside the .md.
        # Useful for spreadsheet / pandas analysis.
        also_frame = ctk.CTkFrame(sec_act, fg_color="transparent")
        also_frame.pack(side="right", padx=4, pady=8)
        self.also_export_csv_var = ctk.StringVar(value="0")
        self.also_export_json_var = ctk.StringVar(value="0")
        ctk.CTkCheckBox(
            also_frame, text="📊 CSV", variable=self.also_export_csv_var,
            onvalue="1", offvalue="0", width=70,
        ).pack(side="left", padx=2)
        ctk.CTkCheckBox(
            also_frame, text="🔧 JSON", variable=self.also_export_json_var,
            onvalue="1", offvalue="0", width=80,
        ).pack(side="left", padx=2)
        # Per-language sub-exports: when language=all, write one .md
        # per language next to the combined export.
        self.per_language_var = ctk.StringVar(value="0")
        ctk.CTkCheckBox(
            also_frame, text="🌐 Per-lang", variable=self.per_language_var,
            onvalue="1", offvalue="0", width=90,
        ).pack(side="left", padx=2)
        # Summary button: write a summary.md next to the latest .md.
        ctk.CTkButton(
            sec_act, text="📊 Summary", width=110,
            command=self._on_write_summary,
        ).pack(side="right", padx=4, pady=8)
        # Search button: open the SearchWindow over the latest .md.
        ctk.CTkButton(
            sec_act, text="🔍 Search", width=110,
            command=self._on_search_dump,
        ).pack(side="right", padx=4, pady=8)
        # Batch button: open the BatchDumpDialog.
        ctk.CTkButton(
            sec_act, text="📦 Batch", width=110,
            command=self._on_batch_dump,
        ).pack(side="right", padx=4, pady=8)

        # ---- Secondary action row: AI/analytics actions ----
        ai_row = ctk.CTkFrame(sec_act, fg_color="transparent")
        ai_row.pack(fill="x", padx=4, pady=(0, 6))
        # AI-related
        ctk.CTkButton(
            ai_row, text="🤖 Copy + AI prompt", width=170,
            command=self._on_copy_with_ai_prompt,
        ).pack(side="left", padx=2)
        ctk.CTkButton(
            ai_row, text="💾 Save as prompt", width=140,
            command=self._on_save_as_prompt,
        ).pack(side="left", padx=2)
        ctk.CTkButton(
            ai_row, text="🔴 Quick: negatives", width=140,
            command=self._on_quick_view_negatives,
        ).pack(side="left", padx=2)
        ctk.CTkButton(
            ai_row, text="🔝 Top complaints", width=140,
            command=self._on_top_complaints,
        ).pack(side="left", padx=2)
        ctk.CTkButton(
            ai_row, text="📂 Open latest .md", width=140,
            command=self._on_open_latest_md,
        ).pack(side="left", padx=2)
        ctk.CTkButton(
            ai_row, text="⚙ Settings", width=110,
            command=self._on_settings,
            fg_color="#444", hover_color="#333",
        ).pack(side="right", padx=2)
        # Add ToolTip hints to each of the new buttons
        for btn, tip in (
            (ai_row.winfo_children()[0],
             "Copy the latest .md dump + your AI prompt template to the clipboard, ready to paste into ChatGPT/Claude/etc."),
            (ai_row.winfo_children()[1],
             "Save the AI prompt + dump as a single ai_prompt.md in the per-game folder (good for sharing/emailing)."),
            (ai_row.winfo_children()[2],
             "Open the search window pre-filtered to negative reviews only — what to look at first when a game launches."),
            (ai_row.winfo_children()[3],
             "Show the top complaint themes + top praise themes with example quotes (auto-detected from the dump)."),
            (ai_row.winfo_children()[4],
             "Open the latest .md in your OS default app (Notepad, VSCode, etc.) for a quick read."),
            (ai_row.winfo_children()[5],
             "Edit the keyword tag list and your AI prompt template. The keyword list is used for review tags + highlighting in the .md export."),
        ):
            try:
                ToolTip(btn, tip)
            except Exception:
                pass

        # ============ Progress + stats =====================================
        self.progress = ctk.CTkProgressBar(parent)
        self.progress.pack(fill="x", padx=20, pady=(4, 0))
        self.progress.set(0)

        self.stats_label = ctk.CTkLabel(parent, text="Ready.", anchor="w")
        self.stats_label.pack(fill="x", padx=20, pady=(0, 4))

        # ============ Log ================================================
        log_header = ctk.CTkFrame(parent, fg_color="transparent")
        log_header.pack(fill="x", padx=20, pady=(6, 0))
        ctk.CTkLabel(log_header, text="Log",
                     anchor="w", font=("", 13, "bold")).pack(side="left")
        clear_btn = ctk.CTkButton(
            log_header, text="Clear", width=70, height=24,
            command=lambda: self.log.delete("1.0", "end"),
        )
        clear_btn.pack(side="right")
        ToolTip(clear_btn, "Clear the log window.")

        self.log = ctk.CTkTextbox(parent, height=220, font=("Consolas", 11))
        self.log.pack(fill="both", expand=True, padx=20, pady=(4, 14))

        # ============ Keyboard shortcuts ===============================
        # Ctrl+F = fetch, Ctrl+S = stop, Ctrl+E = export, Ctrl+W = toggle watch.
        self.bind_all("<Control-f>", lambda _e: self._on_fetch())
        self.bind_all("<Control-s>", lambda _e: self._on_stop())
        self.bind_all("<Control-e>", lambda _e: (
            self._on_export() if str(self.export_btn.cget("state")) == "normal" else None
        ))
        self.bind_all("<Control-w>", lambda _e: self._on_watch_toggle())

        # Post-build: add a static info panel at the top and wrap the
        # rest of the tab content in a scrollable frame. This is
        # non-invasive — we don't touch the existing widget creation
        # code, just reorganise at the end.
        self._api_info_panel = InfoPanel(parent)
        self._api_scroll = self._reorganize_tab(parent, self._api_info_panel)
        self._api_info_panel.update()  # initial values
        # Periodic clock refresh
        self._tick_info_clock()

    def _build_tab_playwright(self, parent) -> None:
        """Build the Playwright (real-time) tab.

        Mirrors the layout of the Steam API tab (sections, 4-col
        filter grid, action bar, log with a clear button) so the two
        tabs feel like siblings instead of two unrelated forms.
        """
        pad = {"padx": 10, "pady": 6}

        # ============ Game input ==========================================
        sec_game = self._make_section(parent, "Game")
        row = ctk.CTkFrame(sec_game, fg_color="transparent")
        row.pack(fill="x", padx=8, pady=(4, 8))
        ctk.CTkLabel(row, text="App ID / store URL:", width=140, anchor="w").pack(
            side="left", padx=(4, 6)
        )
        self.pw_input_entry = ctk.CTkEntry(
            row, placeholder_text="e.g. 4311090  or  store URL",
        )
        self.pw_input_entry.pack(side="left", padx=4, fill="x", expand=True)
        self.pw_input_entry.bind("<Return>", lambda _e: self._on_pw_load())
        ToolTip(self.pw_input_entry, "Steam App ID or store / community URL.")
        self.pw_load_btn = ctk.CTkButton(
            row, text="Load Game  ⏎", command=self._on_pw_load, width=140
        )
        self.pw_load_btn.pack(side="left", padx=4)
        ToolTip(self.pw_load_btn, "Fetch the game's metadata from Steam.\nKeyboard: Enter.")

        det = ctk.CTkFrame(sec_game, fg_color="transparent")
        det.pack(fill="x", padx=8, pady=(0, 6))
        ctk.CTkLabel(det, text="Current game:", width=130, anchor="e").pack(
            side="left", padx=(0, 6)
        )
        self.pw_game_label = ctk.CTkLabel(
            det, text="(load a game above or in the Steam API tab)",
            anchor="w", text_color="gray",
        )
        self.pw_game_label.pack(side="left", padx=4, fill="x", expand=True)
        # "New since last visit" badge (shared with the API tab — both
        # tabs show the same count for the currently loaded game).
        self.pw_new_visit_badge = ctk.CTkLabel(
            det, text="", anchor="w", text_color="#5dade6",
            font=("", 11, "bold"),
        )
        self.pw_new_visit_badge.pack(fill="x", padx=4, pady=(0, 2))

        # ============ Dump folder + dedup status =======================
        # The PW tab also gets the dump-folder control in a
        # CollapsibleGroup, mirroring the API tab.
        self.pw_dump_folder_label = ctk.CTkLabel(
            sec_game, text="📂 Dump folder: …", anchor="w",
            text_color="gray",
        )
        self.pw_seen_count_label = ctk.CTkLabel(
            sec_game, text="Already exported: 0 reviews", anchor="e",
            text_color="gray",
        )
        self._pw_df_group = CollapsibleGroup(
            sec_game, "Dump folder", expanded=False, icon="📂",
        )
        self._pw_df_group.outer.pack(fill="x", padx=4, pady=(2, 4))
        pw_df_inner = ctk.CTkFrame(self._pw_df_group.body, fg_color="transparent")
        pw_df_inner.pack(fill="x", padx=4, pady=2)
        self.pw_dump_folder_label.pack(
            in_=pw_df_inner, side="left", padx=4, fill="x", expand=True,
        )
        self.pw_seen_count_label.pack(in_=pw_df_inner, side="right", padx=4)
        ctk.CTkButton(
            pw_df_inner, text="📁 Set…", width=80, height=24,
            command=self._on_pick_dump_root,
        ).pack(side="right", padx=2)
        # The API tab already initialised self.dump_root_var. The
        # Playwright tab just reuses the same one.
        self._refresh_dump_label()

        # ============ Tab explanation card ============================
        # Wrapped in a CollapsibleGroup (collapsed by default).
        self._pw_explain_group = CollapsibleGroup(
            sec_game, "When to use this tab", expanded=False, icon="📌",
        )
        self._pw_explain_group.outer.pack(fill="x", padx=4, pady=(4, 4))
        explain = ctk.CTkLabel(
            self._pw_explain_group.body,
            text=(
                "📌 When to use this tab:\n"
                "• This tab launches a real headless Chromium browser and\n"
                "  talks to Steam's un-cached ajax endpoint, so it gets\n"
                "  reviews that the JSON API has not yet indexed.\n"
                "• Use it for NEW releases (last 24-72 h) where the\n"
                "  JSON API returns 0 reviews due to cache lag.\n"
                "• Slower than the API tab (one headless browser launch\n"
                "  per scrape) — use only when needed."
            ),
            anchor="w", justify="left",
            text_color=("#8a5a00", "#e8b96a"),
            fg_color=("#fdf6e3", "#2a2218"),
            corner_radius=6,
        )
        explain.pack(fill="x", padx=4, pady=4)
        ToolTip(explain,
                "Quick guide: use this tab ONLY for new releases\n"
                "where the JSON API cache is lagging 24-72 h behind.")

        # ============ Dependencies ========================================
        sec_dep = self._make_section(parent, "Dependencies")
        dgrid = ctk.CTkFrame(sec_dep, fg_color="transparent")
        dgrid.pack(fill="x", padx=8, pady=(4, 6))
        for c in range(4):
            dgrid.grid_columnconfigure(c, weight=1)

        pkg_label = ctk.CTkLabel(dgrid, text="playwright pkg:", anchor="e", width=140)
        pkg_label.grid(row=0, column=0, sticky="e", padx=(10, 4), pady=5)
        ToolTip(pkg_label, "The Playwright Python package.\n"
                          "Install once, then click Install Chromium too.")
        self.pw_pkg_status = ctk.CTkLabel(dgrid, text="checking…", anchor="w", text_color="gray")
        self.pw_pkg_status.grid(row=0, column=1, sticky="w", padx=4, pady=5)
        self.pw_install_pkg_btn = ctk.CTkButton(
            dgrid, text="Install Playwright", command=self._on_install_playwright,
            width=170, fg_color="#2d7a2d", hover_color="#1f5a1f",
        )
        self.pw_install_pkg_btn.grid(row=0, column=2, padx=4, pady=5)
        ToolTip(self.pw_install_pkg_btn, "Installs the playwright Python package\n"
                                        "into the external Python interpreter.")
        cache_btn = ctk.CTkButton(
            dgrid, text="Open cache folder", command=self._on_open_pw_cache, width=160,
        )
        cache_btn.grid(row=0, column=3, padx=4, pady=5)
        ToolTip(cache_btn, "Reveal the Chromium download cache.\n"
                           "Default location: %LOCALAPPDATA%\\ms-playwright")

        chrome_label = ctk.CTkLabel(dgrid, text="Chromium binary:", anchor="e", width=140)
        chrome_label.grid(row=1, column=0, sticky="e", padx=(10, 4), pady=5)
        ToolTip(chrome_label, "The headless Chromium browser that Playwright uses.\n"
                             "Downloaded by 'playwright install chromium'.")
        self.pw_chrome_status = ctk.CTkLabel(dgrid, text="—", anchor="w", text_color="gray")
        self.pw_chrome_status.grid(row=1, column=1, sticky="w", padx=4, pady=5)
        self.pw_install_chrome_btn = ctk.CTkButton(
            dgrid, text="Install Chromium", command=self._on_install_chromium,
            width=170, fg_color="#2d7a2d", hover_color="#1f5a1f",
        )
        self.pw_install_chrome_btn.grid(row=1, column=2, padx=4, pady=5)
        ToolTip(self.pw_install_chrome_btn, "Downloads the Chromium browser (~150 MB).\n"
                                            "Required to actually scrape.")

        # ============ Filters ============================================
        self._pw_reset_btn = ctk.CTkButton(
            parent, text="Reset filters", width=110, height=26,
            command=self._reset_pw_filters,
        )
        ToolTip(self._pw_reset_btn, "Reset all filters in this section to defaults.")
        sec_filt = self._make_section(parent, "Filters", right_widget=self._pw_reset_btn)
        # Wrap the filter widgets in a CollapsibleGroup (matching the
        # API tab). The filter widgets use pack (one row per logical
        # row) so they fit cleanly inside the group's pack-managed
        # body.
        self._pw_filt_group = CollapsibleGroup(
            sec_filt, "Filter options", expanded=True, icon="🔍",
        )
        self._pw_filt_group.outer.pack(fill="x", padx=2, pady=(2, 2))
        pw_filter_parent = self._pw_filt_group.body

        # Local pack-based helpers (mirrors the API tab).
        def make_row() -> "ctk.CTkFrame":
            row = ctk.CTkFrame(pw_filter_parent, fg_color="transparent")
            row.pack(fill="x", padx=4, pady=2)
            return row

        def add_label(parent, text, width=130, tip=None):
            l = ctk.CTkLabel(parent, text=text, anchor="e", width=width)
            l.pack(side="left", padx=(10, 4), pady=5)
            if tip:
                ToolTip(l, tip)
            return l

        def add_widget(parent, widget, tip=None):
            widget.pack(side="left", padx=4, pady=5)
            if tip:
                ToolTip(widget, tip)
            return widget

        # Row 0: Sort by | Max reviews
        r0 = make_row()
        add_label(r0, "Sort by:",
                  tip="How to sort the reviews.\n"
                      "  recent — newest first (default)\n"
                      "  helpful — most upvoted first\n"
                      "  positive / negative — filter by sentiment")
        self.pw_sort_var = ctk.StringVar(value="recent")
        add_widget(r0, ctk.CTkOptionMenu(
            r0, values=["recent", "helpful", "positive", "negative"],
            variable=self.pw_sort_var, width=140,
        ), tip="recent / helpful / positive / negative")
        add_label(r0, "Max reviews:")
        self.pw_max_var = ctk.StringVar(value="100")
        add_widget(r0, ctk.CTkOptionMenu(
            r0, values=["20", "50", "100", "200", "500"],
            variable=self.pw_max_var, width=140,
        ), tip="Hard cap on how many reviews to fetch")

        # Row 1: Language (wide — fills its own row)
        r1 = make_row()
        add_label(r1, "Language:",
                  tip="Restrict to a single language. 'all' returns all of them.")
        self.pw_lang_var = ctk.StringVar(value="all")
        add_widget(r1, ctk.CTkOptionMenu(
            r1, values=STEAM_LANGUAGES, variable=self.pw_lang_var, width=240,
        ), tip="Steam language code or 'all'")

        # Row 2: Purchase type | Min playtime
        r2 = make_row()
        add_label(r2, "Purchase type:",
                  tip="all / steam / non_steam — see Steam API tab for details.")
        self.pw_purchase_var = ctk.StringVar(value="all")
        add_widget(r2, ctk.CTkOptionMenu(
            r2, values=["all", "steam", "non_steam"],
            variable=self.pw_purchase_var, width=140,
        ), tip="Filter by purchase source")
        add_label(r2, "Min playtime (hrs):",
                  tip="Only keep reviews from players with at least this many hours.")
        self.pw_playtime_min_entry = ctk.CTkEntry(
            r2, width=140, placeholder_text="blank = none",
        )
        add_widget(r2, self.pw_playtime_min_entry,
                   tip="Lower bound on reviewer playtime (hours)")

        # Row 3: Include off-topic
        r3 = make_row()
        add_label(r3, "Include off-topic:",
                  tip="Toggle to keep reviews Steam normally hides as 'off-topic'.")
        self.pw_offtopic_var = ctk.StringVar(value="false")
        add_widget(r3, ctk.CTkOptionMenu(
            r3, values=["false", "true"],
            variable=self.pw_offtopic_var, width=140,
        ), tip="false = filter out off-topic reviews")

        # ============ When to include (German time reference) ===========
        # Same section as the API tab — independent state so the two
        # tabs can have different "since" filters at the same time.
        sec_when = self._make_section(parent, "When to include (German time)")
        self._build_since_section(
            sec_when,
            preset_attr="pw_since_preset_var",
            date_attr="pw_since_date_entry",
            time_attr="pw_since_time_entry",
            since_label_attr="pw_since_label",
            status_attr="pw_berlin_clock_label",
            log_fn=self._pw_log,
            preset_change_fn_name="_on_pw_since_preset_change",
        )

        # ============ Action bar =========================================
        sec_act = ctk.CTkFrame(parent, fg_color="transparent")
        sec_act.pack(fill="x", **pad)

        self.pw_scrape_btn = ctk.CTkButton(
            sec_act, text="▶ Start Browser Scrape", command=self._on_pw_scrape,
            width=210, fg_color="#8a5a00", hover_color="#6e4900",
        )
        self.pw_scrape_btn.pack(side="left", padx=4, pady=8)
        ToolTip(self.pw_scrape_btn,
                "Launch Chromium and fetch reviews with the filters above.\n"
                "Keyboard: Ctrl+P")

        self.pw_resume_btn = ctk.CTkButton(
            sec_act, text="▶ Resume", command=self._on_pw_resume,
            width=140, fg_color="#2d7a2d", hover_color="#1f5a1f",
        )
        self.pw_resume_btn.pack(side="left", padx=4, pady=8)
        self.pw_resume_btn.configure(state="disabled")
        ToolTip(self.pw_resume_btn, "Continue a previously stopped scrape from\n"
                                    "the saved cursor.")

        # "🆕 Fetch new" — fetch + dedup + auto-export in one go.
        self.pw_fetch_new_btn = ctk.CTkButton(
            sec_act, text="🆕 Fetch new", command=lambda: self._on_fetch_new("pw"),
            width=140, fg_color="#0f7a3a", hover_color="#0a5a2a",
        )
        self.pw_fetch_new_btn.pack(side="left", padx=4, pady=8)
        self.pw_fetch_new_btn.configure(state="disabled")
        ToolTip(self.pw_fetch_new_btn,
                "Fetch with the current filters, drop any review\n"
                "already exported for this game, and write a new\n"
                ".md to the per-game dump folder. The seen-IDs\n"
                "list is updated automatically.")

        self.pw_export_btn = ctk.CTkButton(
            sec_act, text="Export to .md", command=self._on_pw_export,
            width=140, fg_color="#2d7a2d", hover_color="#1f5a1f",
        )
        self.pw_export_btn.pack(side="right", padx=4, pady=8)
        self.pw_export_btn.configure(state="disabled")
        ToolTip(self.pw_export_btn, "Save the scraped reviews as a Markdown file.")

        # Split-export control on the right side
        split_frame = ctk.CTkFrame(sec_act, fg_color="transparent")
        split_frame.pack(side="right", padx=(4, 12), pady=8)
        ctk.CTkLabel(split_frame, text="Split per N:").pack(side="left", padx=(0, 4))
        self.pw_split_var = ctk.StringVar(value="0")
        self.pw_split_entry = ctk.CTkEntry(
            split_frame, textvariable=self.pw_split_var, width=70,
            placeholder_text="0=off",
        )
        self.pw_split_entry.pack(side="left")
        ToolTip(self.pw_split_entry, "Max reviews per output file.\n"
                                     "0 = single file.")

        # "Also export" checkboxes (shared with the API tab via the
        # settings file — we still show them on this tab for visibility).
        pw_also_frame = ctk.CTkFrame(sec_act, fg_color="transparent")
        pw_also_frame.pack(side="right", padx=4, pady=8)
        # Summary button: write a summary.md next to the latest .md.
        ctk.CTkButton(
            sec_act, text="📊 Summary", width=110,
            command=self._on_write_summary,
        ).pack(side="right", padx=4, pady=8)
        # Search button.
        ctk.CTkButton(
            sec_act, text="🔍 Search", width=110,
            command=self._on_search_dump,
        ).pack(side="right", padx=4, pady=8)
        # Batch button.
        ctk.CTkButton(
            sec_act, text="📦 Batch", width=110,
            command=self._on_batch_dump,
        ).pack(side="right", padx=4, pady=8)

        # ---- Secondary action row: AI/analytics actions (PW tab) ----
        pw_ai_row = ctk.CTkFrame(sec_act, fg_color="transparent")
        pw_ai_row.pack(fill="x", padx=4, pady=(0, 6))
        ctk.CTkButton(
            pw_ai_row, text="🤖 Copy + AI prompt", width=170,
            command=self._on_copy_with_ai_prompt,
        ).pack(side="left", padx=2)
        ctk.CTkButton(
            pw_ai_row, text="💾 Save as prompt", width=140,
            command=self._on_save_as_prompt,
        ).pack(side="left", padx=2)
        ctk.CTkButton(
            pw_ai_row, text="🔴 Quick: negatives", width=140,
            command=self._on_quick_view_negatives,
        ).pack(side="left", padx=2)
        ctk.CTkButton(
            pw_ai_row, text="🔝 Top complaints", width=140,
            command=self._on_top_complaints,
        ).pack(side="left", padx=2)
        ctk.CTkButton(
            pw_ai_row, text="📂 Open latest .md", width=140,
            command=self._on_open_latest_md,
        ).pack(side="left", padx=2)
        ctk.CTkButton(
            pw_ai_row, text="⚙ Settings", width=110,
            command=self._on_settings,
            fg_color="#444", hover_color="#333",
        ).pack(side="right", padx=2)
        # Reuse the same StringVars so toggling either is reflected in
        # the next export.
        if not hasattr(self, "also_export_csv_var"):
            self.also_export_csv_var = ctk.StringVar(value="0")
            self.also_export_json_var = ctk.StringVar(value="0")
        ctk.CTkCheckBox(
            pw_also_frame, text="📊 CSV", variable=self.also_export_csv_var,
            onvalue="1", offvalue="0", width=70,
        ).pack(side="left", padx=2)
        ctk.CTkCheckBox(
            pw_also_frame, text="🔧 JSON", variable=self.also_export_json_var,
            onvalue="1", offvalue="0", width=80,
        ).pack(side="left", padx=2)
        # Per-language sub-exports (shared checkbox)
        if not hasattr(self, "per_language_var"):
            self.per_language_var = ctk.StringVar(value="0")
        ctk.CTkCheckBox(
            pw_also_frame, text="🌐 Per-lang", variable=self.per_language_var,
            onvalue="1", offvalue="0", width=90,
        ).pack(side="left", padx=2)

        # ============ Progress + stats ====================================
        self.pw_progress = ctk.CTkProgressBar(parent)
        self.pw_progress.pack(fill="x", padx=20, pady=(4, 0))
        self.pw_progress.set(0)

        self.pw_status_label = ctk.CTkLabel(parent, text="Ready.", anchor="w")
        self.pw_status_label.pack(fill="x", padx=20, pady=(0, 4))

        # ============ Log ================================================
        log_header = ctk.CTkFrame(parent, fg_color="transparent")
        log_header.pack(fill="x", padx=20, pady=(6, 0))
        ctk.CTkLabel(log_header, text="Log", anchor="w",
                     font=("", 13, "bold")).pack(side="left")
        pw_clear_btn = ctk.CTkButton(
            log_header, text="Clear", width=70, height=24,
            command=lambda: self.pw_log.delete("1.0", "end"),
        )
        pw_clear_btn.pack(side="right")
        ToolTip(pw_clear_btn, "Clear the log window.")

        self.pw_log = ctk.CTkTextbox(parent, height=220, font=("Consolas", 11))
        self.pw_log.pack(fill="both", expand=True, padx=20, pady=(4, 14))

        # ============ Keyboard shortcuts ===============================
        # Ctrl+P = start Playwright scrape, Ctrl+R = resume, Ctrl+E = export.
        self.bind_all("<Control-p>", lambda _e: (
            self._on_pw_scrape()
            if str(self.pw_scrape_btn.cget("state")) == "normal"
            else None
        ))
        self.bind_all("<Control-r>", lambda _e: self._on_pw_resume())

        # Post-build: add a static info panel and wrap the rest in
        # a scrollable frame, mirroring the API tab.
        self._pw_info_panel = InfoPanel(parent)
        self._pw_scroll = self._reorganize_tab(parent, self._pw_info_panel)
        self._pw_info_panel.update()

        # ============ Status bar (bottom of window) =====================
        # A persistent status bar at the bottom of the window shows
        # the current dump folder, the tracked-apps count, and a
        # "?" help button that opens the how-to-use guide.
        status_bar = ctk.CTkFrame(self, fg_color=("#f0f0f0", "#1a1a1a"),
                                    height=26)
        status_bar.pack(fill="x", side="bottom", padx=0, pady=0)
        self._status_dump_label = ctk.CTkLabel(
            status_bar, text="📂 (no dump folder)", anchor="w",
            text_color="gray", font=("", 10),
        )
        self._status_dump_label.pack(side="left", padx=10, pady=2)
        self._status_apps_label = ctk.CTkLabel(
            status_bar, text="📈 0 apps tracked", anchor="w",
            text_color="gray", font=("", 10),
        )
        self._status_apps_label.pack(side="left", padx=10, pady=2)
        # Help button (right side)
        ctk.CTkButton(
            status_bar, text="❓ How to use", width=120, height=22,
            command=self._on_show_help,
            fg_color="#444", hover_color="#333",
        ).pack(side="right", padx=6, pady=2)
        # About button
        ctk.CTkButton(
            status_bar, text="About", width=70, height=22,
            command=self._on_show_about,
            fg_color="#444", hover_color="#333",
        ).pack(side="right", padx=2, pady=2)
        # Initial state
        self._refresh_status_bar()
        # Periodic refresh (every 2 s) to keep it current
        self.after(2000, self._tick_status_bar)

    def _refresh_status_bar(self) -> None:
        """Refresh the labels in the status bar."""
        try:
            if hasattr(self, "_status_dump_label"):
                self._status_dump_label.configure(
                    text=f"📂 {self._get_dump_root()}"
                )
        except Exception:
            pass
        try:
            if hasattr(self, "_status_apps_label") and hasattr(self, "_trends_store"):
                n = len(self._get_trends_store().tracked_apps)
                self._status_apps_label.configure(text=f"📈 {n} apps tracked")
        except Exception:
            pass

    def _tick_status_bar(self) -> None:
        self._refresh_status_bar()
        try:
            self.after(2000, self._tick_status_bar)
        except Exception:
            pass

    def _on_show_help(self) -> None:
        """Open the 'How to use this tool' help dialog."""
        HelpDialog(self).open()

    def _on_show_about(self) -> None:
        """Open the About dialog."""
        messagebox.showinfo(
            "About — Steam Review Analyzer",
            "Steam Review Analyzer\n"
            "PM/QA tool for early-game review analysis with AI ingestion.\n\n"
            "Built with Python, CustomTkinter, Playwright.\n"
            "Trends tracker + per-game dedup + per-language exports.\n\n"
            "All exports are .md files designed to be pasted into "
            "ChatGPT / Claude / your favorite LLM for fast analysis.",
        )

    # ------------------------------------------------------------------ trends

    def _build_tab_trends(self, parent) -> None:
        """Build the Trends tab: tracked apps, refresh, graph.

        Any app that the user has loaded at least once is auto-added
        to the trend list. The user can also remove apps. A daily
        data point is recorded each time the user clicks "Refresh now"
        or when the app is started (the App auto-refreshes on start).
        """
        pad = {"padx": 10, "pady": 6}

        # Header
        ctk.CTkLabel(
            parent,
            text=(
                "📈 Wishlist / follower / review trends\n\n"
                "Each time you 'Refresh now' (or when the app starts), the\n"
                "current wishlist / follower / review counts are scraped from\n"
                "the Steam storefront and saved to a local time-series DB.\n"
                "Use the graph to see the daily development."
            ),
            anchor="w", justify="left",
        ).pack(fill="x", **pad)

        # Input row: add a new app to the tracked list
        add_row = ctk.CTkFrame(parent, fg_color="transparent")
        add_row.pack(fill="x", padx=10, pady=(0, 4))
        ctk.CTkLabel(add_row, text="Add App ID:", width=90, anchor="e").pack(
            side="left", padx=(0, 4)
        )
        self._trends_input_entry = ctk.CTkEntry(
            add_row, width=200, placeholder_text="e.g. 4311090",
        )
        self._trends_input_entry.pack(side="left", padx=4)
        ctk.CTkButton(
            add_row, text="➕ Add to trends", width=130,
            command=self._on_trends_add_custom,
        ).pack(side="left", padx=4)
        ctk.CTkButton(
            add_row, text="➕ Add currently loaded", width=200,
            command=self._on_trends_add_current,
        ).pack(side="left", padx=4)

        # List of tracked apps
        ctk.CTkLabel(
            parent, text="Tracked apps:", anchor="w", font=("", 12, "bold"),
        ).pack(fill="x", padx=10, pady=(8, 0))
        self._trends_list_box = ctk.CTkTextbox(
            parent, height=180, font=("Consolas", 10),
        )
        self._trends_list_box.pack(fill="x", padx=10, pady=4)
        # Bind to the list so the user can double-click to remove
        self._trends_list_box.bind(
            "<Double-Button-1>", lambda _e: self._on_trends_remove_selected(),
        )

        # Action row
        action_row = ctk.CTkFrame(parent, fg_color="transparent")
        action_row.pack(fill="x", padx=10, pady=4)
        ctk.CTkButton(
            action_row, text="🔄 Refresh now", width=130,
            command=self._on_trends_refresh_all,
        ).pack(side="left", padx=4)
        ctk.CTkButton(
            action_row, text="📈 View graph", width=130,
            command=self._on_trends_view_graph,
        ).pack(side="left", padx=4)
        ctk.CTkButton(
            action_row, text="🗑 Remove selected", width=160,
            command=self._on_trends_remove_selected,
        ).pack(side="left", padx=4)
        ctk.CTkButton(
            action_row, text="🧹 Remove all", width=130,
            command=self._on_trends_remove_all,
        ).pack(side="left", padx=4)
        ctk.CTkLabel(action_row, text="Language:", width=80, anchor="e").pack(
            side="left", padx=(20, 4)
        )
        self._trends_lang_var = ctk.StringVar(value="all")
        ctk.CTkOptionMenu(
            action_row, values=["all", "english", "german", "russian",
                              "schinese", "french", "spanish", "japanese"],
            variable=self._trends_lang_var, width=110,
        ).pack(side="left", padx=4)
        ctk.CTkButton(
            action_row, text="🔍 Per-language review count", width=210,
            command=self._on_trends_per_language,
        ).pack(side="left", padx=4)
        self._trends_status_lbl = ctk.CTkLabel(
            action_row, text="", anchor="w", text_color="gray",
        )
        self._trends_status_lbl.pack(side="right", padx=4)

        # Log
        ctk.CTkLabel(parent, text="Log:", anchor="w", font=("", 12, "bold")).pack(
            fill="x", padx=10, pady=(8, 0)
        )
        self._trends_log = ctk.CTkTextbox(
            parent, height=120, font=("Consolas", 10),
        )
        self._trends_log.pack(fill="both", expand=True, padx=10, pady=(4, 10))

        # Initialise the trends store + refresh the list
        self._refresh_trends_list()
        # If a game is loaded, auto-add it on first tab open
        if self.app_id is not None and self.app_details is not None:
            try:
                store = self._get_trends_store()
                if not store.is_tracked(self.app_id):
                    store.add(
                        self.app_id,
                        self.app_details.get("name") or f"app_{self.app_id}",
                    )
                    self._refresh_trends_list()
            except Exception:
                pass

    def _get_trends_store(self) -> TrendsStore:
        """Return the (cached) TrendsStore for the current dump root."""
        if not hasattr(self, "_trends_store") or self._trends_store is None:
            try:
                self._trends_store = TrendsStore(self._get_dump_root())
            except Exception:
                self._trends_store = TrendsStore(DEFAULT_DUMP_ROOT)
        return self._trends_store

    def _trends_log_line(self, msg: str) -> None:
        if not hasattr(self, "_trends_log"):
            return
        ts = datetime.now().strftime("%H:%M:%S")
        self._trends_log.insert("end", f"[{ts}] {msg}\n")
        self._trends_log.see("end")

    def _refresh_trends_list(self) -> None:
        if not hasattr(self, "_trends_list_box"):
            return
        try:
            store = self._get_trends_store()
            apps = store.tracked_apps
        except Exception:
            apps = []
        self._trends_list_box.configure(state="normal")
        self._trends_list_box.delete("1.0", "end")
        for a in apps:
            line = f"  • {a.get('name')} (ID {a.get('app_id')}) — added {a.get('added_at', '?')}\n"
            self._trends_list_box.insert("end", line)
        self._trends_list_box.configure(state="disabled")
        if hasattr(self, "_trends_status_lbl"):
            self._trends_status_lbl.configure(
                text=f"({len(apps)} game(s) tracked)"
            )

    def _on_trends_add_current(self) -> None:
        if self.app_id is None:
            messagebox.showinfo("No game", "Load a game in the Steam API tab first.")
            return
        try:
            store = self._get_trends_store()
            store.add(
                self.app_id,
                (self.app_details or {}).get("name") or f"app_{self.app_id}",
            )
            self._trends_log_line(
                f"Added {self.app_id} ({self.app_details.get('name')}) to trends."
            )
            self._refresh_trends_list()
        except Exception as exc:
            self._trends_log_line(f"Add failed: {exc}")

    def _on_trends_add_custom(self) -> None:
        if not hasattr(self, "_trends_input_entry"):
            return
        raw = self._trends_input_entry.get().strip()
        if not raw:
            return
        app_id = SteamAPI.resolve_app_id(raw)
        if app_id is None:
            messagebox.showerror("Invalid", f"Could not parse App ID: {raw!r}")
            return
        try:
            details = self.api.get_app_details(app_id, "english")
        except Exception:
            details = None
        if not details:
            messagebox.showerror("Not found", f"App {app_id} not found on Steam.")
            return
        try:
            store = self._get_trends_store()
            store.add(app_id, details.get("name") or f"app_{app_id}")
            self._trends_log_line(
                f"Added {app_id} ({details.get('name')}) to trends."
            )
            self._refresh_trends_list()
        except Exception as exc:
            self._trends_log_line(f"Add failed: {exc}")

    def _on_trends_remove_selected(self) -> None:
        # For simplicity, remove ALL apps on double-click / explicit
        # remove click. (Selection-by-line in a CTkTextbox is awkward.)
        if not hasattr(self, "_trends_list_box"):
            return
        try:
            store = self._get_trends_store()
            for a in list(store.tracked_apps):
                store.remove(a["app_id"])
                self._trends_log_line(f"Removed {a.get('name')} (ID {a.get('app_id')}).")
        except Exception as exc:
            self._trends_log_line(f"Remove failed: {exc}")
        self._refresh_trends_list()

    def _on_trends_remove_all(self) -> None:
        if not messagebox.askyesno(
            "Remove all", "Remove ALL tracked apps? (Data is preserved.)"
        ):
            return
        self._on_trends_remove_selected()

    def _on_trends_refresh_all(self) -> None:
        """Scrape the current wishlist/follower/review counts for all
        tracked apps and record a new data point for each.
        """
        try:
            apps = self._get_trends_store().tracked_apps
        except Exception:
            apps = []
        if not apps:
            messagebox.showinfo("Nothing to refresh", "No tracked apps yet.")
            return
        # Run the scrape in a worker so the UI doesn't freeze.
        threading.Thread(
            target=self._trends_refresh_worker,
            args=(list(apps),),
            daemon=True,
        ).start()

    def _trends_refresh_worker(self, apps: list[dict]) -> None:
        store = self._get_trends_store()
        for a in apps:
            if hasattr(self, "_trends_log"):
                self.after(0, lambda aid=a["app_id"]: self._trends_log_line(
                    f"Refreshing {aid}…"
                ))
            try:
                metrics = self.api.get_popularity_metrics(a["app_id"])
            except Exception as exc:
                if hasattr(self, "_trends_log"):
                    self.after(0, lambda aid=a["app_id"], e=exc: self._trends_log_line(
                        f"  {aid} scrape failed: {e}"
                    ))
                continue
            # Compute positive ratio from the latest in-memory reviews
            positive_ratio = None
            try:
                reviews = self._load_reviews_for_trends(a["app_id"])
                if reviews:
                    pos = sum(1 for r in reviews if r.get("voted_up"))
                    positive_ratio = round(100 * pos / len(reviews), 1)
            except Exception:
                pass
            try:
                store.record(
                    a["app_id"],
                    wishlist=metrics.get("wishlist"),
                    followers=metrics.get("followers"),
                    reviews=metrics.get("reviews"),
                    positive_ratio=positive_ratio,
                )
                # Build a status string
                bits = []
                if metrics.get("wishlist") is not None:
                    bits.append(f"wishlist {metrics['wishlist']:,}")
                if metrics.get("followers") is not None:
                    bits.append(f"followers {metrics['followers']:,}")
                if metrics.get("reviews") is not None:
                    bits.append(f"reviews {metrics['reviews']:,}")
                if hasattr(self, "_trends_log"):
                    self.after(0, lambda aid=a["app_id"], s=" / ".join(bits) or "(no data)":
                        self._trends_log_line(f"  {aid}: {s}"))
            except Exception as exc:
                if hasattr(self, "_trends_log"):
                    self.after(0, lambda aid=a["app_id"], e=exc: self._trends_log_line(
                        f"  {aid} record failed: {e}"
                    ))
        if hasattr(self, "_trends_log"):
            self.after(0, lambda: self._trends_log_line(
                f"Done — refreshed {len(apps)} app(s)."
            ))

    def _on_trends_view_graph(self) -> None:
        try:
            apps = self._get_trends_store().tracked_apps
        except Exception:
            apps = []
        if not apps:
            messagebox.showinfo("No data", "Add some apps to the trends list first.")
            return
        TrendsWindow(self, self._get_trends_store(), apps).open()

    def _load_reviews_for_trends(self, app_id: int) -> list[dict]:
        """Load the latest .md dump for `app_id` and parse it back
        into a minimal `{voted_up: bool, ...}` shape. Used by the
        trends refresh worker to compute the positive ratio.

        The dump format is what `MarkdownExporter.render` writes, so
        we look for `👍 Positive` / `👎 Negative` markers. We do not
        reconstruct the full review — only the vote flag is needed.
        """
        try:
            folder = self._get_game_dump_folder(app_id=app_id)
        except Exception:
            return []
        md_files = sorted(
            folder.glob("GQA Reviewdump_*.md"),
            key=lambda p: p.stat().st_mtime, reverse=True,
        )
        if not md_files:
            return []
        try:
            text = md_files[0].read_text(encoding="utf-8")
        except OSError:
            return []
        # Split on "### Review #N" and extract the vote flag from each block
        out: list[dict] = []
        blocks = text.split("### Review #")
        for block in blocks[1:]:
            voted = None
            if "👍 Positive" in block:
                voted = True
            elif "👎 Negative" in block:
                voted = False
            if voted is not None:
                out.append({"voted_up": voted})
        return out

    def _on_trends_per_language(self) -> None:
        """Open a popup showing how many reviews we have for the
        selected language across the most recent dump.
        """
        if self.app_id is None:
            messagebox.showinfo("No game", "Load a game in the API tab first.")
            return
        try:
            folder = self._get_game_dump_folder()
        except Exception as exc:
            self._trends_log_line(f"Could not resolve folder: {exc}")
            return
        md_files = sorted(
            folder.glob("GQA Reviewdump_*.md"),
            key=lambda p: p.stat().st_mtime, reverse=True,
        )
        if not md_files:
            messagebox.showinfo("No dump", "Run a fetch first.")
            return
        # Read the latest dump and count language occurrences
        try:
            text = md_files[0].read_text(encoding="utf-8")
        except OSError as exc:
            messagebox.showerror("Read failed", str(exc))
            return
        # Crude parse: find lines like "| Language | `<lang>` |"
        import re as _re
        langs: dict[str, int] = {}
        for m in _re.finditer(r"\|\s*Language\s*\|\s*`?([a-zA-Z_]+)`?\s*\|", text):
            lang = m.group(1)
            langs[lang] = langs.get(lang, 0) + 1
        total = sum(langs.values())
        # Build the popup
        top = ctk.CTkToplevel(self.master)
        top.title("Per-language review count")
        top.geometry("480x500")
        top.transient(self.master)
        top.grab_set()
        ctk.CTkLabel(
            top,
            text=(
                f"🌐 Per-language review count for {md_files[0].name}\n"
                f"Total: {total} reviews"
            ),
            anchor="w", justify="left",
        ).pack(fill="x", padx=10, pady=(10, 4))
        box = ctk.CTkTextbox(top, font=("Consolas", 10))
        box.pack(fill="both", expand=True, padx=10, pady=4)
        if langs:
            lines = ["| Language | Count | % |", "|---|---|---|"]
            for l, c in sorted(langs.items(), key=lambda kv: -kv[1]):
                pct = round(100 * c / total, 1) if total else 0
                lines.append(f"| {l} | {c} | {pct}% |")
            box.insert("1.0", "\n".join(lines))
        else:
            box.insert("1.0", "(no language metadata found in the dump)")
        box.configure(state="disabled")
        ctk.CTkButton(top, text="Close", width=110, command=top.destroy).pack(
            side="bottom", pady=8
        )

    def _on_trends_open_folder(self) -> None:
        """Open the trends.json file's folder."""
        try:
            path = TrendsStore.path_for(self._get_dump_root())
            folder = path.parent
        except Exception:
            folder = self._get_dump_root()
        try:
            if sys.platform == "win32":
                os.startfile(str(folder))
            elif sys.platform == "darwin":
                import subprocess
                subprocess.Popen(["open", str(folder)])
            else:
                import subprocess
                subprocess.Popen(["xdg-open", str(folder)])
        except Exception as exc:
            self._trends_log_line(f"Open folder failed: {exc}")

    # ------------------------------------------------------------------ helpers

    def _reset_api_filters(self) -> None:
        """Reset all Steam API tab filter widgets to their defaults."""
        self.lang_var.set("all")
        self.filter_var.set("recent")
        self.type_var.set("all")
        self.purchase_var.set("all")
        self.offtopic_var.set("false")
        self.since_preset_var.set("all time")
        self._on_since_preset_change()  # collapse custom row
        self.day_entry.delete(0, "end")
        self.date_entry.delete(0, "end")
        self.helpful_entry.delete(0, "end")
        self.playtime_min_entry.delete(0, "end")
        self.perpage_var.set("100")
        self.interval_var.set("5")
        self.backend_var.set("Steam API")
        self._refresh_since_label()
        self._log("Filters reset to defaults.")

    def _reset_pw_filters(self) -> None:
        """Reset all Playwright tab filter widgets to their defaults."""
        self.pw_sort_var.set("recent")
        self.pw_max_var.set("100")
        self.pw_lang_var.set("all")
        self.pw_purchase_var.set("all")
        self.pw_offtopic_var.set("false")
        self.pw_since_preset_var.set("all time")
        self._on_pw_since_preset_change()
        self.pw_playtime_min_entry.delete(0, "end")
        self._refresh_pw_since_label()
        self._pw_log("Filters reset to defaults.")

    @staticmethod
    def _make_section(parent, title: str, right_widget: "ctk.CTkWidget" = None) -> "ctk.CTkFrame":
        """Create a labelled card-style section for grouping controls.

        Returns the inner `CTkFrame` that the caller packs content
        into. The label is rendered as a header bar at the top.

        If `right_widget` is provided, it is packed at the right side
        of the section header (useful for "Reset", "Clear", etc.).
        """
        outer = ctk.CTkFrame(parent, fg_color="transparent")
        outer.pack(fill="x", padx=10, pady=(8, 0))
        header = ctk.CTkFrame(outer, fg_color="transparent")
        header.pack(fill="x", padx=8)
        ctk.CTkLabel(
            header, text=title, font=("", 13, "bold"), anchor="w",
        ).pack(side="left", padx=4)
        if right_widget is not None:
            right_widget.pack(side="right", padx=4)
        sep = ctk.CTkFrame(outer, height=1, fg_color=("#cccccc", "#444444"))
        sep.pack(fill="x", padx=8, pady=(4, 6))
        inner = ctk.CTkFrame(outer)
        inner.pack(fill="x", padx=8, pady=(0, 4))
        return inner

    # -------- "When to include" filter (shared by both tabs) --------

    def _build_since_section(
        self,
        parent: "ctk.CTkFrame",
        preset_attr: str,
        date_attr: str,
        time_attr: str,
        since_label_attr: str,
        status_attr: str,
        log_fn,
        preset_change_fn_name: str,
    ) -> "ctk.CTkFrame":
        """Build the "When to include reviews" section.

        Args:
          parent: section frame to pack the inner content into
          preset_attr / date_attr / time_attr: attribute names where
            the StringVar / Entry widgets are stored on `self` (so the
            reset handler can find them).
          since_label_attr: attribute name for the live 'Will include
            reviews from: …' label
          status_attr: attribute name for the live German-time clock
            label
          log_fn: function to call to write a log line ("_log" or
            "_pw_log")
          preset_change_fn_name: name of the method on self to call
            when the preset dropdown changes (to show/hide the
            custom date+time row).
        """
        # Top row: preset dropdown spans columns 1-3
        lbl = ctk.CTkLabel(parent, text="Include only:", anchor="e", width=130)
        lbl.grid(row=0, column=0, sticky="e", padx=(10, 4), pady=5)
        ToolTip(lbl, "Filter reviews by when they were posted.\n"
                     "All times are interpreted in Europe/Berlin time.")
        preset_var = ctk.StringVar(value="all time")
        setattr(self, preset_attr, preset_var)
        menu = ctk.CTkOptionMenu(
            parent,
            values=SINCE_PRESET_LABELS,
            variable=preset_var,
            width=240,
            command=lambda _v: getattr(self, preset_change_fn_name)(),
        )
        menu.grid(row=0, column=1, columnspan=3, padx=4, pady=5, sticky="ew")
        ToolTip(menu,
            "Quick presets for the time window.\n"
            "  'all time'   – no time filter\n"
            "  'last N h/d' – last N hours/days up to now\n"
            "  'custom'     – pick a specific date + time of day")

        # Prominent "Now in Berlin" indicator — always visible at the
        # top of the section so the user knows what "now" means.
        now_lbl = ctk.CTkLabel(
            parent,
            text=f"🕐 Now in Berlin: {current_berlin_str()}",
            anchor="w", font=("", 12, "bold"),
            text_color=("#1f6aa5", "#5da9d6"),
        )
        now_lbl.grid(row=0, column=0, columnspan=4,
                     sticky="ew", padx=(10, 8), pady=(4, 0))
        ToolTip(now_lbl, "Current time in Europe/Berlin.\n"
                         "All custom date+time inputs are interpreted in\n"
                         "this timezone. Updates once per second.")
        setattr(self, status_attr, now_lbl)

        # Shift the existing layout down by one row to make room for
        # the now-indicator. The preset dropdown is now on row 1,
        # the custom row on row 2, etc.
        preset_row = 1
        custom_row = 2
        since_lbl_row = 3
        clock_lbl_row = 4

        # Preset dropdown (full-width row, just under the now-indicator)
        lbl = ctk.CTkLabel(parent, text="Include only:", anchor="e", width=130)
        lbl.grid(row=preset_row, column=0, sticky="e", padx=(10, 4), pady=5)
        ToolTip(lbl, "Filter reviews by when they were posted.\n"
                     "All times are interpreted in Europe/Berlin time.")
        setattr(self, preset_attr, preset_var)
        menu = ctk.CTkOptionMenu(
            parent,
            values=SINCE_PRESET_LABELS,
            variable=preset_var,
            width=240,
            command=lambda _v: getattr(self, preset_change_fn_name)(),
        )
        menu.grid(row=preset_row, column=1, columnspan=3,
                  padx=4, pady=5, sticky="ew")
        ToolTip(menu,
            "Quick presets for the time window.\n"
            "  'all time'   – no time filter\n"
            "  'last N h/d' – last N hours/days up to now\n"
            "  'custom'     – pick a specific date + time of day")

        # Custom row (only shown when preset == custom).
        # Date + 📅 picker button + time + 🕐 picker button.
        date_lbl = ctk.CTkLabel(parent, text="From date:", anchor="e", width=130)
        date_entry = ctk.CTkEntry(
            parent, width=140,
            placeholder_text="YYYY-MM-DD (German)",
        )
        # 📅 button to open the calendar popup
        date_picker_btn = ctk.CTkButton(
            parent, text="📅", width=36,
            command=lambda: DatePickerPopup(
                date_entry, self, on_change=self._refresh_since_label,
            ).open(),
        )
        ToolTip(date_picker_btn, "Open a calendar picker (German time).")
        ToolTip(date_entry, "Date in Europe/Berlin time.\n"
                            "Leave blank to use today's date.")

        time_lbl = ctk.CTkLabel(parent, text="From time:", anchor="e", width=130)
        time_entry = ctk.CTkEntry(
            parent, width=140,
            placeholder_text="HH:MM (German time)",
        )
        time_picker_btn = ctk.CTkButton(
            parent, text="🕐", width=36,
            command=lambda: TimePickerPopup(
                time_entry, self, on_change=self._refresh_since_label,
            ).open(),
        )
        ToolTip(time_picker_btn, "Open a time-of-day picker (German time).")
        ToolTip(time_entry, "Time of day in Europe/Berlin time.\n"
                            "Leave blank for 00:00.")
        setattr(self, date_attr, date_entry)
        setattr(self, time_attr, time_entry)
        # Bind a refresh call so the "since" label updates as you type
        date_entry.bind("<KeyRelease>", lambda _e: self._refresh_since_label())
        time_entry.bind("<KeyRelease>", lambda _e: self._refresh_since_label())
        preset_var.trace_add("write", lambda *_: self._refresh_since_label())

        # Live computed "since" label (row 3)
        since_lbl = ctk.CTkLabel(
            parent, text="Will include reviews from: —",
            anchor="w", text_color=("#1f6aa5", "#5da9d6"),
        )
        since_lbl.grid(row=since_lbl_row, column=0, columnspan=4,
                       sticky="ew", padx=(10, 8), pady=(0, 4))
        setattr(self, since_label_attr, since_lbl)
        ToolTip(since_lbl, "Computed lower bound for the 'since' filter.\n"
                          "Updates live as you change preset/date/time.")

        # German-time clock label (row 4). Stored on self so the
        # 1 Hz tick can update it.
        clock_lbl = ctk.CTkLabel(
            parent, text=f"Current German time: {current_berlin_str()}",
            anchor="w", text_color="gray",
        )
        clock_lbl.grid(row=clock_lbl_row, column=0, columnspan=4,
                       sticky="ew", padx=(10, 8), pady=(0, 6))
        setattr(self, status_attr, clock_lbl)

        for c in range(4):
            parent.grid_columnconfigure(c, weight=1)

        # Store the date+time row widgets on self so the preset-change
        # handler can show/hide them. ALSO store the picker buttons
        # and the date/time row index so we can show/hide them too.
        # We honor the tab prefix (e.g. "since_" or "pw_since_") so the
        # two tabs have independent state.
        prefix = ""
        for attr in (preset_attr, date_attr, time_attr):
            if attr.startswith("pw_"):
                prefix = "pw_"
                break
        setattr(self, f"{prefix}since_date_lbl", date_lbl)
        setattr(self, f"{prefix}since_time_lbl", time_lbl)
        setattr(self, f"{prefix}since_date_entry", date_entry)
        setattr(self, f"{prefix}since_time_entry", time_entry)
        setattr(self, f"{prefix}since_date_picker_btn", date_picker_btn)
        setattr(self, f"{prefix}since_time_picker_btn", time_picker_btn)
        setattr(self, f"{prefix}since_custom_row", custom_row)

        return parent

    def _on_since_preset_change(self) -> None:
        """Show or hide the custom date+time row in the API tab."""
        self._toggle_since_row("api")
        self._refresh_since_label()

    def _on_pw_since_preset_change(self) -> None:
        """Show or hide the custom date+time row in the Playwright tab."""
        self._toggle_since_row("pw")
        self._refresh_pw_since_label()

    def _toggle_since_row(self, tab: str) -> None:
        """Show or hide the date+time row (with picker buttons) for
        the given tab ('api' or 'pw')."""
        prefix = "pw_" if tab == "pw" else ""
        is_custom = getattr(self, f"{prefix}since_preset_var").get().startswith("custom")
        r = getattr(self, f"{prefix}since_custom_row")
        d_lbl = getattr(self, f"{prefix}since_date_lbl")
        d_entry = getattr(self, f"{prefix}since_date_entry")
        d_btn = getattr(self, f"{prefix}since_date_picker_btn")
        t_lbl = getattr(self, f"{prefix}since_time_lbl")
        t_entry = getattr(self, f"{prefix}since_time_entry")
        t_btn = getattr(self, f"{prefix}since_time_picker_btn")
        if is_custom:
            d_lbl.grid(row=r, column=0, sticky="e", padx=(10, 4), pady=5)
            d_entry.grid(row=r, column=1, sticky="w", padx=4, pady=5)
            d_btn.grid(row=r, column=1, sticky="e", padx=(110, 4), pady=5)
            t_lbl.grid(row=r, column=2, sticky="e", padx=(20, 4), pady=5)
            t_entry.grid(row=r, column=3, sticky="w", padx=4, pady=5)
            t_btn.grid(row=r, column=3, sticky="e", padx=(110, 4), pady=5)
        else:
            for w in (d_lbl, d_entry, d_btn, t_lbl, t_entry, t_btn):
                w.grid_remove()

    def _refresh_since_label(self) -> None:
        """Update the live 'Will include reviews from:' label (API tab)."""
        if not hasattr(self, "since_preset_var"):
            return
        ts = compute_since_timestamp(
            self.since_preset_var.get(),
            self.since_date_entry.get(),
            self.since_time_entry.get(),
        )
        self.since_label.configure(
            text=f"Will include reviews from: {format_berlin(ts)}"
        )
        self._refresh_clock_label()

    def _refresh_pw_since_label(self) -> None:
        """Update the live 'Will include reviews from:' label (PW tab)."""
        if not hasattr(self, "pw_since_preset_var"):
            return
        ts = compute_since_timestamp(
            self.pw_since_preset_var.get(),
            self.pw_since_date_entry.get(),
            self.pw_since_time_entry.get(),
        )
        self.pw_since_label.configure(
            text=f"Will include reviews from: {format_berlin(ts)}"
        )
        self._refresh_clock_label()

    def _refresh_clock_label(self) -> None:
        """Update the live German-time clock on both tabs (if widgets exist).

        The `berlin_clock_label` / `pw_berlin_clock_label` is the
        prominent "Now in Berlin" indicator at the top of the
        "When to include" section. The `clock_lbl` (API tab) and
        `pw_clock_lbl` (Playwright tab) are the small status line
        at the bottom of the same section.
        """
        now = current_berlin_str()
        now_short = current_berlin_str()[:19]  # YYYY-MM-DD HH:MM:SS
        # Top "Now in Berlin" indicator (large, blue) — both tabs.
        if hasattr(self, "berlin_clock_label"):
            self.berlin_clock_label.configure(text=f"🕐 Now in Berlin: {now_short}")
        if hasattr(self, "pw_berlin_clock_label"):
            self.pw_berlin_clock_label.configure(text=f"🕐 Now in Berlin: {now_short}")
        # Bottom small status line (gray) — both tabs.
        if hasattr(self, "clock_lbl"):
            self.clock_lbl.configure(text=f"Current German time: {now}")
        if hasattr(self, "pw_clock_lbl"):
            self.pw_clock_lbl.configure(text=f"Current German time: {now}")

    def _tick_clock(self) -> None:
        """Re-arm the 1-second clock tick."""
        self._refresh_clock_label()
        self.after(1000, self._tick_clock)

    # --- low-level helpers used by both tabs ----------------------------

    def _since_preset_attr(self, tab: str) -> str:
        return "pw_since_preset_var" if tab == "pw" else "since_preset_var"

    def _since_date_attr(self, tab: str) -> str:
        return "pw_since_date_entry" if tab == "pw" else "since_date_entry"

    def _since_time_attr(self, tab: str) -> str:
        return "pw_since_time_entry" if tab == "pw" else "since_time_entry"

    def get_since_timestamp(self, tab: str) -> Optional[int]:
        """Compute the current 'since' timestamp for the given tab
        ('api' or 'pw'). Returns None if no time filter is active.
        """
        preset = getattr(self, self._since_preset_attr(tab)).get()
        date_s = getattr(self, self._since_date_attr(tab)).get()
        time_s = getattr(self, self._since_time_attr(tab)).get()
        return compute_since_timestamp(preset, date_s, time_s)

    def _log(self, msg: str) -> None:
        # Use after() so this method is safe to call from worker threads.
        # Tkinter widget modifications from non-main threads can crash
        # the interpreter on some platforms.
        ts = datetime.now().strftime("%H:%M:%S")
        try:
            self.after(
                0,
                lambda m=msg, t=ts: (
                    self.log.insert("end", f"[{t}] {m}\n"),
                    self.log.see("end"),
                ),
            )
        except Exception:
            # Fall back to direct insert if the widget is gone (e.g. window closed).
            try:
                self.log.insert("end", f"[{ts}] {msg}\n")
                self.log.see("end")
            except Exception:
                pass

    def _parse_min_date(self) -> Optional[int]:
        s = (self.date_entry.get() or "").strip()
        if not s:
            return None
        try:
            dt = datetime.strptime(s, "%Y-%m-%d").replace(tzinfo=timezone.utc)
            return int(dt.timestamp())
        except ValueError:
            messagebox.showwarning(
                "Bad date",
                f"Could not parse '{s}' as YYYY-MM-DD. Ignoring min_date.",
            )
            return None

    def _parse_day_range(self) -> Optional[int]:
        s = (self.day_entry.get() or "").strip()
        if not s:
            return None
        try:
            n = int(s)
            if n < 1:
                raise ValueError
            return n
        except ValueError:
            messagebox.showwarning(
                "Bad day range",
                f"'{s}' is not a positive integer. Ignoring day_range.",
            )
            return None

    def _parse_helpful(self) -> int:
        s = (self.helpful_entry.get() or "").strip()
        if not s:
            return 0
        try:
            return max(0, int(s))
        except ValueError:
            return 0

    def _set_busy(self, busy: bool) -> None:
        """Enable / disable the action buttons.

        Manages BOTH the Steam API tab and the Playwright tab
        buttons so the user can't start a second long-running
        operation while another one is in progress. Each tab's
        export button is only enabled if that tab has reviews to
        export.
        """
        if busy:
            self.fetch_btn.configure(state="disabled")
            self.stop_btn.configure(state="normal")
            self.export_btn.configure(state="disabled")
            if hasattr(self, "api_resume_btn"):
                self.api_resume_btn.configure(state="disabled")
            if hasattr(self, "api_fetch_new_btn"):
                self.api_fetch_new_btn.configure(state="disabled")
            if hasattr(self, "pw_scrape_btn"):
                self.pw_scrape_btn.configure(state="disabled")
            if hasattr(self, "pw_resume_btn"):
                self.pw_resume_btn.configure(state="disabled")
            if hasattr(self, "pw_fetch_new_btn"):
                self.pw_fetch_new_btn.configure(state="disabled")
            if hasattr(self, "pw_export_btn"):
                self.pw_export_btn.configure(state="disabled")
        else:
            self.fetch_btn.configure(state="normal")
            self.stop_btn.configure(state="disabled")
            self.export_btn.configure(
                state="normal" if self.reviews else "disabled"
            )
            if hasattr(self, "pw_scrape_btn"):
                # The pw_scrape_btn is also gated by the dependency
                # check (Playwright + Chromium must be installed);
                # _refresh_dep_status sets it to normal in that case.
                self._refresh_dep_status()
            if hasattr(self, "pw_export_btn"):
                self.pw_export_btn.configure(
                    state="normal" if self.pw_reviews else "disabled"
                )
            # "Fetch new" buttons: enabled when a game is loaded.
            if hasattr(self, "api_fetch_new_btn") and self.app_id is not None:
                self.api_fetch_new_btn.configure(state="normal")
            if hasattr(self, "pw_fetch_new_btn") and self.app_id is not None:
                self.pw_fetch_new_btn.configure(state="normal")
            # Resume buttons are managed by _refresh_resume_buttons.
            self._refresh_resume_buttons()

    def _clear_loaded_game(self) -> None:
        """Reset the loaded game state when a load fails or the user
        wants to start over. Clears in-memory data, UI labels, and
        any resume state for the previously loaded app (both tabs).
        """
        old_app_id = self.app_id
        self.app_id = None
        self.app_details = None
        self.reviews = []
        if hasattr(self, "details_title"):
            self.details_title.configure(text="No game loaded.")
        if hasattr(self, "details_meta"):
            self.details_meta.configure(text="")
        if hasattr(self, "pw_game_label"):
            self.pw_game_label.configure(
                text="(load a game above or in the Steam API tab)",
                text_color="gray",
            )
        if old_app_id is not None:
            self._resume_clear("api", old_app_id)
            self._resume_clear("pw", old_app_id)
        # Disable "Fetch new" buttons (no game = nothing to dedup).
        if hasattr(self, "api_fetch_new_btn"):
            self.api_fetch_new_btn.configure(state="disabled")
        if hasattr(self, "pw_fetch_new_btn"):
            self.pw_fetch_new_btn.configure(state="disabled")
        self._refresh_resume_buttons()

    # ------------------------------------------------------------------ actions

    def _on_load(self) -> None:
        raw = self.input_entry.get()
        app_id = self.api.resolve_app_id(raw)
        if app_id is None:
            messagebox.showerror(
                "Invalid input",
                "Could not extract an App ID from your input.\n\n"
                "Examples of valid input:\n"
                "  4311090\n"
                "  https://store.steampowered.com/app/4311090/\n"
                "  steam://run/4311090",
            )
            return

        self._log(f"Loading app {app_id} …")
        try:
            details = self.api.get_app_details(app_id, "english")
        except Exception as exc:  # pragma: no cover
            details = None
            self._log(f"App details error: {exc}")

        if not details:
            messagebox.showerror(
                "Not found",
                f"App ID {app_id} could not be loaded from Steam.\n"
                "Either the ID is wrong or Steam blocked the request.",
            )
            # Clear the previously loaded game so the user does not
            # accidentally run a fetch / scrape against a stale id.
            self._clear_loaded_game()
            return

        self.app_id = app_id
        self.app_details = details
        self.reviews = []

        name = details.get("name", f"App {app_id}")
        dev = ", ".join(details.get("developers", []) or ["—"])
        pub = ", ".join(details.get("publishers", []) or ["—"])
        rel = (details.get("release_date") or {}).get("date", "—")
        self.details_title.configure(text=name)
        self.details_meta.configure(
            text=(
                f"App ID: {app_id}    •    "
                f"Developer: {dev}    •    "
                f"Publisher: {pub}    •    "
                f"Released: {rel}"
            )
        )
        self._log(f"Loaded '{name}' (ID {app_id}).")
        # Enable watch button now that a game is loaded
        if not self.watching:
            self.watch_btn.configure(state="normal")
        # Enable the "Fetch new" buttons now that a game is loaded.
        if hasattr(self, "api_fetch_new_btn"):
            self.api_fetch_new_btn.configure(state="normal")
        if hasattr(self, "pw_fetch_new_btn"):
            self.pw_fetch_new_btn.configure(state="normal")
        # Update the Playwright tab's game label too
        if hasattr(self, "pw_game_label"):
            self.pw_game_label.configure(
                text=f"{name} (ID {app_id})",
                text_color=("black", "white"),
            )
        # Mirror the App ID to the Playwright tab's input for consistency
        if hasattr(self, "pw_input_entry"):
            self.pw_input_entry.delete(0, "end")
            self.pw_input_entry.insert(0, str(app_id))
        # Persist
        try:
            self._settings_save()
        except Exception:
            pass
        # Refresh the Resume buttons to reflect any saved state for
        # the newly loaded app.
        self.after(0, self._refresh_resume_buttons)

    def _on_fetch(self) -> None:
        if self.app_id is None:
            messagebox.showinfo("No game", "Please load a game first.")
            return
        if self._worker and self._worker.is_alive():
            return

        self._stop_event.clear()
        self.reviews = []
        self.progress.set(0)
        self.stats_label.configure(text="Fetching…")
        self._set_busy(True)

        # Clear any resume state from a previous run; this is a fresh fetch.
        self._resume_clear("api", self.app_id)

        worker = threading.Thread(
            target=self._fetch_worker, args=("*",), daemon=True
        )
        self._worker = worker
        worker.start()

    def _on_api_resume(self) -> None:
        """Continue a previously-stopped Steam API fetch."""
        if self.app_id is None:
            messagebox.showinfo("No game", "Please load a game first.")
            return
        if self._worker and self._worker.is_alive():
            return
        state = self._resume_get("api", self.app_id)
        if not state or not state.get("cursor"):
            messagebox.showinfo("Nothing to resume",
                                "No saved resume state for this app.")
            return

        # Restore the previously collected reviews and start from
        # the saved cursor.
        self.reviews = list(state.get("reviews", []) or [])
        self._log(
            f"Resuming Steam API fetch from {len(self.reviews)} saved reviews, "
            f"cursor='{state.get('cursor','')[:30]}…'"
        )
        self._stop_event.clear()
        self.progress.set(0)
        self.stats_label.configure(text="Resuming…")
        self._set_busy(True)

        worker = threading.Thread(
            target=self._fetch_worker,
            args=(state.get("cursor", "*"),),
            daemon=True,
        )
        self._worker = worker
        worker.start()

    def _fetch_worker(self, start_cursor: str = "*", dedup_against_seen: bool = False) -> None:
        assert self.app_id is not None
        # Track the last cursor we got from the API so we can save
        # the resume state on Stop.
        last_cursor_holder: list[str] = [start_cursor]
        try:
            day_range = self._parse_day_range()
            min_date_ts = self._parse_min_date()
            min_helpful = self._parse_helpful()
            per_page = int(self.perpage_var.get())

            self._log(
                f"Starting fetch: language={self.lang_var.get()}, "
                f"filter={self.filter_var.get()}, type={self.type_var.get()}, "
                f"day_range={day_range}, min_date_ts={min_date_ts}, "
                f"per_page={per_page}"
            )

            def cursor_cb(c: str) -> None:
                last_cursor_holder[0] = c

            # New filters added: purchase_type, playtime_filter_min,
            # filter_offtopic_activity. All are read from the GUI
            # widgets built in _build_tab_api.
            try:
                playtime_min_hours = int(
                    (self.playtime_min_entry.get() or "").strip() or 0
                )
                playtime_filter_min = playtime_min_hours * 60
            except ValueError:
                playtime_filter_min = 0
            filter_offtopic = self.offtopic_var.get() == "true"
            # "When to include" — if the GUI has a since timestamp,
            # it overrides the legacy day_range / min_date_ts.
            gui_since_ts = self.get_since_timestamp("api")
            if gui_since_ts is not None:
                min_date_ts = max(min_date_ts or 0, gui_since_ts)
                day_range = None  # mutually exclusive with since

            new_reviews = self.api.fetch_all_reviews(
                app_id=self.app_id,
                language=self.lang_var.get(),
                review_filter=self.filter_var.get(),
                review_type=self.type_var.get(),
                day_range=day_range,
                min_date_ts=min_date_ts,
                num_per_page=per_page,
                progress_cb=self._on_progress,
                log_cb=self._log,
                stop_flag=self._stop_event.is_set,
                start_cursor=start_cursor,
                cursor_cb=cursor_cb,
                purchase_type=self.purchase_var.get(),
                playtime_filter_min=playtime_filter_min,
                filter_offtopic_activity=filter_offtopic,
            )

            if min_helpful > 0:
                before = len(new_reviews)
                new_reviews = [
                    r for r in new_reviews
                    if (r.get("votes_up", 0) or 0) >= min_helpful
                ]
                self._log(f"Filtered by helpful≥{min_helpful}: {before} → {len(new_reviews)}")

            # "Fetch new" dedup: drop reviews we've already exported.
            # We do this AFTER all the other filters so the seen-set
            # exactly matches the set of recommendations actually
            # written to disk.
            if dedup_against_seen:
                seen = self._load_seen_ids()
                # Also exclude IDs already in self.reviews (handles
                # the "user stopped a Fetch-new mid-way and then
                # clicked Resume" case — the partial fetch is still
                # in self.reviews from _on_api_resume's restore).
                for r in self.reviews:
                    rid = str(r.get("recommendationid") or "")
                    if rid:
                        seen.add(rid)
                if seen:
                    before = len(new_reviews)
                    new_reviews = [
                        r for r in new_reviews
                        if str(r.get("recommendationid") or "") not in seen
                    ]
                    dropped = before - len(new_reviews)
                    self._log(
                        f"Fetch-new dedup: {dropped} already-exported reviews skipped, "
                        f"{len(new_reviews)} new reviews to write."
                    )
                else:
                    self._log(
                        f"Fetch-new dedup: no previously-exported reviews on disk, "
                        f"writing all {len(new_reviews)}."
                    )

            # "First 24h / last 7d" window filter
            try:
                win = self.first_24h_var.get()
            except Exception:
                win = "all"
            if win in ("first 24h", "last 7d") and new_reviews:
                if win == "first 24h":
                    cut = split_first_24h(new_reviews)
                    new_reviews = cut["first_24h"]
                    self._log(
                        f"Window: kept first 24h only ({len(new_reviews)} reviews)"
                    )
                elif win == "last 7d":
                    cutoff_ts = int(time.time()) - 7 * 86400
                    before = len(new_reviews)
                    new_reviews = [
                        r for r in new_reviews
                        if int(r.get("timestamp_created", 0) or 0) >= cutoff_ts
                    ]
                    self._log(
                        f"Window: kept last 7d only ({before} → {len(new_reviews)} reviews)"
                    )

            # Append to whatever was already collected (for resume).
            self.reviews.extend(new_reviews)
            pos = sum(1 for r in self.reviews if r.get("voted_up"))
            total = len(self.reviews)
            pct = round(100 * pos / total, 1) if total else 0.0
            self._log(
                f"Done. Kept {total} reviews "
                f"({pos} positive / {total - pos} negative · {pct}% positive)."
            )
            self.stats_label.configure(
                text=f"{total} reviews kept · {pos} positive · {total - pos} negative · {pct}% positive"
            )

            # ------------------------------------------------------------
            # Diagnosis: if the JSON API returned 0 reviews, the most
            # likely cause is the well-known Steam "review cache lag"
            # for new apps (the storefront UI cache and the JSON review
            # cache are separate; the JSON one can lag by hours to days).
            # Surface that to the user instead of leaving them confused.
            # ------------------------------------------------------------
            if total == 0 and self.app_id is not None:
                self._log("API returned 0 reviews — diagnosing…")
                stats = self.api.get_storefront_stats_from_html(self.app_id)
                if stats["html_ok"] and stats["total_reviews"] > 0:
                    self._log(
                        f"Storefront HTML confirms {stats['total_reviews']} reviews "
                        f"({stats['score_label']}, {stats['positive_pct']}% positive)."
                    )
                    self._log(
                        "Confirmed: this is the Steam review-cache lag for new apps."
                    )
                    msg = (
                        f"The JSON review API returned 0 reviews, but the Steam "
                        f"storefront shows there ARE reviews for this app.\n\n"
                        f"App ID: {self.app_id}\n"
                        f"Storefront reports: {stats['total_reviews']} reviews "
                        f"({stats['score_label']}, {stats['positive_pct']}% positive)\n\n"
                        "This is a known Steam backend delay: the JSON review cache "
                        "is updated on a different schedule than the storefront UI. "
                        "It can take 24-72 hours after first reviews appear in your "
                        "browser before they show up in the API.\n\n"
                        "Recommended actions:\n"
                        "  1. Wait a few hours / days and click 'Fetch Reviews' again.\n"
                        "  2. Try the FULL game (different App ID) — it may already be "
                        "in the cache. Example: the demo you loaded is "
                        f"{self.app_id}; the full game is often a smaller number.\n"
                        "  3. Verify manually by opening the store page in your browser.\n\n"
                        "This is NOT a bug in this tool — it is a Steam-side delay."
                    )
                    self.stats_label.configure(
                        text=(
                            f"⚠ Steam cache lag — storefront shows "
                            f"{stats['total_reviews']} reviews, API returns 0. Retry later."
                        )
                    )
                    self.after(
                        0,
                        lambda m=msg: messagebox.showwarning(
                            "Steam Review Cache Lag", m
                        ),
                    )
                else:
                    # HTML fallback also failed (common: reviews are loaded
                    # client-side via JS so the static HTML has no review data).
                    self._log(
                        "Storefront HTML did not contain a review summary either."
                    )
                    self._log(
                        "Most likely cause: Steam's JSON review cache is not yet "
                        "populated for this app (typical for new releases; can take 24-72 h)."
                    )
                    self.stats_label.configure(
                        text=(
                            "⚠ API returned 0 reviews. Likely Steam cache lag. "
                            "Try again in a few hours."
                        )
                    )
                    self.after(
                        0,
                        lambda: messagebox.showwarning(
                            "No Reviews Returned",
                            "The JSON review API returned 0 reviews for this app.\n\n"
                            f"App ID: {self.app_id}\n\n"
                            "Most likely cause: Steam's review cache is not yet "
                            "populated for this app. The storefront UI is cached "
                            "separately and can show reviews hours/days before the "
                            "API does. This is a known Steam backend delay.\n\n"
                            "Recommended actions:\n"
                            "  1. Wait a few hours / days and retry.\n"
                            "  2. Open the store page in your browser to verify "
                            "reviews are actually visible there.\n"
                            "  3. Try a different (older) App ID to confirm the "
                            "tool itself works.\n\n"
                            "This is NOT a bug in this tool — Steam is the bottleneck.",
                        ),
                    )
        except Exception as exc:  # pragma: no cover
            self._log(f"FATAL: {exc}")
        finally:
            self._set_busy(False)
            self.after(0, lambda: self.progress.set(1))
            # Save resume state if we were stopped mid-fetch.
            if (self._stop_event.is_set()
                    and self.app_id is not None
                    and last_cursor_holder[0]
                    and last_cursor_holder[0] != "*"):
                self._resume_set(
                    "api", self.app_id,
                    cursor=last_cursor_holder[0],
                    reviews=list(self.reviews),
                    language=self.lang_var.get(),
                    review_filter=self.filter_var.get(),
                    review_type=self.type_var.get(),
                )
                self._log(
                    f"Saved resume state at {len(self.reviews)} reviews. "
                    f"Click 'Resume' to continue."
                )
            else:
                # Natural completion: clear any stale resume state.
                self._resume_clear("api", self.app_id)

            # "Fetch new" auto-export: write only the new (un-seen)
            # reviews to a fresh .md under the per-game subfolder.
            if (getattr(self, "_fetch_new_auto_export", False)
                    and self.app_id is not None
                    and self.reviews):
                try:
                    game_name = (
                        (self.app_details or {}).get("name")
                        or f"app_{self.app_id}"
                    )
                    folder = self._get_game_dump_folder()
                    fname = make_export_basename(
                        game_name, f"fetchnew_{short_filter_label('api', self)}",
                    )
                    out_path = str(folder / fname)
                    self._log(
                        f"Auto-exporting {len(self.reviews)} new reviews to {out_path}"
                    )
                    self._do_export_to_path(
                        out_path, self.reviews,
                        source_label="fetchnew", update_seen_ids=True,
                    )
                except Exception as exc:
                    self._log(f"Auto-export after Fetch-new failed: {exc}")
                finally:
                    self._fetch_new_auto_export = False
            self.after(0, self._refresh_resume_buttons)

    def _on_progress(self, page: int, fetched: int, total: int) -> None:
        if total > 0:
            frac = min(1.0, fetched / total)
        else:
            frac = min(1.0, page / 50)  # heuristic when total unknown
        self.after(0, lambda: self.progress.set(frac))
        self.after(
            0,
            lambda: self.stats_label.configure(
                text=(
                    f"Page {page} · fetched {fetched} "
                    f"of {total} (server-reported)"
                )
            ),
        )

    def _on_stop(self) -> None:
        """Stop whatever fetch / scrape is currently running.

        The Stop button is shared between the two tabs. We set both
        stop events so the active worker (whichever it is) exits on
        its next loop iteration. We also kill any running Playwright
        subprocess so the user doesn't have to wait up to 15 min.
        """
        self._stop_event.set()
        self._pw_stop_event.set()
        if getattr(self, "_pw_subprocess", None) is not None:
            try:
                if self._pw_subprocess.poll() is None:
                    self._pw_log("Stop requested — killing browser subprocess…")
                    self._pw_subprocess.kill()
            except Exception:
                pass
        self._log("Stop requested.")

    # ------------------------------------------------------------------ watch

    def _on_watch_toggle(self) -> None:
        if self.watching:
            self._stop_watch()
        else:
            self._start_watch()

    def _start_watch(self) -> None:
        if self.app_id is None:
            messagebox.showinfo("No game", "Please load a game first.")
            return
        if self._watch_thread and self._watch_thread.is_alive():
            return

        backend = self.backend_var.get()
        if backend.startswith("Apify") and not (self.apify_entry.get() or "").strip():
            messagebox.showwarning(
                "Apify token missing",
                "You selected the Apify backend, which BYPASSES Steam's review cache "
                "and returns truly current data, but it requires a (free) Apify API token.\n\n"
                "Get one at https://console.apify.com/account/integrations\n"
                "Free tier: ~$5/month credit, ~5,000 reviews free.\n\n"
                "Switch the backend to 'Steam API' to poll without a token "
                "(limited to reviews already in Steam's cache, typically 24-72h lag for new apps).",
            )
            return

        self._watch_stop_event.clear()
        self._watch_new_reviews = []
        self._watch_session_count = 0
        self.watching = True

        self.watch_btn.configure(
            text="■ Stop Watching",
            fg_color="#a83232",
            hover_color="#822525",
        )
        self.fetch_btn.configure(state="disabled")
        self.export_btn.configure(state="disabled")
        self._log(
            f"▶ Watch mode started (backend: {backend}, "
            f"interval: {self.interval_var.get()} min)"
        )

        self._watch_thread = threading.Thread(target=self._watch_worker, daemon=True)
        self._watch_thread.start()

    def _stop_watch(self) -> None:
        self._watch_stop_event.set()
        self.watching = False
        self.watch_btn.configure(
            text="▶ Start Watching",
            fg_color="#8a5a00",
            hover_color="#6e4900",
        )
        self.fetch_btn.configure(state="normal")
        if self._watch_new_reviews:
            self.export_btn.configure(state="normal")
            self.stats_label.configure(
                text=(
                    f"Watch stopped. {len(self._watch_new_reviews)} new review(s) collected. "
                    f"Click 'Export to .md' to save."
                )
            )
        self._log(
            f"■ Watch mode stopped. {len(self._watch_new_reviews)} new review(s) "
            f"collected in this session."
        )

    def _watch_worker(self) -> None:
        assert self.app_id is not None
        backend = self.backend_var.get()
        apify_token = (self.apify_entry.get() or "").strip()
        interval_min = int(self.interval_var.get())
        poll_count = 0

        # "Auto-incremental" mode: dedup against per-game seen_ids.json
        # so the watch only ever reports TRULY new reviews and writes
        # a fresh .md for each batch. The user can toggle this via the
        # auto_incremental_watch setting.
        auto_incr = bool(self.auto_incremental_watch_var.get() == "1") \
            if hasattr(self, "auto_incremental_watch_var") else False

        # First poll immediately
        while not self._watch_stop_event.is_set():
            poll_count += 1
            self.after(
                0,
                lambda c=poll_count, b=backend: self._log(
                    f"[Watch #{c}] Polling {b}…"
                ),
            )
            try:
                if backend.startswith("Apify"):
                    # Apify: bypasses cache, returns ALL reviews from page.
                    # We diff against seen set so we only show TRULY new ones.
                    items = self.api.fetch_via_apify(
                        app_id=self.app_id,
                        apify_token=apify_token,
                        max_items=100,
                        sort="recent",
                        language="all",
                    )
                    new_reviews = []
                    for rv in items:
                        rid = rv.get("recommendationid")
                        if rid and rid not in self.api._seen_review_ids:
                            self.api._seen_review_ids.add(rid)
                            new_reviews.append(rv)
                else:
                    new_reviews = self.api.poll_recent_reviews(
                        app_id=self.app_id,
                        max_pages=1,
                        page_size=100,
                        language="all",
                    )
            except Exception as exc:
                self.after(0, lambda e=exc: self._log(f"[Watch] Error: {e}"))
                new_reviews = []

            # Auto-incremental: drop reviews we've already exported so
            # the watch only ever reports TRULY new ones.
            if auto_incr and new_reviews:
                seen = self._load_seen_ids()
                before = len(new_reviews)
                new_reviews = [
                    r for r in new_reviews
                    if str(r.get("recommendationid") or "") not in seen
                ]
                dropped = before - len(new_reviews)
                if dropped:
                    self.after(0, lambda d=dropped, c=poll_count: self._log(
                        f"[Watch #{c}] Auto-incr: dropped {d} already-exported."
                    ))

            self._watch_session_count += len(new_reviews)
            if new_reviews:
                self._watch_new_reviews.extend(new_reviews)
                self.after(
                    0,
                    lambda nr=new_reviews, c=poll_count: self._on_new_reviews(nr, c),
                )
                # Auto-incremental: write a fresh .md for this batch.
                if auto_incr:
                    self.after(0, lambda nr=tuple(new_reviews): self._auto_incr_export(nr))
            else:
                self.after(
                    0,
                    lambda c=poll_count, b=backend: self._log(
                        f"[Watch #{c}] No new reviews from {b}."
                    ),
                )

            # Sleep with cancellation checks every second
            self.after(
                0,
                lambda c=poll_count: self.stats_label.configure(
                    text=(
                        f"Watching… (poll #{c} done, "
                        f"{self._watch_session_count} new this session, "
                        f"next check in {interval_min} min)"
                    )
                ),
            )
            for _ in range(interval_min * 60):
                if self._watch_stop_event.is_set():
                    return
                time.sleep(1)

    def _auto_incr_export(self, new_reviews_tuple) -> None:
        """Write a fresh .md for the latest batch of watch-mode reviews.

        Called from the watch worker when auto-incremental is enabled.
        Saves to the per-game dump folder using the same short filename
        format as the manual exports.
        """
        new_reviews = list(new_reviews_tuple)
        if not new_reviews or self.app_id is None:
            return
        try:
            folder = self._get_game_dump_folder()
        except Exception as exc:
            self._log(f"Auto-incr export: folder error: {exc}")
            return
        try:
            game_name = (
                (self.app_details or {}).get("name")
                or f"app_{self.app_id}"
            )
            fname = make_export_basename(
                game_name, f"watch_{short_filter_label('api', self)}"
            )
            out_path = str(folder / fname)
            self._do_export_to_path(
                out_path, new_reviews,
                source_label="watch", update_seen_ids=True,
            )
        except Exception as exc:
            self._log(f"Auto-incr export failed: {exc}")

    def _on_new_reviews(self, new_reviews: list[dict], poll_count: int) -> None:
        self._log(
            f"🔔 [Watch #{poll_count}] {len(new_reviews)} NEW review(s) detected!"
        )
        for rv in new_reviews:
            author = (rv.get("author") or {}).get("steamid", "?")
            lang = rv.get("language", "?")
            voted = "👍" if rv.get("voted_up") else "👎"
            ts = rv.get("timestamp_created", 0)
            ts_str = (
                datetime.fromtimestamp(ts, tz=timezone.utc).strftime(
                    "%Y-%m-%d %H:%M:%S UTC"
                ) if ts else "—"
            )
            text = (rv.get("review") or "").strip().replace("\n", " ")
            preview = text[:140] + ("…" if len(text) > 140 else "")
            self._log(
                f"   {voted} {ts_str} | {lang} | user {author}: {preview}"
            )
        # Enable export button so user can save
        self.export_btn.configure(state="normal")

    def _export_split_write(
        self,
        path: str,
        reviews: list[dict],
        export_ctx: ExportContext,
        watch_note: str = "",
        split_per: int = 0,
    ) -> int:
        """Write `reviews` to `path` (or multiple files if `split_per > 0`).

        Returns the number of files actually written.
        """
        if not reviews:
            return 0
        # Compute chunk size: 0 means single file.
        try:
            chunk = int(split_per or 0)
        except (TypeError, ValueError):
            chunk = 0

        if chunk <= 0 or len(reviews) <= chunk:
            # Single file
            ctx = ExportContext(**{**export_ctx.__dict__, "reviews": reviews})
            md = MarkdownExporter.render(ctx)
            if watch_note:
                md = watch_note + md
            out = Path(path)
            out.parent.mkdir(parents=True, exist_ok=True)
            out.write_text(md, encoding="utf-8")
            return 1

        # Multiple files: split path into base + ext, append _partN.md
        p = Path(path)
        base = p.with_suffix("")
        ext = p.suffix or ".md"
        p.parent.mkdir(parents=True, exist_ok=True)
        chunks = [reviews[i:i + chunk] for i in range(0, len(reviews), chunk)]
        for i, sub in enumerate(chunks, 1):
            chunk_path = f"{base}_part{i}{ext}"
            ctx = ExportContext(**{**export_ctx.__dict__, "reviews": sub})
            md = MarkdownExporter.render(ctx, include_header=(i == 1))
            if i == 1 and watch_note:
                md = watch_note + md
            Path(chunk_path).write_text(md, encoding="utf-8")
        return len(chunks)

    def _on_export(self) -> None:
        if self.app_id is None:
            messagebox.showinfo("Nothing to export", "Load a game first.")
            return

        # Prefer watch-mode new reviews if any were collected
        reviews_to_export = self._watch_new_reviews or self.reviews
        if not reviews_to_export:
            messagebox.showinfo(
                "Nothing to export",
                "No reviews collected yet. Click 'Fetch Reviews' or 'Start Watching' first.",
            )
            return

        # Build a short suggested filename in the per-game subfolder.
        # The user can still pick a different folder/name via the
        # save dialog.
        game_name = (self.app_details or {}).get("name") or f"app_{self.app_id}"
        source_label = "watch" if self._watch_new_reviews else "fetch"
        filter_lbl = short_filter_label("api", self)
        default_name = make_export_basename(game_name, f"{source_label}_{filter_lbl}")
        try:
            initial_dir = str(self._get_game_dump_folder())
        except Exception:
            initial_dir = str(self._get_dump_root())
        path = filedialog.asksaveasfilename(
            title=f"Export {source_label} reviews to Markdown",
            defaultextension=".md",
            initialdir=initial_dir,
            initialfile=default_name,
            filetypes=[("Markdown", "*.md"), ("All files", "*.*")],
        )
        if not path:
            return

        self._do_export_to_path(
            path, reviews_to_export, source_label=source_label,
        )

    def _do_export_to_path(
        self,
        path: str,
        reviews_to_export: list[dict],
        source_label: str = "fetch",
        update_seen_ids: bool = True,
    ) -> None:
        """Write the given reviews to `path` (single file or split files).

        Optionally appends the new reviews' recommendationids to the
        per-game seen_ids.json (used by the "Fetch new" flow to
        skip already-dumped reviews on the next run).
        """
        try:
            split_per = int((self.api_split_var.get() or "0").strip() or "0")
        except ValueError:
            split_per = 0

        export_ctx = ExportContext(
            app_id=self.app_id,
            app_details=self.app_details,
            reviews=reviews_to_export,
            language_param=self.lang_var.get(),
            review_filter=("recent" if source_label == "watch" else self.filter_var.get()),
            review_type=self.type_var.get(),
            day_range=self._parse_day_range(),
            min_date_ts=self._parse_min_date(),
            keyword_list=self._get_keyword_list(),
        )
        # Header note for watch-mode exports
        watch_note = ""
        if source_label == "watch":
            watch_note = (
                f"\n## Watch-Mode Export\n\n"
                f"- Source: {source_label}\n"
                f"- Reviews: {len(reviews_to_export)} (new since watching started)\n"
                f"- Polling interval: {self.interval_var.get()} minutes\n"
                f"- Backend: {self.backend_var.get()}\n\n"
            )
        try:
            n_files = self._export_split_write(
                path, reviews_to_export, export_ctx,
                watch_note=watch_note, split_per=split_per,
            )
        except OSError as exc:
            # messagebox must be shown on the main thread; this method
            # can be called from a worker (auto-export after Fetch-new).
            self.after(0, lambda e=exc: messagebox.showerror("Save failed", str(e)))
            return

        if n_files == 1:
            self._log(f"Exported {len(reviews_to_export)} {source_label} reviews to {path}")
            self.after(
                0,
                lambda: messagebox.showinfo(
                    "Export complete",
                    f"Wrote {len(reviews_to_export)} {source_label} reviews to:\n{path}",
                ),
            )
        else:
            base = Path(path).with_suffix("")
            ext = Path(path).suffix or ".md"
            self._log(
                f"Exported {len(reviews_to_export)} {source_label} reviews "
                f"into {n_files} files (split per {split_per})."
            )
            self.after(
                0,
                lambda: messagebox.showinfo(
                    "Export complete",
                    f"Wrote {len(reviews_to_export)} reviews to {n_files} files:\n"
                    f"  {base}_part1{ext}\n  ...\n  {base}_part{n_files}{ext}",
                ),
            )

        # Record the dumped review IDs in seen_ids.json so a future
        # "Fetch new" run can skip them.
        if update_seen_ids:
            ids = [
                str(r.get("recommendationid") or "")
                for r in reviews_to_export
                if r.get("recommendationid")
            ]
            if ids:
                self._save_seen_ids(ids)
                self._refresh_dump_label()

        # Optional: also write CSV and/or JSON next to the .md.
        # We use the same base filename so the user can correlate
        # the three files easily.
        try:
            if n_files == 1 and Path(path).suffix.lower() == ".md":
                base = str(Path(path).with_suffix(""))
                if self._also_csv():
                    try:
                        MarkdownExporter.reviews_to_csv(
                            reviews_to_export, base + ".csv"
                        )
                        self._log(f"  + CSV: {base}.csv")
                    except Exception as exc:
                        self._log(f"  CSV write failed: {exc}")
                if self._also_json():
                    try:
                        MarkdownExporter.reviews_to_json(
                            reviews_to_export, base + ".json"
                        )
                        self._log(f"  + JSON: {base}.json")
                    except Exception as exc:
                        self._log(f"  JSON write failed: {exc}")
                # Per-language sub-exports
                if self._per_language():
                    try:
                        n_lang = MarkdownExporter.write_per_language(
                            reviews_to_export, base, export_ctx,
                        )
                        if n_lang:
                            self._log(
                                f"  + {n_lang} per-language .md files"
                            )
                    except Exception as exc:
                        self._log(f"  Per-language export failed: {exc}")
                # Obsidian-vault secondary copy (after all .md/.csv/.json
                # are written). Only if the export was a single file
                # (otherwise we'd have to copy every _partN.md).
                self._copy_to_obsidian_vault(path)
        except Exception as exc:
            self._log(f"Optional export failed: {exc}")

    def _also_csv(self) -> bool:
        try:
            return getattr(self, "also_export_csv_var", None) and \
                self.also_export_csv_var.get() == "1"
        except Exception:
            return False

    def _also_json(self) -> bool:
        try:
            return getattr(self, "also_export_json_var", None) and \
                self.also_export_json_var.get() == "1"
        except Exception:
            return False

    def _per_language(self) -> bool:
        try:
            return getattr(self, "per_language_var", None) and \
                self.per_language_var.get() == "1"
        except Exception:
            return False

    def _get_keyword_list(self) -> list[str]:
        """Return the user-configured keyword list, or
        DEFAULT_KEYWORD_TAGS if nothing is set.
        """
        raw = ""
        if hasattr(self, "keywords_text") and self.keywords_text is not None:
            try:
                raw = self.keywords_text.get("1.0", "end")
            except Exception:
                raw = ""
        if not raw:
            return list(DEFAULT_KEYWORD_TAGS)
        # Parse comma-separated, strip whitespace, drop empty
        out = []
        for piece in raw.replace("\n", ",").split(","):
            t = piece.strip()
            if t:
                out.append(t)
        return out or list(DEFAULT_KEYWORD_TAGS)

    def _get_ai_prompt_template(self) -> str:
        """Return the user-configured AI prompt template, or a sensible
        default if nothing is set.
        """
        default = (
            "You are a QA analyst for the game '{name}' (App ID {app_id}).\n"
            "Below is a dump of recent Steam reviews. Identify:\n"
            "  1. The top 3 bugs (with example quotes and review IDs)\n"
            "  2. The top 3 improvement suggestions (with quotes)\n"
            "  3. The top 3 things players are praising\n"
            "  4. Any patterns that suggest a recent regression\n"
            "Format the answer as Markdown. Be specific, cite review IDs.\n"
            "\n--- Reviews below ---\n"
        )
        if hasattr(self, "ai_prompt_text") and self.ai_prompt_text is not None:
            try:
                raw = self.ai_prompt_text.get("1.0", "end").strip()
            except Exception:
                raw = ""
        else:
            raw = ""
        return raw or default

    def _format_ai_prompt(self, dump_text: str) -> str:
        """Return the AI prompt template with placeholders filled in and
        the dump text appended.
        """
        tpl = self._get_ai_prompt_template()
        name = (self.app_details or {}).get("name") or f"app_{self.app_id}"
        try:
            out = tpl.format(
                name=name,
                app_id=self.app_id,
                n=len(self._watch_new_reviews or self.reviews or self.pw_reviews or []),
            )
        except Exception:
            out = tpl  # if format fails, use raw template
        return out + "\n" + dump_text + "\n"

    def _on_settings(self) -> None:
        """Open the settings dialog (keyword list, AI prompt template)."""
        # Lazy-create the text widgets if the dialog has never been opened.
        if self.keywords_text is None:
            # We use a hidden 1x1 Textbox so settings can persist between
            # dialog opens without the user having to re-save.
            self.keywords_text = ctk.CTkTextbox(self, height=10, width=10)
            self.keywords_text.insert("1.0", ", ".join(DEFAULT_KEYWORD_TAGS))
            # Try to restore from settings
            saved = (self._settings_load_raw() or {}).get("keywords_text", "")
            if saved:
                try:
                    self.keywords_text.delete("1.0", "end")
                    self.keywords_text.insert("1.0", saved)
                except Exception:
                    pass
        if self.ai_prompt_text is None:
            self.ai_prompt_text = ctk.CTkTextbox(self, height=10, width=10)
            # Default already loaded by _get_ai_prompt_template fallback.
        SettingsDialog(self).open()

    def _on_copy_with_ai_prompt(self) -> None:
        """Build the AI prompt + latest dump and put it on the clipboard."""
        if self.app_id is None:
            messagebox.showinfo("No game", "Load a game first.")
            return
        try:
            folder = self._get_game_dump_folder()
        except Exception as exc:
            self._log(f"Could not resolve game folder: {exc}")
            return
        # Find the latest .md
        md_files = sorted(
            folder.glob("GQA Reviewdump_*.md"),
            key=lambda p: p.stat().st_mtime, reverse=True,
        )
        if not md_files:
            messagebox.showinfo(
                "No dump found",
                f"No GQA Reviewdump_*.md in {folder}. Run a fetch first.",
            )
            return
        latest = md_files[0]
        try:
            text = latest.read_text(encoding="utf-8")
        except OSError as exc:
            messagebox.showerror("Read failed", str(exc))
            return
        prompt = self._format_ai_prompt(text)
        try:
            self.clipboard_clear()
            self.clipboard_append(prompt)
        except Exception:
            pass
        try:
            self.update()  # flush
        except Exception:
            pass
        self._log(
            f"Copied AI prompt + dump ({len(prompt):,} chars) to clipboard."
        )
        messagebox.showinfo(
            "Copied to clipboard",
            f"AI prompt + latest dump ({len(prompt):,} chars) copied.\n"
            f"Source: {latest.name}\n"
            "Paste into ChatGPT / Claude / your LLM of choice.",
        )

    def _on_save_as_prompt(self) -> None:
        """Save the AI prompt + latest dump to a .md file in the per-game
        folder so the user can attach it to an email / ticket / LLM later.
        """
        if self.app_id is None:
            messagebox.showinfo("No game", "Load a game first.")
            return
        try:
            folder = self._get_game_dump_folder()
        except Exception as exc:
            self._log(f"Could not resolve game folder: {exc}")
            return
        md_files = sorted(
            folder.glob("GQA Reviewdump_*.md"),
            key=lambda p: p.stat().st_mtime, reverse=True,
        )
        if not md_files:
            messagebox.showinfo(
                "No dump found",
                f"No GQA Reviewdump_*.md in {folder}.",
            )
            return
        latest = md_files[0]
        try:
            text = latest.read_text(encoding="utf-8")
        except OSError as exc:
            messagebox.showerror("Read failed", str(exc))
            return
        prompt = self._format_ai_prompt(text)
        out_path = folder / "ai_prompt.md"
        try:
            out_path.write_text(prompt, encoding="utf-8")
        except OSError as exc:
            messagebox.showerror("Save failed", str(exc))
            return
        self._log(f"Saved AI-prompt bundle to: {out_path}")
        messagebox.showinfo(
            "AI-prompt bundle saved",
            f"Wrote the AI prompt + latest dump to:\n{out_path}\n"
            "Attach this file to your LLM or paste its contents.",
        )

    def _on_open_latest_md(self) -> None:
        """Open the latest .md in the OS default app (Notepad, VSCode, etc.)."""
        if self.app_id is None:
            messagebox.showinfo("No game", "Load a game first.")
            return
        try:
            folder = self._get_game_dump_folder()
        except Exception as exc:
            self._log(f"Could not resolve game folder: {exc}")
            return
        md_files = sorted(
            folder.glob("GQA Reviewdump_*.md"),
            key=lambda p: p.stat().st_mtime, reverse=True,
        )
        if not md_files:
            messagebox.showinfo("No dump", "No GQA Reviewdump_*.md yet.")
            return
        latest = md_files[0]
        try:
            if sys.platform == "win32":
                os.startfile(str(latest))  # noqa: S606
            elif sys.platform == "darwin":
                import subprocess
                subprocess.Popen(["open", str(latest)])
            else:
                import subprocess
                subprocess.Popen(["xdg-open", str(latest)])
        except Exception as exc:
            self._log(f"Open file failed: {exc}")
            messagebox.showerror("Open failed", str(exc))

    def _on_quick_view_negatives(self) -> None:
        """Open the SearchWindow pre-filtered to negative reviews only."""
        if self.app_id is None:
            messagebox.showinfo("No game", "Load a game first.")
            return
        # Open the regular search window
        self._on_search_dump()
        # And if it's open, pre-set the sentiment filter
        try:
            for w in self.winfo_children():
                if w.title().startswith("Search:"):
                    # find the sentiment OptionMenu (we set value="all" by default)
                    # the only OptionMenu we have is sentiment, with values
                    # ["all", "positive", "negative"]
                    for child in w.winfo_children():
                        try:
                            if child.cget("values") == ["all", "positive", "negative"]:
                                child.set("negative")
                                break
                        except Exception:
                            pass
        except Exception:
            pass

    def _on_top_complaints(self) -> None:
        """Open a popup with the top-5 complaint / praise themes."""
        if self.app_id is None:
            messagebox.showinfo("No game", "Load a game first.")
            return
        reviews = self._watch_new_reviews or self.reviews or self.pw_reviews
        if not reviews:
            messagebox.showinfo("No reviews", "Fetch reviews first.")
            return
        TopComplaintsDialog(self, reviews, list(self._get_keyword_list())).open()

    def _on_copy_filtered_dump(self, sentiment: str) -> None:
        """Copy a sentiment-filtered dump to the clipboard (for AI ingestion)."""
        if self.app_id is None:
            messagebox.showinfo("No game", "Load a game first.")
            return
        reviews = self._watch_new_reviews or self.reviews or self.pw_reviews
        if not reviews:
            messagebox.showinfo("No reviews", "Fetch reviews first.")
            return
        if sentiment == "negative":
            filtered = [r for r in reviews if not r.get("voted_up")]
        elif sentiment == "positive":
            filtered = [r for r in reviews if r.get("voted_up")]
        else:
            filtered = list(reviews)
        if not filtered:
            messagebox.showinfo(
                "Empty", f"No {sentiment} reviews in the current dump."
            )
            return
        # Build a temporary dump
        ctx = ExportContext(
            app_id=self.app_id,
            app_details=self.app_details,
            reviews=filtered,
            language_param=self.lang_var.get() if hasattr(self, "lang_var") else "all",
            review_filter=self.filter_var.get() if hasattr(self, "filter_var") else "recent",
            review_type=self.type_var.get() if hasattr(self, "type_var") else "all",
            day_range=None,
            min_date_ts=None,
            keyword_list=self._get_keyword_list(),
        )
        text = MarkdownExporter.render(ctx, include_header=True)
        prompt = self._format_ai_prompt(text)
        try:
            self.clipboard_clear()
            self.clipboard_append(prompt)
        except Exception:
            pass
        self._log(
            f"Copied {sentiment} dump ({len(filtered)} reviews, "
            f"{len(prompt):,} chars) to clipboard."
        )
        messagebox.showinfo(
            "Copied",
            f"{len(filtered)} {sentiment} review(s) + AI prompt copied.",
        )

    def _on_batch_dump(self) -> None:
        """Open a dialog that accepts a list of App IDs and dumps each
        one in turn. Skips games that already have their
        seen_ids.json up to date.
        """
        dlg = BatchDumpDialog(self)
        dlg.open()

    def _on_search_dump(self) -> None:
        """Open a search popup over the latest .md dump in the per-game folder."""
        if self.app_id is None:
            messagebox.showinfo("No game", "Load a game first.")
            return
        try:
            folder = self._get_game_dump_folder()
        except Exception as exc:
            self._log(f"Could not resolve game folder: {exc}")
            return
        # Find the latest .md (prefer the most recent GQA Reviewdump_* file).
        md_files = sorted(
            folder.glob("GQA Reviewdump_*.md"),
            key=lambda p: p.stat().st_mtime, reverse=True,
        )
        if not md_files:
            messagebox.showinfo(
                "No dump found",
                f"No GQA Reviewdump_*.md file found in {folder}.\n"
                "Run a fetch and export first.",
            )
            return
        latest = md_files[0]
        try:
            text = latest.read_text(encoding="utf-8")
        except OSError as exc:
            messagebox.showerror("Read failed", str(exc))
            return
        SearchWindow(self, latest.name, text, str(latest))

    def _on_write_summary(self) -> None:
        """Write a `summary.md` next to the current game's dump folder
        with reviewer stats (totals, language distribution, top
        reviewers by playtime, word frequency, etc.).
        """
        if self.app_id is None:
            messagebox.showinfo("No game", "Load a game first.")
            return
        # Prefer the in-memory reviews; fall back to scraping seen_ids.
        reviews = self._watch_new_reviews or self.reviews or self.pw_reviews
        if not reviews:
            messagebox.showinfo(
                "Nothing to summarize",
                "No reviews collected yet. Click 'Fetch Reviews' or "
                "'Start Watching' first.",
            )
            return
        try:
            folder = self._get_game_dump_folder()
        except Exception as exc:
            self._log(f"Could not resolve game folder: {exc}")
            return
        summary_path = folder / "summary.md"
        try:
            md = MarkdownExporter.build_summary(reviews, self.app_details)
            summary_path.write_text(md, encoding="utf-8")
            self._log(f"Wrote summary: {summary_path}")
            messagebox.showinfo(
                "Summary written",
                f"Reviewer stats saved to:\n{summary_path}",
            )
        except OSError as exc:
            self._log(f"Summary write failed: {exc}")
            messagebox.showerror("Save failed", str(exc))

    def _on_open_store(self) -> None:
        if self.app_id is None:
            return
        webbrowser.open(f"https://store.steampowered.com/app/{self.app_id}/")

    # ------------------------------------------------------------------ playwright

    def _pw_log(self, msg: str) -> None:
        # Thread-safe: schedule the insert on the main thread.
        ts = datetime.now().strftime("%H:%M:%S")
        try:
            self.after(
                0,
                lambda m=msg, t=ts: (
                    self.pw_log.insert("end", f"[{t}] {m}\n"),
                    self.pw_log.see("end"),
                ),
            )
        except Exception:
            try:
                self.pw_log.insert("end", f"[{ts}] {msg}\n")
                self.pw_log.see("end")
            except Exception:
                pass

    def _on_pw_load(self) -> None:
        """Load a game from the Playwright tab's own input field."""
        raw = self.pw_input_entry.get()
        if not raw and self.app_id is not None:
            # Fall back to whatever was loaded in Tab 1
            self._log("Using game from Steam API tab.")
            return
        if not raw:
            messagebox.showerror(
                "Invalid input",
                "Please enter a Steam App ID or store URL.",
            )
            return
        app_id = self.api.resolve_app_id(raw)
        if app_id is None:
            messagebox.showerror(
                "Invalid input",
                "Could not extract an App ID from your input.\n"
                "Examples: 4311090  or  "
                "https://store.steampowered.com/app/4311090/…",
            )
            return
        self._log(f"Loading app {app_id} (from Playwright tab)…")
        try:
            details = self.api.get_app_details(app_id, "english")
        except Exception as exc:
            details = None
            self._log(f"App details error: {exc}")
        if not details:
            messagebox.showerror("Not found", f"App ID {app_id} could not be loaded.")
            # Clear the previously loaded game so a stale id does not
            # leak into the next Playwright scrape.
            self._clear_loaded_game()
            return
        self.app_id = app_id
        self.app_details = details
        name = details.get("name", f"App {app_id}")
        self.details_title.configure(text=name)
        self.details_meta.configure(
            text=(
                f"App ID: {app_id}    •    "
                f"Loaded from Playwright tab"
            )
        )
        self.pw_game_label.configure(
            text=f"{name} (ID {app_id})", text_color=("black", "white")
        )
        self._log(f"Loaded '{name}' (ID {app_id}).")
        # Mirror to the Steam API tab input for consistency
        if hasattr(self, "input_entry"):
            self.input_entry.delete(0, "end")
            self.input_entry.insert(0, str(app_id))
        # Persist immediately
        self._settings_save()
        # Auto-add the just-loaded app to the trends list (if not
        # already tracked) so the user can see the wishlist/follower
        # graph grow over time without any extra clicks.
        try:
            if self.app_details is not None and self.app_id is not None:
                store = self._get_trends_store()
                if not store.is_tracked(self.app_id):
                    store.add(
                        self.app_id,
                        self.app_details.get("name") or f"app_{self.app_id}",
                    )
                    self._refresh_trends_list()
        except Exception:
            pass
        # "New since last visit" badge: how many review IDs are in
        # the current seen_ids.json that we haven't shown the user yet.
        # (i.e. how many new reviews exist for this game since the
        # last time the user opened it in the tool).
        try:
            self._update_info_panels()
        except Exception:
            pass
        # Refresh the Resume buttons to reflect any saved state.
        self.after(0, self._refresh_resume_buttons)

    def _refresh_dep_status(self) -> None:
        """Check Playwright + Chromium status and update the labels."""
        try:
            pw_ok = self.api.is_playwright_available()
        except Exception as e:
            pw_ok = False
            self.after(0, lambda e=e: self._pw_log(f"Playwright check error: {e}"))

        if pw_ok:
            self.after(
                0,
                lambda: self.pw_pkg_status.configure(
                    text="✓ installed", text_color="#2d7a2d"
                ),
            )
            self.after(0, lambda: self.pw_install_pkg_btn.configure(state="disabled"))
            try:
                chrome_ok = self.api.is_chromium_installed()
            except Exception:
                chrome_ok = False
            if chrome_ok:
                self.after(
                    0,
                    lambda: self.pw_chrome_status.configure(
                        text="✓ installed", text_color="#2d7a2d"
                    ),
                )
                self.after(0, lambda: self.pw_install_chrome_btn.configure(state="disabled"))
                self.after(0, lambda: self.pw_scrape_btn.configure(state="normal"))
            else:
                self.after(
                    0,
                    lambda: self.pw_chrome_status.configure(
                        text="✗ not installed (~150 MB download)",
                        text_color="#a83232",
                    ),
                )
                self.after(0, lambda: self.pw_scrape_btn.configure(state="disabled"))
        else:
            self.after(
                0,
                lambda: self.pw_pkg_status.configure(
                    text="✗ not installed (click button to install)",
                    text_color="#a83232",
                ),
            )
            self.after(0, lambda: self.pw_install_pkg_btn.configure(state="normal"))
            self.after(0, lambda: self.pw_install_chrome_btn.configure(state="disabled"))
            self.after(
                0,
                lambda: self.pw_chrome_status.configure(
                    text="(install playwright first)", text_color="gray"
                ),
            )
            self.after(0, lambda: self.pw_scrape_btn.configure(state="disabled"))

    def _on_install_playwright(self) -> None:
        if self.pw_installing_pkg:
            return
        self.pw_installing_pkg = True
        self.pw_install_pkg_btn.configure(state="disabled", text="Installing…")
        self._pw_log("Installing playwright package via pip (this may take 1-2 min)…")

        def worker():
            try:
                import subprocess
                import tempfile
                # We can't use sys.executable -m pip when running inside a
                # PyInstaller .exe (it would just re-launch the GUI).
                # Instead: find a working Python on the system and run a
                # helper script via that interpreter.
                python_exe = self._find_working_python()
                if not python_exe:
                    raise RuntimeError(
                        "Could not find a working Python interpreter on the system.\n"
                        "Please install Python 3.10+ from https://www.python.org/downloads/\n"
                        "(make sure to tick 'Add Python to PATH' during install),\n"
                        "then click 'Install Playwright' again."
                    )
                self.after(
                    0,
                    lambda p=python_exe: self._pw_log(f"Using Python: {p}"),
                )

                helper = Path(tempfile.gettempdir()) / "_srt_install_pw.py"
                helper.write_text(
                    "import subprocess, sys\n"
                    "rc = subprocess.call([sys.executable, '-m', 'pip', 'install', 'playwright'])\n"
                    "sys.exit(rc)\n",
                    encoding="utf-8",
                )
                result = subprocess.run(
                    [python_exe, str(helper)],
                    capture_output=True, text=True, timeout=300,
                )
                if result.returncode == 0:
                    self.after(0, lambda: self._pw_log(
                        f"✓ Playwright installed successfully.\n{result.stdout.strip()[-500:]}"
                    ))
                else:
                    # Try bootstrapping pip if missing
                    stderr = (result.stderr or "") + (result.stdout or "")
                    if "No module named pip" in stderr or "pip" in stderr.lower() and "module" in stderr.lower():
                        self.after(0, lambda: self._pw_log(
                            "pip missing in target Python, bootstrapping from get-pip.py…"
                        ))
                        try:
                            import urllib.request
                            tmp = Path(tempfile.gettempdir()) / "get-pip.py"
                            urllib.request.urlretrieve(
                                "https://bootstrap.pypa.io/get-pip.py", str(tmp)
                            )
                            boot = subprocess.run(
                                [python_exe, str(tmp)],
                                capture_output=True, text=True, timeout=120,
                            )
                            if boot.returncode != 0:
                                raise RuntimeError(boot.stderr or boot.stdout)
                            self.after(0, lambda: self._pw_log(
                                "pip bootstrapped. Retrying playwright install…"
                            ))
                            result = subprocess.run(
                                [python_exe, str(helper)],
                                capture_output=True, text=True, timeout=300,
                            )
                            if result.returncode != 0:
                                raise RuntimeError(result.stderr or result.stdout)
                            self.after(0, lambda: self._pw_log(
                                "✓ Playwright installed after pip bootstrap."
                            ))
                        except Exception as e2:
                            raise RuntimeError(
                                f"Bootstrap failed: {e2}\n"
                                "Please install Python with pip manually."
                            )
                    else:
                        raise RuntimeError(
                            f"Install failed (exit {result.returncode}):\n"
                            f"{stderr[-800:]}"
                        )
            except Exception as e:
                self.after(0, lambda e=e: self._pw_log(f"❌ {e}"))
                self.after(0, lambda: self.pw_install_pkg_btn.configure(
                    state="normal", text="Install Playwright"
                ))
                self.pw_installing_pkg = False
                return

            self.pw_installing_pkg = False
            self.after(0, lambda: self.pw_install_pkg_btn.configure(
                text="✓ Installed", state="disabled"
            ))
            self.after(0, self._refresh_dep_status)

        threading.Thread(target=worker, daemon=True).start()

    def _find_working_python(self) -> Optional[str]:
        """Find a Python interpreter that can run pip and import packages.

        Delegates to ``SteamAPI._find_external_python`` so that the
        install helpers and the post-install availability probes
        always agree on which interpreter they are talking to.
        """
        return SteamAPI._find_external_python()

    def _on_install_chromium(self) -> None:
        if self.pw_installing_chrome:
            return
        if not self.api.is_playwright_available():
            messagebox.showwarning(
                "Playwright missing",
                "Please install the playwright package first.",
            )
            return

        self.pw_installing_chrome = True
        self.pw_install_chrome_btn.configure(state="disabled", text="Downloading…")
        self._pw_log(
            "Downloading Chromium browser for Playwright (~150 MB, may take 1-3 min)…"
        )
        self.pw_progress.configure(mode="indeterminate")
        self.pw_progress.start()

        def worker():
            try:
                import subprocess
                import tempfile
                # Same issue: don't use sys.executable -m playwright in .exe.
                python_exe = self._find_working_python()
                if not python_exe:
                    raise RuntimeError(
                        "Could not find a working Python interpreter to run "
                        "'playwright install'."
                    )
                helper = Path(tempfile.gettempdir()) / "_srt_install_chrome.py"
                helper.write_text(
                    "import subprocess, sys\n"
                    "rc = subprocess.call([sys.executable, '-m', 'playwright', 'install', 'chromium'])\n"
                    "sys.exit(rc)\n",
                    encoding="utf-8",
                )
                result = subprocess.run(
                    [python_exe, str(helper)],
                    capture_output=True, text=True, timeout=600,
                )
                if result.returncode != 0:
                    raise RuntimeError(
                        (result.stderr or result.stdout or "Unknown error")[-1000:]
                    )
                self.after(0, lambda: self._pw_log("✓ Chromium downloaded."))
            except Exception as e:
                self.after(0, lambda e=e: self._pw_log(f"Chromium install failed: {e}"))
            finally:
                self.pw_installing_chrome = False
                self.after(0, lambda: self.pw_progress.stop())
                self.after(0, lambda: self.pw_progress.set(1))
                self.after(0, self._refresh_dep_status)

        threading.Thread(target=worker, daemon=True).start()

    def _on_open_pw_cache(self) -> None:
        """Open Playwright's browser cache folder."""
        cache = Path.home() / "AppData" / "Local" / "ms-playwright"
        if not cache.exists():
            messagebox.showinfo(
                "Cache folder",
                f"Playwright cache folder does not exist yet:\n{cache}\n\n"
                "It will be created when you install Chromium.",
            )
            return
        try:
            if sys.platform == "win32":
                os.startfile(str(cache))  # noqa: S606
            else:
                import subprocess
                subprocess.run(["xdg-open", str(cache)])
        except Exception as e:
            messagebox.showerror("Open failed", str(e))

    def _on_pw_scrape(self) -> None:
        if self.app_id is None:
            messagebox.showinfo("No game", "Please load a game in the Steam API tab first.")
            return
        if self._pw_thread and self._pw_thread.is_alive():
            return
        if not self.api.is_playwright_available():
            messagebox.showwarning(
                "Playwright not installed",
                "Click 'Install Playwright' first, then 'Install Chromium'.",
            )
            return
        if not self.api.is_chromium_installed():
            messagebox.showwarning(
                "Chromium not installed",
                "Click 'Install Chromium' first (~150 MB download).",
            )
            return

        # Clear any resume state from a previous run; this is a fresh scrape.
        self._resume_clear("pw", self.app_id)

        self.pw_reviews = []
        self.pw_progress.set(0)
        self.pw_progress.configure(mode="indeterminate")
        self.pw_progress.start()
        self.pw_export_btn.configure(state="disabled")
        self.pw_status_label.configure(text="Scraping…")
        self.pw_scrape_btn.configure(state="disabled", text="Scraping…")
        # Cross-tab: disable the Steam API tab's buttons too so the user
        # cannot kick off a second long-running operation in parallel.
        self._set_busy(True)
        self._pw_stop_event.clear()
        self._pw_thread = threading.Thread(
            target=self._pw_scrape_worker, args=("*", 0), daemon=True
        )
        self._pw_thread.start()

    def _on_pw_resume(self) -> None:
        """Continue a previously-stopped Playwright scrape."""
        if self.app_id is None:
            messagebox.showinfo("No game", "Please load a game first.")
            return
        if self._pw_thread and self._pw_thread.is_alive():
            return
        if not self.api.is_playwright_available() or not self.api.is_chromium_installed():
            messagebox.showwarning(
                "Playwright not ready",
                "Playwright + Chromium must be installed first.",
            )
            return
        state = self._resume_get("pw", self.app_id)
        if not state or not state.get("cursor"):
            messagebox.showinfo("Nothing to resume",
                                "No saved resume state for this app.")
            return

        # Restore the previously collected reviews and start from
        # the saved cursor.
        self.pw_reviews = list(state.get("reviews", []) or [])
        self._pw_log(
            f"Resuming scrape from {len(self.pw_reviews)} saved reviews, "
            f"cursor='{state.get('cursor','')[:30]}…'"
        )
        self.pw_progress.configure(mode="indeterminate")
        self.pw_progress.start()
        self.pw_export_btn.configure(state="normal")  # already have reviews
        self.pw_status_label.configure(text="Resuming…")
        self.pw_scrape_btn.configure(state="disabled", text="Scraping…")
        # Cross-tab: disable the Steam API tab's buttons too.
        self._set_busy(True)
        self._pw_stop_event.clear()
        self._pw_thread = threading.Thread(
            target=self._pw_scrape_worker,
            args=(state.get("cursor", "*"), len(self.pw_reviews)),
            daemon=True,
        )
        self._pw_thread.start()

    def _pw_scrape_worker(
        self,
        start_cursor: str = "*",
        start_fetched: int = 0,
        dedup_against_seen: bool = False,
    ) -> None:
        assert self.app_id is not None
        try:
            # The helper sends lines like:
            #   "API page 1: +30 (kept: 30, server total: 4029)"
            # We surface the latest "kept / total" in the status label
            # so the user sees live progress instead of a static
            # "Scraping…" message.
            import re as _re
            _page_re = _re.compile(
                r"API page\s+(\d+):\s*\+\d+\s*\(kept:\s*(\d+),\s*server total:\s*(\d+)"
            )

            def progress(msg: str) -> None:
                m = _page_re.search(msg)
                if m:
                    page, kept, total = m.groups()
                    self.after(0, lambda p=page, k=kept, t=total: self.pw_status_label.configure(
                        text=f"Scraping… page {p} · {k} of {t} reviews"
                    ))
                self.after(0, lambda m=msg: self._pw_log(m))

            # Read the new filters from the GUI widgets.
            try:
                pw_playtime_min_hours = int(
                    (self.pw_playtime_min_entry.get() or "").strip() or 0
                )
                pw_playtime_filter_min = pw_playtime_min_hours * 60
            except ValueError:
                pw_playtime_filter_min = 0
            pw_offtopic = self.pw_offtopic_var.get() == "true"
            pw_purchase = self.pw_purchase_var.get()
            # "When to include" — convert the GUI selection to a UTC
            # timestamp that the helper will use as a client-side
            # min_date_ts lower bound.
            pw_since_ts = self.get_since_timestamp("pw")

            new_reviews = self.api.fetch_via_playwright(
                app_id=self.app_id,
                max_items=int(self.pw_max_var.get()),
                sort=self.pw_sort_var.get(),
                language=self.pw_lang_var.get(),
                progress_cb=progress,
                start_cursor=start_cursor,
                start_fetched=start_fetched,
                purchase_type=pw_purchase,
                playtime_filter_min=pw_playtime_filter_min,
                filter_offtopic_activity=pw_offtopic,
                since_timestamp=pw_since_ts,
            )
            # "Fetch new" dedup: drop reviews we've already exported.
            if dedup_against_seen:
                seen = self._load_seen_ids()
                # Also exclude IDs already in self.pw_reviews (resume case).
                for r in self.pw_reviews:
                    rid = str(r.get("recommendationid") or "")
                    if rid:
                        seen.add(rid)
                if seen:
                    before = len(new_reviews)
                    new_reviews = [
                        r for r in new_reviews
                        if str(r.get("recommendationid") or "") not in seen
                    ]
                    dropped = before - len(new_reviews)
                    self._pw_log(
                        f"Fetch-new dedup: {dropped} already-exported reviews skipped, "
                        f"{len(new_reviews)} new reviews to write."
                    )
                else:
                    self._pw_log(
                        f"Fetch-new dedup: no previously-exported reviews on disk, "
                        f"writing all {len(new_reviews)}."
                    )

            # For a fresh start, self.pw_reviews was reset to []. For a
            # resume, _on_pw_resume already populated it with the saved
            # reviews. Either way we just append the new ones.
            if start_cursor == "*":
                self.pw_reviews = list(new_reviews)
            else:
                self.pw_reviews.extend(new_reviews)
            self.after(
                0,
                lambda: self.pw_status_label.configure(
                    text=f"Done. {len(self.pw_reviews)} reviews captured."
                ),
            )
            if self.pw_reviews:
                self.after(0, lambda: self.pw_export_btn.configure(state="normal"))
                # Diff against existing seen set so we can show "new" count
                new_count = sum(
                    1 for r in new_reviews
                    if r.get("recommendationid")
                    and r.get("recommendationid") not in self.api._seen_review_ids
                )
                self.after(
                    0,
                    lambda c=new_count: self._pw_log(
                        f"Of these, {c} were not seen before by watch mode."
                    ),
                )
                # Mark them as seen
                for r in new_reviews:
                    rid = r.get("recommendationid")
                    if rid:
                        self.api._seen_review_ids.add(rid)
        except Exception as e:
            self.after(0, lambda e=e: self._pw_log(f"ERROR: {e}"))
            self.after(
                0,
                lambda e=e: self.pw_status_label.configure(text=f"Error: {e}"),
            )
        finally:
            self.after(0, lambda: self.pw_progress.stop())
            self.after(0, lambda: self.pw_progress.set(1))
            self.after(0, lambda: self.pw_scrape_btn.configure(
                state="normal", text="▶ Start Browser Scrape"
            ))

            # Save resume state if we were stopped mid-fetch.
            # The helper writes the last cursor to a progress file
            # at ~/.steam_review_tool/_pw_progress_<app_id>.json.
            # We need to read it BEFORE the helper could have cleaned
            # it up. To avoid a race we changed the helper to LEAVE
            # the file in place but mark it as `done: true` on
            # natural completion. So:
            #   - file missing           => subprocess never started
            #   - file present, done=True => finished cleanly
            #   - file present, done=False => interrupted
            if self.app_id is not None:
                progress_path = (
                    Path.home() / ".steam_review_tool"
                    / f"_pw_progress_{self.app_id}.json"
                )
                cursor_to_save = start_cursor
                completed_cleanly = False
                if progress_path.exists():
                    try:
                        with open(progress_path, "r", encoding="utf-8") as f:
                            prog = json.load(f)
                        if prog.get("done"):
                            completed_cleanly = True
                        else:
                            c = prog.get("cursor") or ""
                            if c:
                                cursor_to_save = c
                    except Exception:
                        pass
                # If the helper reported clean completion OR the user
                # didn't actually stop the fetch, clear any saved
                # resume state.
                if completed_cleanly or not self._pw_stop_event.is_set():
                    self._resume_clear("pw", self.app_id)
                # If the user DID stop and the helper was mid-fetch,
                # save the resume state with the latest cursor.
                elif cursor_to_save and cursor_to_save != "*" and self.pw_reviews:
                    self._resume_set(
                        "pw", self.app_id,
                        cursor=cursor_to_save,
                        reviews=list(self.pw_reviews),
                        sort=self.pw_sort_var.get(),
                        language=self.pw_lang_var.get(),
                    )
                    self.after(0, lambda: self._pw_log(
                        f"Saved resume state at {len(self.pw_reviews)} reviews. "
                        f"Click 'Resume' to continue."
                    ))
                else:
                    self._resume_clear("pw", self.app_id)

            # "Fetch new" auto-export: write only the new (un-seen)
            # reviews to a fresh .md under the per-game subfolder.
            if (getattr(self, "_fetch_new_auto_export", False)
                    and self.app_id is not None
                    and self.pw_reviews):
                try:
                    game_name = (
                        (self.app_details or {}).get("name")
                        or f"app_{self.app_id}"
                    )
                    folder = self._get_game_dump_folder()
                    fname = make_export_basename(
                        game_name, f"fetchnew_{short_filter_label('pw', self)}",
                    )
                    out_path = str(folder / fname)
                    self._pw_log(
                        f"Auto-exporting {len(self.pw_reviews)} new reviews to {out_path}"
                    )
                    self._do_pw_export_to_path(
                        out_path, self.pw_reviews, update_seen_ids=True,
                    )
                except Exception as exc:
                    self._pw_log(f"Auto-export after Fetch-new failed: {exc}")
                finally:
                    self._fetch_new_auto_export = False
            self.after(0, self._refresh_resume_buttons)

    def _on_pw_export(self) -> None:
        if not self.pw_reviews or self.app_id is None:
            messagebox.showinfo("Nothing to export", "Run a scrape first.")
            return
        # Build a short suggested filename in the per-game subfolder.
        game_name = (self.app_details or {}).get("name") or f"app_{self.app_id}"
        filter_lbl = short_filter_label("pw", self)
        default_name = make_export_basename(game_name, f"pw_{filter_lbl}")
        try:
            initial_dir = str(self._get_game_dump_folder())
        except Exception:
            initial_dir = str(self._get_dump_root())
        path = filedialog.asksaveasfilename(
            title="Export Playwright scrape to Markdown",
            defaultextension=".md",
            initialdir=initial_dir,
            initialfile=default_name,
            filetypes=[("Markdown", "*.md"), ("All files", "*.*")],
        )
        if not path:
            return

        self._do_pw_export_to_path(path, self.pw_reviews)

    def _do_pw_export_to_path(
        self,
        path: str,
        reviews_to_export: list[dict],
        update_seen_ids: bool = True,
    ) -> None:
        """Write Playwright-tab reviews to `path` and optionally update seen_ids."""
        try:
            split_per = int((self.pw_split_var.get() or "0").strip() or "0")
        except ValueError:
            split_per = 0

        export_ctx = ExportContext(
            app_id=self.app_id,
            app_details=self.app_details,
            reviews=reviews_to_export,
            language_param=self.pw_lang_var.get(),
            review_filter=self.pw_sort_var.get(),
            review_type="all",
            day_range=None,
            min_date_ts=None,
            keyword_list=self._get_keyword_list(),
        )
        note = (
            f"\n## Playwright Browser Scrape\n\n"
            f"- Source: headless Chromium via Playwright\n"
            f"- Reviews: {len(reviews_to_export)}\n"
            f"- Sort: {self.pw_sort_var.get()}\n"
            f"- Language: {self.pw_lang_var.get()}\n\n"
        )
        try:
            n_files = self._export_split_write(
                path, reviews_to_export, export_ctx,
                watch_note=note, split_per=split_per,
            )
        except OSError as e:
            # messagebox must be shown on the main thread; this method
            # can be called from a worker (auto-export after Fetch-new).
            self.after(0, lambda err=e: messagebox.showerror("Save failed", str(err)))
            return

        if n_files == 1:
            self._pw_log(f"Exported {len(reviews_to_export)} reviews to {path}")
            self.after(
                0,
                lambda: messagebox.showinfo(
                    "Export complete",
                    f"Wrote {len(reviews_to_export)} Playwright-scraped reviews to:\n{path}",
                ),
            )
        else:
            base = Path(path).with_suffix("")
            ext = Path(path).suffix or ".md"
            self._pw_log(
                f"Exported {len(reviews_to_export)} reviews into {n_files} "
                f"files (split per {split_per})."
            )
            self.after(
                0,
                lambda: messagebox.showinfo(
                    "Export complete",
                    f"Wrote {len(reviews_to_export)} reviews to {n_files} files:\n"
                    f"  {base}_part1{ext}\n  ...\n  {base}_part{n_files}{ext}",
                ),
            )

        # Record the dumped review IDs in seen_ids.json so a future
        # "Fetch new" run can skip them.
        if update_seen_ids:
            ids = [
                str(r.get("recommendationid") or "")
                for r in reviews_to_export
                if r.get("recommendationid")
            ]
            if ids:
                self._save_seen_ids(ids)
                self._refresh_dump_label()

        # Optional: also write CSV and/or JSON (only for single-file exports).
        try:
            if n_files == 1 and Path(path).suffix.lower() == ".md":
                base = str(Path(path).with_suffix(""))
                if self._also_csv():
                    try:
                        MarkdownExporter.reviews_to_csv(
                            reviews_to_export, base + ".csv"
                        )
                        self._pw_log(f"  + CSV: {base}.csv")
                    except Exception as exc:
                        self._pw_log(f"  CSV write failed: {exc}")
                if self._also_json():
                    try:
                        MarkdownExporter.reviews_to_json(
                            reviews_to_export, base + ".json"
                        )
                        self._pw_log(f"  + JSON: {base}.json")
                    except Exception as exc:
                        self._pw_log(f"  JSON write failed: {exc}")
                # Per-language sub-exports
                if self._per_language():
                    try:
                        n_lang = MarkdownExporter.write_per_language(
                            reviews_to_export, base, export_ctx,
                        )
                        if n_lang:
                            self._pw_log(
                                f"  + {n_lang} per-language .md files"
                            )
                    except Exception as exc:
                        self._pw_log(f"  Per-language export failed: {exc}")
                # Obsidian-vault secondary copy
                self._copy_to_obsidian_vault(path)
        except Exception as exc:
            self._pw_log(f"Optional export failed: {exc}")

    # ------------------------------------------------------------------ dump folder + dedup

    DEFAULT_DUMP_ROOT_LOCAL = DEFAULT_DUMP_ROOT  # alias for instance access

    def _get_dump_root(self) -> Path:
        """Return the configured dump root folder (creating it if missing)."""
        raw = ""
        try:
            raw = self.dump_root_var.get()  # set by settings apply
        except Exception:
            raw = ""
        if raw and raw.strip():
            root = Path(raw).expanduser()
        else:
            root = DEFAULT_DUMP_ROOT
        try:
            root.mkdir(parents=True, exist_ok=True)
        except OSError:
            # Fallback to a temp dir if the user-set path is invalid.
            root = DEFAULT_DUMP_ROOT
            root.mkdir(parents=True, exist_ok=True)
        return root

    def _get_game_dump_folder(self, app_id: Optional[int] = None,
                              app_name: Optional[str] = None) -> Path:
        """Return the per-game subfolder under the dump root.

        Folder name format: '<app_id>_<safe_name>'. We always include
        the app_id so a Steam rename doesn't break the link.
        """
        if app_id is None:
            app_id = self.app_id
        if app_id is None:
            raise ValueError("No app_id loaded; cannot resolve dump folder.")
        if app_name is None:
            app_name = (self.app_details or {}).get("name") or f"app_{app_id}"
        safe = sanitize_for_filename(app_name, max_len=40)
        folder = self._get_dump_root() / f"{app_id}_{safe}"
        folder.mkdir(parents=True, exist_ok=True)
        return folder

    def _seen_ids_path(self, app_id: Optional[int] = None,
                       app_name: Optional[str] = None) -> Path:
        """Return the path to the per-game seen_ids.json file."""
        return self._get_game_dump_folder(app_id, app_name) / "seen_ids.json"

    def _load_seen_ids(self, app_id: Optional[int] = None,
                       app_name: Optional[str] = None) -> set:
        """Read the seen-IDs file for the current (or given) game.

        Returns an empty set if the file doesn't exist or is corrupt.
        """
        path = self._seen_ids_path(app_id, app_name)
        if not path.exists():
            return set()
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            return set(data.get("seen_ids", []) or [])
        except Exception:
            return set()

    def _save_seen_ids(self, ids, app_id: Optional[int] = None,
                       app_name: Optional[str] = None,
                       total_exported: Optional[int] = None) -> None:
        """Write the seen-IDs file for the current (or given) game.

        `ids` may be any iterable of strings; de-duplicated before
        writing. `total_exported` updates the running counter.
        """
        if app_id is None:
            app_id = self.app_id
        if app_id is None:
            return
        if app_name is None:
            app_name = (self.app_details or {}).get("name") or f"app_{app_id}"
        path = self._seen_ids_path(app_id, app_name)
        # Merge with existing so we never lose IDs we already saved.
        existing = self._load_seen_ids(app_id, app_name)
        existing.update(ids or [])
        data = {
            "app_id": app_id,
            "name": app_name,
            "seen_ids": sorted(existing),
            "last_export_at": datetime.now().isoformat(timespec="seconds"),
            "total_exported": total_exported if total_exported is not None else len(existing),
        }
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(
                json.dumps(data, indent=2, ensure_ascii=False),
                encoding="utf-8",
            )
        except OSError as exc:
            self._log(f"Failed to write seen-IDs file: {exc}")

    def _on_pick_obsidian_vault(self) -> None:
        """Pick a secondary folder (e.g. an Obsidian vault) to also copy exports to."""
        from tkinter import filedialog as _fd
        initial = self.obsidian_vault_var.get() or self._get_dump_root()
        new_dir = _fd.askdirectory(
            title="Select Obsidian vault folder",
            initialdir=initial,
            mustexist=False,
        )
        if not new_dir:
            return
        self.obsidian_vault_var.set(new_dir)
        self._refresh_obsidian_label()
        self._log(f"Obsidian vault set to: {new_dir}")

    def _on_clear_obsidian_vault(self) -> None:
        self.obsidian_vault_var.set("")
        self._refresh_obsidian_label()
        self._log("Obsidian vault cleared.")

    def _refresh_obsidian_label(self) -> None:
        path = self.obsidian_vault_var.get() if hasattr(self, "obsidian_vault_var") else ""
        if path:
            self.obsidian_label.configure(text=path, text_color=("#1f6aa5", "#5da9d6"))
        else:
            self.obsidian_label.configure(text="(not set)", text_color="gray")

    def _copy_to_obsidian_vault(self, src_path: str) -> None:
        """If a vault path is configured, copy the just-written .md
        (and any sidecar .csv / .json) there too.
        """
        vault = (self.obsidian_vault_var.get() or "").strip() if hasattr(self, "obsidian_vault_var") else ""
        if not vault:
            return
        try:
            vault_root = Path(vault)
            vault_root.mkdir(parents=True, exist_ok=True)
            src = Path(src_path)
            for ext in (".md", ".csv", ".json"):
                candidate = src.with_suffix(ext)
                if not candidate.exists():
                    continue
                dest = vault_root / candidate.name
                # Avoid re-copying identical files. We compute a real
                # content hash (not just file size — two different
                # exports can easily be the same size).
                if dest.exists() and _file_content_hash(candidate) == _file_content_hash(dest):
                    continue
                dest.write_bytes(candidate.read_bytes())
                self._log(f"  + Vault copy: {dest}")
        except Exception as exc:
            self._log(f"Vault copy failed: {exc}")

    def _on_pick_dump_root(self) -> None:
        """Open a directory chooser to change the main dump folder."""
        from tkinter import filedialog as _fd
        initial = self._get_dump_root()
        new_dir = _fd.askdirectory(
            title="Select main dump folder",
            initialdir=str(initial),
            mustexist=False,
        )
        if not new_dir:
            return
        self.dump_root_var.set(new_dir)
        self._refresh_dump_label()
        self._log(f"Dump folder set to: {new_dir}")

    def _on_open_dump_folder(self) -> None:
        """Open the main dump folder in the OS file manager."""
        try:
            folder = self._get_dump_root()
        except Exception as exc:
            self._log(f"Could not resolve dump folder: {exc}")
            return
        try:
            if sys.platform == "win32":
                os.startfile(str(folder))  # noqa: S606
            elif sys.platform == "darwin":
                import subprocess
                subprocess.Popen(["open", str(folder)])
            else:
                import subprocess
                subprocess.Popen(["xdg-open", str(folder)])
            self._log(f"Opened dump folder: {folder}")
        except Exception as exc:
            self._log(f"Failed to open dump folder: {exc}")
            messagebox.showerror("Open folder failed", str(exc))

    def _on_open_game_folder(self) -> None:
        """Open the per-game dump subfolder for the currently loaded app."""
        if self.app_id is None:
            messagebox.showinfo("No game", "Load a game first.")
            return
        try:
            folder = self._get_game_dump_folder()
        except Exception as exc:
            self._log(f"Could not resolve game folder: {exc}")
            return
        try:
            if sys.platform == "win32":
                os.startfile(str(folder))  # noqa: S606
            elif sys.platform == "darwin":
                import subprocess
                subprocess.Popen(["open", str(folder)])
            else:
                import subprocess
                subprocess.Popen(["xdg-open", str(folder)])
            self._log(f"Opened game folder: {folder}")
        except Exception as exc:
            self._log(f"Failed to open game folder: {exc}")
            messagebox.showerror("Open folder failed", str(exc))

    def _refresh_dump_label(self) -> None:
        """Update the 'Dump folder:' / 'Already exported:' labels in both tabs."""
        try:
            root = self._get_dump_root()
        except Exception:
            root = DEFAULT_DUMP_ROOT
        for attr in ("dump_folder_label", "pw_dump_folder_label"):
            lbl = getattr(self, attr, None)
            if lbl is not None:
                lbl.configure(text=f"📂 Dump folder: {root}")
        # Update per-game count label (only if a game is loaded).
        if self.app_id is not None:
            try:
                seen = self._load_seen_ids()
                n = len(seen)
                for attr in ("seen_count_label", "pw_seen_count_label"):
                    lbl = getattr(self, attr, None)
                    if lbl is not None:
                        lbl.configure(text=f"Already exported: {n} reviews")
            except Exception:
                pass

    def _on_fetch_new(self, tab: str) -> None:
        """Fetch reviews, skip already-exported ones, and export only the new.

        This is the "incremental dump" button. It:
          1. Runs the same fetch as the normal Fetch button
          2. Drops any review whose recommendationid is already in
             the per-game seen_ids.json
          3. Exports the rest to a fresh .md under the per-game
             subfolder
          4. Updates seen_ids.json with the newly exported ids
        """
        if self.app_id is None:
            messagebox.showinfo("No game", "Please load a game first.")
            return
        if tab == "api" and self._worker and self._worker.is_alive():
            return
        if tab == "pw" and self._pw_thread and self._pw_thread.is_alive():
            return

        # Reuse the existing worker thread but inject a dedup step
        # via a flag the worker will read.
        self._fetch_new_tab = tab  # consumed by the workers below
        self._fetch_new_auto_export = True  # auto-export + save seen_ids
        self._stop_event.clear()
        self._pw_stop_event.clear()
        self._set_busy(True)
        self._refresh_dump_label()
        if tab == "api":
            self.reviews = []
            self.progress.set(0)
            self.stats_label.configure(text="Fetching new (dedup)…")
            self._worker = threading.Thread(
                target=self._fetch_worker,
                args=("*",),
                kwargs={"dedup_against_seen": True},
                daemon=True,
            )
            self._worker.start()
        else:
            self.pw_reviews = []
            self.pw_progress.configure(mode="indeterminate")
            self.pw_progress.start()
            self.pw_status_label.configure(text="Fetching new (dedup)…")
            self.pw_export_btn.configure(state="normal")
            self._pw_thread = threading.Thread(
                target=self._pw_scrape_worker,
                args=("*", 0),
                kwargs={"dedup_against_seen": True},
                daemon=True,
            )
            self._pw_thread.start()

    # ------------------------------------------------------------------ settings

    SETTINGS_PATH = Path.home() / ".steam_review_tool" / "settings.json"

    def _settings_load(self) -> dict:
        try:
            if self.SETTINGS_PATH.exists():
                return json.loads(
                    self.SETTINGS_PATH.read_text(encoding="utf-8")
                )
        except Exception as e:
            print(f"[Settings] load failed: {e}")
        return {}

    def _settings_save(self) -> None:
        """Collect current UI state and write to settings.json."""
        data: dict = {}
        try:
            if hasattr(self, "input_entry"):
                data["last_app_input"] = self.input_entry.get()
            if hasattr(self, "pw_input_entry"):
                data["last_pw_input"] = self.pw_input_entry.get()
            if self.app_id is not None:
                data["last_app_id"] = self.app_id
                data["last_app_name"] = (self.app_details or {}).get("name", "")
            if hasattr(self, "lang_var"):
                data["language"] = self.lang_var.get()
            if hasattr(self, "filter_var"):
                data["filter"] = self.filter_var.get()
            if hasattr(self, "type_var"):
                data["review_type"] = self.type_var.get()
            if hasattr(self, "day_entry"):
                data["day_range"] = self.day_entry.get()
            if hasattr(self, "date_entry"):
                data["min_date"] = self.date_entry.get()
            if hasattr(self, "helpful_entry"):
                data["min_helpful"] = self.helpful_entry.get()
            if hasattr(self, "perpage_var"):
                data["per_page"] = self.perpage_var.get()
            if hasattr(self, "backend_var"):
                data["backend"] = self.backend_var.get()
            if hasattr(self, "interval_var"):
                data["watch_interval"] = self.interval_var.get()
            if hasattr(self, "pw_sort_var"):
                data["pw_sort"] = self.pw_sort_var.get()
            if hasattr(self, "pw_max_var"):
                data["pw_max"] = self.pw_max_var.get()
            if hasattr(self, "pw_lang_var"):
                data["pw_lang"] = self.pw_lang_var.get()
            if hasattr(self, "api_split_var"):
                data["api_split"] = self.api_split_var.get()
            if hasattr(self, "pw_split_var"):
                data["pw_split"] = self.pw_split_var.get()
            if hasattr(self, "purchase_var"):
                data["purchase_type"] = self.purchase_var.get()
            if hasattr(self, "playtime_min_entry"):
                data["playtime_min"] = self.playtime_min_entry.get()
            if hasattr(self, "offtopic_var"):
                data["offtopic"] = self.offtopic_var.get()
            if hasattr(self, "pw_purchase_var"):
                data["pw_purchase_type"] = self.pw_purchase_var.get()
            if hasattr(self, "pw_playtime_min_entry"):
                data["pw_playtime_min"] = self.pw_playtime_min_entry.get()
            if hasattr(self, "pw_offtopic_var"):
                data["pw_offtopic"] = self.pw_offtopic_var.get()
            # "When to include" filter — persist preset + custom date+time.
            if hasattr(self, "since_preset_var"):
                data["since_preset"] = self.since_preset_var.get()
            if hasattr(self, "since_date_entry"):
                data["since_date"] = self.since_date_entry.get()
            if hasattr(self, "since_time_entry"):
                data["since_time"] = self.since_time_entry.get()
            if hasattr(self, "pw_since_preset_var"):
                data["pw_since_preset"] = self.pw_since_preset_var.get()
            if hasattr(self, "pw_since_date_entry"):
                data["pw_since_date"] = self.pw_since_date_entry.get()
            if hasattr(self, "pw_since_time_entry"):
                data["pw_since_time"] = self.pw_since_time_entry.get()
            # Dump folder (configurable export destination).
            if hasattr(self, "dump_root_var") and self.dump_root_var is not None:
                data["dump_root"] = self.dump_root_var.get()
            # Also-export flags.
            if hasattr(self, "also_export_csv_var") and self.also_export_csv_var is not None:
                data["also_csv"] = self.also_export_csv_var.get()
            if hasattr(self, "also_export_json_var") and self.also_export_json_var is not None:
                data["also_json"] = self.also_export_json_var.get()
            # Auto-incremental watch flag.
            if hasattr(self, "auto_incremental_watch_var") and self.auto_incremental_watch_var is not None:
                data["auto_incr_watch"] = self.auto_incremental_watch_var.get()
            # Per-language exports.
            if hasattr(self, "per_language_var") and self.per_language_var is not None:
                data["per_language"] = self.per_language_var.get()
            # Obsidian-vault secondary copy.
            if hasattr(self, "obsidian_vault_var") and self.obsidian_vault_var is not None:
                data["obsidian_vault"] = self.obsidian_vault_var.get()
            # Keyword list (textarea)
            if hasattr(self, "keywords_text") and self.keywords_text is not None:
                try:
                    data["keywords_text"] = self.keywords_text.get("1.0", "end").strip()
                except Exception:
                    pass
            # AI prompt template (textarea)
            if hasattr(self, "ai_prompt_text") and self.ai_prompt_text is not None:
                try:
                    data["ai_prompt_text"] = self.ai_prompt_text.get("1.0", "end").strip()
                except Exception:
                    pass
        except Exception as e:
            print(f"[Settings] collect failed: {e}")
        try:
            self.SETTINGS_PATH.parent.mkdir(parents=True, exist_ok=True)
            self.SETTINGS_PATH.write_text(
                json.dumps(data, indent=2, ensure_ascii=False),
                encoding="utf-8",
            )
        except OSError as e:
            print(f"[Settings] save failed: {e}")

    def _settings_apply(self, data: dict) -> None:
        """Apply loaded settings to widgets. Must be called AFTER _build_ui."""
        try:
            if "last_app_input" in data and hasattr(self, "input_entry"):
                self.input_entry.insert(0, data["last_app_input"])
            if "last_pw_input" in data and hasattr(self, "pw_input_entry"):
                self.pw_input_entry.insert(0, data["last_pw_input"])
            if "language" in data and hasattr(self, "lang_var"):
                self.lang_var.set(data["language"])
            if "filter" in data and hasattr(self, "filter_var"):
                self.filter_var.set(data["filter"])
            if "review_type" in data and hasattr(self, "type_var"):
                self.type_var.set(data["review_type"])
            if "day_range" in data and hasattr(self, "day_entry"):
                self.day_entry.insert(0, str(data["day_range"]))
            if "min_date" in data and hasattr(self, "date_entry"):
                self.date_entry.insert(0, str(data["min_date"]))
            if "min_helpful" in data and hasattr(self, "helpful_entry"):
                self.helpful_entry.insert(0, str(data["min_helpful"]))
            if "per_page" in data and hasattr(self, "perpage_var"):
                self.perpage_var.set(str(data["per_page"]))
            if "backend" in data and hasattr(self, "backend_var"):
                self.backend_var.set(data["backend"])
            if "watch_interval" in data and hasattr(self, "interval_var"):
                self.interval_var.set(str(data["watch_interval"]))
            if "pw_sort" in data and hasattr(self, "pw_sort_var"):
                self.pw_sort_var.set(data["pw_sort"])
            if "pw_max" in data and hasattr(self, "pw_max_var"):
                self.pw_max_var.set(str(data["pw_max"]))
            if "pw_lang" in data and hasattr(self, "pw_lang_var"):
                self.pw_lang_var.set(data["pw_lang"])
            if "api_split" in data and hasattr(self, "api_split_var"):
                self.api_split_var.set(data["api_split"])
            if "pw_split" in data and hasattr(self, "pw_split_var"):
                self.pw_split_var.set(data["pw_split"])
            if "purchase_type" in data and hasattr(self, "purchase_var"):
                self.purchase_var.set(data["purchase_type"])
            if "playtime_min" in data and hasattr(self, "playtime_min_entry"):
                self.playtime_min_entry.insert(0, str(data["playtime_min"]))
            if "offtopic" in data and hasattr(self, "offtopic_var"):
                self.offtopic_var.set(data["offtopic"])
            if "pw_purchase_type" in data and hasattr(self, "pw_purchase_var"):
                self.pw_purchase_var.set(data["pw_purchase_type"])
            if "pw_playtime_min" in data and hasattr(self, "pw_playtime_min_entry"):
                self.pw_playtime_min_entry.insert(0, str(data["pw_playtime_min"]))
            if "pw_offtopic" in data and hasattr(self, "pw_offtopic_var"):
                self.pw_offtopic_var.set(data["pw_offtopic"])
            # Restore the "When to include" filter. We set the values
            # BEFORE calling the preset-change handler so the custom
            # date+time row is visible if the saved preset is "custom".
            if "since_preset" in data and hasattr(self, "since_preset_var"):
                self.since_preset_var.set(data["since_preset"])
                self._on_since_preset_change()
            if "since_date" in data and hasattr(self, "since_date_entry"):
                self.since_date_entry.delete(0, "end")
                self.since_date_entry.insert(0, str(data["since_date"]))
            if "since_time" in data and hasattr(self, "since_time_entry"):
                self.since_time_entry.delete(0, "end")
                self.since_time_entry.insert(0, str(data["since_time"]))
            # Refresh the "Will include reviews from:" label now that
            # all three inputs (preset, date, time) have been restored.
            if hasattr(self, "_refresh_since_label"):
                self._refresh_since_label()
            if "pw_since_preset" in data and hasattr(self, "pw_since_preset_var"):
                self.pw_since_preset_var.set(data["pw_since_preset"])
                self._on_pw_since_preset_change()
            if "pw_since_date" in data and hasattr(self, "pw_since_date_entry"):
                self.pw_since_date_entry.delete(0, "end")
                self.pw_since_date_entry.insert(0, str(data["pw_since_date"]))
            if "pw_since_time" in data and hasattr(self, "pw_since_time_entry"):
                self.pw_since_time_entry.delete(0, "end")
                self.pw_since_time_entry.insert(0, str(data["pw_since_time"]))
            if hasattr(self, "_refresh_pw_since_label"):
                self._refresh_pw_since_label()
            # Dump folder (only set after the StringVar is created in
            # _build_tab_api).
            if "dump_root" in data and hasattr(self, "dump_root_var") \
                    and self.dump_root_var is not None:
                self.dump_root_var.set(data["dump_root"] or "")
                self._refresh_dump_label()
            # Also-export flags (checkboxes).
            if "also_csv" in data and hasattr(self, "also_export_csv_var") \
                    and self.also_export_csv_var is not None:
                self.also_export_csv_var.set(data["also_csv"] == "1" or data["also_csv"] is True)
            if "also_json" in data and hasattr(self, "also_export_json_var") \
                    and self.also_export_json_var is not None:
                self.also_export_json_var.set(data["also_json"] == "1" or data["also_json"] is True)
            if "auto_incr_watch" in data and hasattr(self, "auto_incremental_watch_var") \
                    and self.auto_incremental_watch_var is not None:
                self.auto_incremental_watch_var.set(
                    data["auto_incr_watch"] == "1" or data["auto_incr_watch"] is True
                )
            if "per_language" in data and hasattr(self, "per_language_var") \
                    and self.per_language_var is not None:
                self.per_language_var.set(
                    data["per_language"] == "1" or data["per_language"] is True
                )
            if "obsidian_vault" in data and hasattr(self, "obsidian_vault_var") \
                    and self.obsidian_vault_var is not None:
                self.obsidian_vault_var.set(data["obsidian_vault"] or "")
            if "keywords_text" in data and hasattr(self, "keywords_text") \
                    and self.keywords_text is not None:
                try:
                    self.keywords_text.delete("1.0", "end")
                    self.keywords_text.insert(
                        "1.0", data["keywords_text"] or
                        ", ".join(DEFAULT_KEYWORD_TAGS),
                    )
                except Exception:
                    pass
            if "ai_prompt_text" in data and hasattr(self, "ai_prompt_text") \
                    and self.ai_prompt_text is not None:
                try:
                    self.ai_prompt_text.delete("1.0", "end")
                    self.ai_prompt_text.insert("1.0", data["ai_prompt_text"] or "")
                except Exception:
                    pass
        except Exception as e:
            print(f"[Settings] apply failed: {e}")

    def _on_close(self) -> None:
        """Save settings then close the window."""
        try:
            self._settings_save()
        except Exception:
            pass
        # If watching, stop the watch thread cleanly
        if self.watching:
            self._watch_stop_event.set()
        self.destroy()

    # ------------------------------------------------------------------ resume

    # Where we persist the "this fetch was stopped, can be resumed"
    # state. Keyed by "<source>_<app_id>" so the Steam API tab and
    # the Playwright tab don't collide, and so a different app never
    # picks up the wrong saved cursor.
    RESUME_PATH = Path.home() / ".steam_review_tool" / "resume_state.json"

    def _resume_load_all(self) -> dict:
        try:
            if not self.RESUME_PATH.exists():
                return {}
            return json.loads(self.RESUME_PATH.read_text(encoding="utf-8"))
        except Exception as e:
            print(f"[Resume] load failed: {e}")
            return {}

    def _settings_load_raw(self) -> dict:
        """Read the raw settings.json. Returns {} on any failure."""
        try:
            if self.SETTINGS_PATH.exists():
                return json.loads(
                    self.SETTINGS_PATH.read_text(encoding="utf-8")
                )
        except Exception:
            pass
        return {}

    def _resume_save_all(self, data: dict) -> None:
        try:
            self.RESUME_PATH.parent.mkdir(parents=True, exist_ok=True)
            self.RESUME_PATH.write_text(
                json.dumps(data, indent=2, ensure_ascii=False),
                encoding="utf-8",
            )
        except OSError as e:
            print(f"[Resume] save failed: {e}")

    def _resume_get(self, source: str, app_id: int):
        """Return saved state dict for (source, app_id), or None."""
        if app_id is None:
            return None
        data = self._resume_load_all()
        return data.get(f"{source}_{app_id}")

    def _resume_set(self, source: str, app_id: int, **fields) -> None:
        """Save resume state for (source, app_id)."""
        if app_id is None:
            return
        data = self._resume_load_all()
        key = f"{source}_{app_id}"
        data[key] = {
            "app_id": app_id,
            "saved_at": datetime.now().isoformat(timespec="seconds"),
            **fields,
        }
        self._resume_save_all(data)

    def _resume_clear(self, source: str, app_id: int) -> None:
        if app_id is None:
            return
        data = self._resume_load_all()
        key = f"{source}_{app_id}"
        if key in data:
            del data[key]
            self._resume_save_all(data)

    def _refresh_resume_buttons(self) -> None:
        """Update the Resume button enabled/disabled state for both tabs.

        Called after a game is loaded, after a fetch starts, and after
        a fetch completes or is stopped.
        """
        # Steam API tab
        api_state = self._resume_get("api", self.app_id) if self.app_id else None
        if api_state and api_state.get("cursor"):
            count = len(api_state.get("reviews", []) or [])
            self.api_resume_btn.configure(
                text=f"▶ Resume ({count} reviews)",
                state="normal",
            )
        else:
            self.api_resume_btn.configure(text="▶ Resume", state="disabled")

        # Playwright tab
        pw_state = self._resume_get("pw", self.app_id) if self.app_id else None
        if pw_state and pw_state.get("cursor"):
            count = len(pw_state.get("reviews", []) or [])
            self.pw_resume_btn.configure(
                text=f"▶ Resume ({count} reviews)",
                state="normal",
            )
        else:
            self.pw_resume_btn.configure(text="▶ Resume", state="disabled")


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def main() -> None:
    app = App()
    app.mainloop()


if __name__ == "__main__":
    main()
